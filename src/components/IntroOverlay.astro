---
// Intro cinemática (preloader una sola vez por sesión, estilo McCann).
// Markup estático: estado inicial = "BrandUp" gigante en negro sobre claro.
// La coreografía (zoom-out → inversión → UI → salida) la maneja initIntro() en motion.ts.
import type { Locale } from '../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;

const subtitle = locale === 'es'
  ? 'Agencia creativa digital — Santiago de Chile'
  : 'Digital creative agency — Santiago, Chile';
---

<div class="intro" id="intro" aria-hidden="true">
  <div class="intro__ui" aria-hidden="true">
    <span class="intro__burger"><span></span><span></span><span></span></span>
    <span class="intro__socials"><span>IG</span><span>TT</span></span>
  </div>
  <div class="intro__stage">
    <h1 class="intro__title">Brand<span class="intro__up">Up</span></h1>
    <p class="intro__subtitle">{subtitle}</p>
  </div>
</div>
