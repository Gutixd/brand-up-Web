---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';
import { INDUSTRIES } from '../../data/industries';
import { PROJECTS } from '../../data/projects';
import { useT, pick, localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const lp = (p: string) => localePath(locale, p);
---

<Base locale={locale} title={t.meta.industries.title} description={t.meta.industries.desc}>

  <PageHero kicker={t.industries.kicker} title={t.industries.title} intro={t.industries.intro} />

  <section class="page-section">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {INDUSTRIES.map((ind, i) => {
        const projects = PROJECTS.filter((p) => p.industry === ind.key);
        return (
          <div class="ed-card" data-reveal data-delay={`${(i % 3) * 0.08}`}>
            <span class="ed-card__num">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="ed-card__title">{pick(ind.name, locale)}</h2>
            <p class="ed-card__desc">{pick(ind.desc, locale)}</p>
            <div class="ind-card__foot">
              {projects.length > 0 ? (
                <>
                  <p class="ind-card__label">{t.industries.projectsIn}</p>
                  <ul class="ind-card__projects">
                    {projects.map((p) => (
                      <li>
                        <a href={lp(`/trabajos/${p.slug}`)} class="ind-card__project">{p.client} →</a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <p class="ind-card__empty">{t.industries.empty}</p>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-16 flex justify-center" data-reveal>
      <a href={lp('/cotizar')} class="btn-primary">{t.industries.cta}</a>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
.ind-card__foot {
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid var(--color-line);
}
.ind-card__label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 12px;
}
.ind-card__projects {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ind-card__project {
  font-size: 0.92rem;
  color: var(--color-paper);
  transition: color 0.2s;
}
.ind-card__project:hover { color: var(--color-accent); }
.ind-card__empty {
  font-size: 0.9rem;
  font-style: italic;
  color: var(--color-gray);
}
</style>
