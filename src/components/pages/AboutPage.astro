---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SectionHead from '../SectionHead.astro';
import CtaBand from '../CtaBand.astro';
import { useT, type Locale } from '../../i18n';

import fotoDiego from '../../assets/team/diego.webp';
import fotoValentina from '../../assets/team/valentina.webp';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

const team = [
  { photo: fotoDiego, ...t.about.diego },
  { photo: fotoValentina, ...t.about.valentina },
];
---

<Base locale={locale} title={t.meta.about.title} description={t.meta.about.desc}>
  <!-- Manifesto -->
  <section class="relative overflow-hidden">
    <div class="hero-glow right-[-10%] top-0 h-[420px] w-[420px] bg-accent/15"></div>
    <div class="relative mx-auto max-w-5xl px-5 pt-40 pb-24 md:px-8">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent" data-reveal>{t.about.kicker}</p>
      <h1 class="font-display text-4xl font-extrabold leading-tight tracking-tight md:text-6xl" data-reveal-word>{t.about.title}</h1>
      <p class="mt-8 max-w-3xl text-lg leading-relaxed text-paper/85 md:text-xl" data-reveal data-delay="0.2">{t.about.manifesto}</p>
    </div>
  </section>

  <!-- Team -->
  <section class="border-y border-line bg-ink-2/50">
    <div class="mx-auto max-w-7xl px-5 py-24 md:px-8">
      <SectionHead kicker={t.about.teamKicker} title={t.about.teamTitle} />
      <div class="grid gap-10 md:grid-cols-2">
        {team.map((m, i) => (
          <div class="group" data-reveal data-delay={`${i * 0.1}`}>
            <div class="overflow-hidden rounded-2xl border border-line">
              <Image
                src={m.photo}
                alt={m.name}
                class="aspect-[4/5] w-full object-cover transition-transform duration-700 group-hover:scale-105"
                widths={[480, 720, 900]}
                sizes="(min-width: 768px) 45vw, 90vw"
              />
            </div>
            <h3 class="mt-6 font-display text-2xl font-bold">{m.name}</h3>
            <p class="mt-1 text-sm font-semibold text-accent">{m.role}</p>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-gray">{m.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="mx-auto max-w-7xl px-5 py-24 md:px-8">
    <SectionHead kicker={t.about.valuesKicker} title={t.about.valuesKicker === 'Cómo trabajamos' ? 'Principios que no negociamos' : 'Principles we don’t negotiate'} />
    <div class="grid gap-6 md:grid-cols-3">
      {t.about.values.map((v, i) => (
        <div class="rounded-2xl border border-line p-7 transition-colors hover:border-accent/50" data-reveal data-delay={`${i * 0.08}`}>
          <span class="font-display text-sm font-bold text-accent">0{i + 1}</span>
          <h3 class="mt-3 font-display text-xl font-bold">{v.t}</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray">{v.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Process -->
  <section class="border-t border-line bg-ink-2/50">
    <div class="mx-auto max-w-5xl px-5 py-24 md:px-8">
      <SectionHead kicker={t.about.processKicker} title={t.about.processTitle} />
      <ol class="relative space-y-10 border-l border-line pl-8 md:pl-12">
        {t.about.process.map((step) => (
          <li class="relative" data-reveal>
            <span class="absolute -left-[41px] flex h-6 w-6 items-center justify-center rounded-full border border-accent bg-ink text-[10px] font-bold text-accent md:-left-[57px]">{step.n}</span>
            <h3 class="font-display text-2xl font-bold">{step.t}</h3>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray">{step.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>
