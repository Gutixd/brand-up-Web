---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';
import { useT, type Locale } from '../../i18n';

import fotoDiego from '../../assets/team/diego.webp';
import fotoValentina from '../../assets/team/valentina.webp';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

const team = [
  { photo: fotoDiego, ...t.about.diego },
  { photo: fotoValentina, ...t.about.valentina },
];
const valuesTitle = locale === 'es' ? 'Principios que no negociamos' : 'Principles we don’t negotiate';
---

<Base locale={locale} title={t.meta.about.title} description={t.meta.about.desc}>

  <PageHero kicker={t.about.kicker} title={t.about.title} intro={t.about.manifesto} />

  <!-- Equipo -->
  <section class="page-section--cream">
    <div class="page-section__inner" style="padding-block: 96px;">
      <div class="sec-head">
        <p class="sec-head__kicker">{t.about.teamKicker}</p>
        <h2 class="sec-head__title">{t.about.teamTitle}</h2>
      </div>
      <div class="grid gap-10 md:grid-cols-2">
        {team.map((m, i) => (
          <div class="about-member group" data-reveal data-delay={`${i * 0.1}`}>
            <div class="about-member__photo">
              <Image
                src={m.photo}
                alt={m.name}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                widths={[480, 720, 900]}
                sizes="(min-width: 768px) 45vw, 90vw"
              />
            </div>
            <h3 class="about-member__name">{m.name}</h3>
            <p class="about-member__role">{m.role}</p>
            <p class="about-member__bio">{m.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="page-section">
    <div class="sec-head">
      <p class="sec-head__kicker">{t.about.valuesKicker}</p>
      <h2 class="sec-head__title">{valuesTitle}</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {t.about.values.map((v, i) => (
        <div class="ed-card" data-reveal data-delay={`${i * 0.08}`}>
          <span class="ed-card__num">0{i + 1}</span>
          <h3 class="ed-card__title">{v.t}</h3>
          <p class="ed-card__desc">{v.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Proceso -->
  <section class="page-section--dark">
    <div class="page-section__inner" style="padding-block: 96px;">
      <div class="sec-head">
        <p class="sec-head__kicker">{t.about.processKicker}</p>
        <h2 class="sec-head__title">{t.about.processTitle}</h2>
      </div>
      <ol class="about-process">
        {t.about.process.map((step) => (
          <li class="about-process__step" data-reveal>
            <span class="about-process__num">{step.n}</span>
            <div>
              <h3 class="about-process__title">{step.t}</h3>
              <p class="about-process__desc">{step.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
.about-member__photo {
  overflow: hidden;
  border-radius: 18px;
  aspect-ratio: 4 / 5;
  border: 1px solid var(--color-line);
}
.about-member__name {
  margin-top: 24px;
  font-family: var(--font-display);
  font-size: 1.7rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--color-paper);
}
.about-member__role {
  margin-top: 4px;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--color-accent);
}
.about-member__bio {
  margin-top: 14px;
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--color-gray);
  max-width: 42ch;
}

.about-process {
  list-style: none;
  border-top: 1px solid rgba(248,248,248,0.12);
}
.about-process__step {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 24px;
  padding: 32px 0;
  border-bottom: 1px solid rgba(248,248,248,0.12);
}
@media (min-width: 768px) { .about-process__step { gap: 48px; } }
.about-process__num {
  font-family: var(--font-display);
  font-size: clamp(1.4rem, 3vw, 2.2rem);
  font-weight: 600;
  color: var(--color-accent);
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.about-process__title {
  font-family: var(--font-display);
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  color: #f8f8f8;
}
.about-process__desc {
  margin-top: 10px;
  font-size: 1rem;
  line-height: 1.6;
  color: rgba(248,248,248,0.55);
  max-width: 60ch;
}
</style>
