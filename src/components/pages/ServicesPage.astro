---
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import { SERVICES } from '../../data/services';
import { PROJECTS } from '../../data/projects';
import { SITE } from '../../data/site';
import {
  HERO, FRICTION, SERVICE_BLOCKS, DISCOVERABILITY, CONNECTION,
  PROCESS, INVESTMENT, CASES, FAQ, LABELS,
} from '../../data/servicesPage';
import { useT, pick, localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const lp = (p: string) => localePath(locale, p);
const es = locale === 'es';
const P = <T extends { es: string; en: string }>(v: T) => pick(v, locale);

// Une el bloque editorial con el servicio real de services.ts: el copy
// premium vive en servicesPage.ts, pero el título, la etiqueta y el slug
// siguen viniendo de la única fuente de verdad de servicios.
const blocks = SERVICE_BLOCKS.map((b) => {
  const svc = SERVICES.find((s) => s.slug === b.slug)!;
  return { ...b, num: svc.num, title: svc.title, tag: svc.tag };
});

// Casos: solo proyectos destacados reales, y solo se muestran las métricas
// que existen en los datos. Nunca se inventa un número.
const cases = PROJECTS.filter((p) => p.featured).slice(0, 3);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.items.map((f) => ({
    '@type': 'Question',
    name: P(f.q),
    acceptedAnswer: { '@type': 'Answer', text: P(f.a) },
  })),
};

const servicesLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: es ? 'Capacidades de BrandUp' : 'BrandUp capabilities',
  itemListElement: SERVICES.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: pick(s.title, locale),
      description: pick(s.short, locale),
      url: `${SITE.domain}${lp(`/servicios/${s.slug}`)}`,
      serviceType: pick(s.tag, locale),
      areaServed: ['Santiago de Chile', 'Región Metropolitana', 'Chile'],
      provider: { '@type': 'Organization', name: SITE.legalName, url: SITE.domain },
    },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: es ? 'Inicio' : 'Home', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: es ? 'Servicios' : 'Services', item: `${SITE.domain}${lp('/servicios')}` },
  ],
};

// Interlinking al blog — guías reales publicadas (solo ES: el blog es en español)
const seoLinks = [
  { href: '/blog/cuanto-cuesta-una-pagina-web-en-chile', label: '¿Cuánto cuesta una página web en Chile en 2026?' },
  { href: '/blog/cuanto-cobra-una-agencia-de-marketing-digital-en-chile', label: '¿Cuánto cobra una agencia de marketing digital en Chile?' },
  { href: '/blog/como-aparecer-en-google-chile-seo-local', label: 'Cómo aparecer en Google en Chile: guía de SEO local' },
  { href: '/blog/google-ads-o-meta-ads-cual-conviene-en-chile', label: 'Google Ads o Meta Ads: cuál conviene en Chile' },
];
---

<Base locale={locale} title={t.meta.services.title} description={t.meta.services.desc}>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(servicesLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <!-- ════════ HERO ════════ -->
  <header class="sv-hero">
    <div class="sv-hero__inner">
      <p class="sv-hero__kicker" data-reveal>— {P(HERO.kicker)}</p>
      <h1 class="sv-hero__title">
        <span class="ln" data-split-chars>{P(HERO.line1)}</span>
        <span class="ln" data-split-chars>{P(HERO.line2)}</span>
        <span class="ln ln--accent" data-split-chars>{P(HERO.line3)}</span>
      </h1>
      <p class="sv-hero__intro" data-reveal data-delay="0.18">{P(HERO.intro)}</p>
      <div class="sv-hero__actions" data-reveal data-delay="0.28">
        <a href={lp('/cotizar')} class="sv-btn sv-btn--solid">
          {P(HERO.ctaPrimary)}
          <span aria-hidden="true">&#8594;</span>
        </a>
        <a href="#capacidades" class="sv-btn sv-btn--ghost">
          {P(HERO.ctaSecondary)}
        </a>
      </div>
    </div>
  </header>

  <!-- ════════ 01 · EL CRECIMIENTO NO OCURRE EN UN SOLO CANAL ════════ -->
  <section class="sv-friction">
    <div class="sv-wrap">
      <div class="sv-friction__head">
        <p class="sv-kicker" data-reveal>— {P(FRICTION.kicker)}</p>
        <h2 class="sv-h2" data-split-chars>{P(FRICTION.title)}</h2>
        <p class="sv-lead" data-reveal data-delay="0.12">{P(FRICTION.lead)}</p>
      </div>

      <ol class="sv-friction__list">
        {FRICTION.points.map((p, i) => (
          <li class="sv-friction__item" data-reveal data-delay={String(i * 0.08)}>
            <span class="sv-friction__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <p>{P(p)}</p>
          </li>
        ))}
      </ol>

      <p class="sv-friction__close" data-reveal>{P(FRICTION.close)}</p>

      <!-- Cadena del sistema -->
      <div class="sv-chain" data-reveal>
        {FRICTION.chain.map((c, i) => (
          <>
            <div class="sv-chain__node">
              <span class="sv-chain__key">{c.key}</span>
              <span class="sv-chain__q">{P(c.q)}</span>
            </div>
            {i < FRICTION.chain.length - 1 && (
              <span class="sv-chain__arrow" aria-hidden="true">&#8594;</span>
            )}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════ CAPACIDADES ════════ -->
  <section class="sv-caps" id="capacidades">
    <div class="sv-wrap">
      <div class="sv-caps__head">
        <p class="sv-kicker" data-reveal>— {P(LABELS.sectionServices)}</p>
        <h2 class="sv-h2 sv-h2--poster" data-split-chars>{P(LABELS.sectionServicesTitle)}</h2>
      </div>
    </div>

    {blocks.map((b, i) => (
      <article class="sv-svc" id={`svc-${b.slug}`} data-flip={i % 2 === 1 ? 'true' : undefined}>
        <div class="sv-wrap sv-svc__grid">
          <div class="sv-svc__rail">
            <span class="sv-svc__num" data-reveal>{b.num}</span>
            <span class="sv-svc__tag" data-reveal data-delay="0.06">{P(b.tag)}</span>
          </div>

          <div class="sv-svc__main">
            <h3 class="sv-svc__title" data-reveal>{P(b.title)}</h3>
            <p class="sv-svc__headline" data-reveal data-delay="0.06">{P(b.headline)}</p>
            <p class="sv-svc__lead" data-reveal data-delay="0.12">{P(b.lead)}</p>

            <div class="sv-svc__caps" data-reveal data-delay="0.16">
              <p class="sv-svc__caps-label">{P(LABELS.capabilities)}</p>
              <ul class="sv-svc__caps-list">
                {(es ? b.capabilities.es : b.capabilities.en).map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>

            {b.foundation && (
              <div class="sv-found" data-reveal>
                <p class="sv-found__label">{P(b.foundation.label)}</p>
                <div class="sv-found__items">
                  {(es ? b.foundation.items.es : b.foundation.items.en).map((f) => (
                    <span class="sv-found__item">{f}</span>
                  ))}
                </div>
              </div>
            )}

            {b.flow && (
              <div class="sv-flow" data-reveal aria-hidden="true">
                {b.flow.map((step, i) => (
                  <>
                    <span class="sv-flow__step">{step}</span>
                    {i < b.flow!.length - 1 && <span class="sv-flow__sep">&#8594;</span>}
                  </>
                ))}
              </div>
            )}

            <p class="sv-svc__disco" data-reveal>
              <span class="sv-svc__disco-tag">{P(LABELS.discoverability)}</span>
              {P(b.discoverability)}
            </p>

            <a href={lp(`/servicios/${b.slug}`)} class="sv-svc__go">
              {P(LABELS.explore)}
              <span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- ════════ DISCOVERABILITY SYSTEM ════════ -->
  <section class="sv-disco">
    <div class="sv-wrap">
      <div class="sv-disco__head">
        <p class="sv-kicker sv-kicker--light" data-reveal>— {P(DISCOVERABILITY.kicker)}</p>
        <h2 class="sv-h2 sv-h2--light" data-split-chars>{P(DISCOVERABILITY.title)}</h2>
        <p class="sv-lead sv-lead--light" data-reveal data-delay="0.12">{P(DISCOVERABILITY.lead)}</p>
      </div>

      <div class="sv-disco__grid">
        {DISCOVERABILITY.pillars.map((p, i) => (
          <div class="sv-pillar" data-reveal data-delay={String(i * 0.06)}>
            <span class="sv-pillar__code">{p.code}</span>
            <span class="sv-pillar__scope">{P(p.scope)}</span>
            <p class="sv-pillar__desc">{P(p.desc)}</p>
          </div>
        ))}
      </div>

      <div class="sv-disco__result" data-reveal>
        <span class="sv-disco__eq" aria-hidden="true">=</span>
        <span class="sv-disco__label">{P(DISCOVERABILITY.result)}</span>
      </div>

      <p class="sv-disco__note" data-reveal>{P(DISCOVERABILITY.disclaimer)}</p>
    </div>
  </section>

  <!-- ════════ CÓMO SE CONECTA TODO ════════ -->
  <section class="sv-connect">
    <div class="sv-wrap">
      <div class="sv-connect__head">
        <p class="sv-kicker" data-reveal>— {P(CONNECTION.kicker)}</p>
        <h2 class="sv-h2" data-split-chars>{P(CONNECTION.title)}</h2>
        <p class="sv-lead" data-reveal data-delay="0.12">{P(CONNECTION.lead)}</p>
      </div>

      <ol class="sv-connect__flow">
        {CONNECTION.steps.map((s, i) => (
          <li class="sv-connect__step" data-reveal data-delay={String(i * 0.06)}>
            <span class="sv-connect__code">{s.code}</span>
            <span class="sv-connect__rule" aria-hidden="true"></span>
            <span class="sv-connect__d">{P(s.d)}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ════════ CASOS ════════ -->
  {cases.length > 0 && (
    <section class="sv-cases">
      <div class="sv-wrap">
        <div class="sv-cases__head">
          <p class="sv-kicker" data-reveal>— {P(CASES.kicker)}</p>
          <h2 class="sv-h2" data-split-chars>{P(CASES.title)}</h2>
        </div>

        <div class="sv-cases__list">
          {cases.map((c) => (
            <article class="sv-case" data-reveal>
              <header class="sv-case__head">
                <h3 class="sv-case__client">{c.client}</h3>
                <span class="sv-case__sector">{P(c.sector)}</span>
              </header>

              <div class="sv-case__body">
                <div class="sv-case__col">
                  <p class="sv-case__label">{P(CASES.labels.challenge)}</p>
                  <p class="sv-case__text">{P(c.challenge)}</p>
                </div>
                <div class="sv-case__col">
                  <p class="sv-case__label">{P(CASES.labels.strategy)}</p>
                  <p class="sv-case__text">{P(c.approach)}</p>
                </div>
                <div class="sv-case__col">
                  <p class="sv-case__label">{P(CASES.labels.impact)}</p>
                  <p class="sv-case__text">{P(c.outcome)}</p>
                </div>
              </div>

              {c.metrics.length > 0 && (
                <div class="sv-case__metrics">
                  {c.metrics.map((m) => (
                    <div class="sv-metric">
                      <span class="sv-metric__val">{m.val}</span>
                      <span class="sv-metric__lbl">{P(m.lbl)}</span>
                    </div>
                  ))}
                </div>
              )}

              <a href={lp(`/trabajos/${c.slug}`)} class="sv-case__go">
                {P(CASES.viewCase)} <span aria-hidden="true">&#8594;</span>
              </a>
            </article>
          ))}
        </div>

        <a href={lp('/trabajos')} class="sv-cases__all" data-reveal>
          {P(CASES.viewAll)} <span aria-hidden="true">&#8594;</span>
        </a>
      </div>
    </section>
  )}

  <!-- ════════ PROCESO ════════ -->
  <section class="sv-process">
    <div class="sv-wrap">
      <div class="sv-process__head">
        <p class="sv-kicker sv-kicker--light" data-reveal>— {P(PROCESS.kicker)}</p>
        <h2 class="sv-h2 sv-h2--light" data-split-chars>{P(PROCESS.title)}</h2>
      </div>
      <div class="sv-process__grid">
        {PROCESS.steps.map((s, i) => (
          <div class="sv-step" data-reveal data-delay={String(i * 0.07)}>
            <span class="sv-step__n">{s.n}</span>
            <h3 class="sv-step__code">{s.code}</h3>
            <p class="sv-step__d">{P(s.d)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════ INVERSIÓN ════════ -->
  <section class="sv-invest">
    <div class="sv-wrap sv-invest__grid">
      <div>
        <p class="sv-kicker" data-reveal>— {P(INVESTMENT.kicker)}</p>
        <h2 class="sv-h2" data-split-chars>{P(INVESTMENT.title)}</h2>
        <p class="sv-lead" data-reveal data-delay="0.12">{P(INVESTMENT.lead)}</p>
        <a href={lp('/cotizar')} class="sv-btn sv-btn--solid sv-invest__cta" data-reveal>
          {P(INVESTMENT.cta)} <span aria-hidden="true">&#8594;</span>
        </a>
      </div>
      <ul class="sv-invest__factors">
        {INVESTMENT.factors.map((f, i) => (
          <li data-reveal data-delay={String(i * 0.05)}>{P(f)}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ════════ FAQ ════════ -->
  <section class="sv-faq">
    <div class="sv-wrap">
      <div class="sv-faq__head">
        <p class="sv-kicker" data-reveal>— {P(FAQ.kicker)}</p>
        <h2 class="sv-h2" data-split-chars>{P(FAQ.title)}</h2>
      </div>
      <div class="sv-faq__list">
        {FAQ.items.map((f) => (
          <details class="faq-item" data-reveal>
            <summary>
              {P(f.q)}
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </summary>
            <p class="faq-item__body">{P(f.a)}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {es && (
    <!-- Contexto local — cobertura semántica real, sin relleno de keywords -->
    <section class="sv-local">
      <div class="sv-wrap sv-local__grid">
        <div>
          <h2 class="sv-local__title">Agencia digital en Santiago de Chile</h2>
          <p>
            BrandUp es una agencia de marketing digital y diseño web con base en Santiago
            que trabaja con empresas de la Región Metropolitana, del resto de Chile y del
            extranjero. Reunimos en un mismo equipo las disciplinas que normalmente están
            repartidas entre varios proveedores: estrategia y branding, desarrollo web y
            e-commerce, contenido, publicidad digital, automatización con IA y growth.
          </p>
          <p>
            Esa integración es el punto: una identidad que se sostiene en la experiencia
            digital, un sitio preparado para ser encontrado, campañas que aterrizan donde
            corresponde y procesos que no dependen de que alguien esté disponible. Si estás
            evaluando un proyecto y quieres entender qué implica, conversemos.
          </p>
        </div>
        <div class="sv-local__links">
          <p class="sv-local__links-label">— Guías publicadas</p>
          {seoLinks.map((l) => (
            <a href={l.href} class="sv-local__link">{l.label} <span aria-hidden="true">&#8594;</span></a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand locale={locale} />
</Base>

<style>
/* ════════════════════════════════════════════════════════════════════
   /servicios — experiencia editorial premium.
   Sistema: tipografía protagonista, mucho aire, líneas finas, números
   grandes y acento naranja usado con cuentagotas. Ritmo de fondos:
   oscuro → claro → claro → oscuro → claro → crema → oscuro → claro.
   ════════════════════════════════════════════════════════════════════ */

.sv-wrap {
  max-width: 1360px;
  margin-inline: auto;
  padding-inline: 24px;
}
@media (min-width: 768px) { .sv-wrap { padding-inline: 48px; } }

/* ── Tipografía compartida ──────────────────────────────────────── */
.sv-kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 22px;
}
.sv-kicker--light { color: var(--color-accent); }

.sv-h2 {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: clamp(2rem, 4.6vw, 4.1rem);
  line-height: 1.02;
  letter-spacing: -0.035em;
  color: var(--color-paper);
  max-width: 20ch;
  text-wrap: balance;
}
.sv-h2--light { color: #f8f8f8; }
.sv-h2--poster {
  font-family: var(--font-poster);
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.012em;
  line-height: 0.98;
  font-size: clamp(2.1rem, 5.6vw, 5rem);
  max-width: 16ch;
}
.sv-lead {
  margin-top: clamp(20px, 2.6vw, 30px);
  max-width: 60ch;
  font-size: clamp(1.02rem, 1.55vw, 1.2rem);
  line-height: 1.7;
  color: var(--color-gray);
}
.sv-lead--light { color: rgba(248, 248, 248, 0.62); }

/* ── Botones ────────────────────────────────────────────────────── */
.sv-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 0.95rem;
  font-weight: 600;
  padding: 15px 32px;
  border-radius: 100px;
  transition: background 0.35s ease, color 0.35s ease, gap 0.35s ease, border-color 0.35s ease;
}
.sv-btn--solid { background: var(--color-accent); color: #fff; }
.sv-btn--solid:hover { background: #f8f8f8; color: #0d0d0d; gap: 16px; }
.sv-btn--ghost {
  color: rgba(248, 248, 248, 0.86);
  border: 1px solid rgba(248, 248, 248, 0.22);
}
.sv-btn--ghost:hover { border-color: #f8f8f8; color: #f8f8f8; }

/* ════════ HERO ════════ */
.sv-hero {
  position: relative;
  background: #0d0d0d;
  color: #f8f8f8;
  overflow: hidden;
  padding: clamp(150px, 17vw, 220px) 0 clamp(80px, 10vw, 130px);
}
.sv-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 60% 70% at 88% -8%, rgba(240, 94, 35, 0.18) 0%, transparent 62%);
  pointer-events: none;
}
.sv-hero__inner {
  position: relative;
  max-width: 1360px;
  margin-inline: auto;
  padding-inline: 24px;
}
@media (min-width: 768px) { .sv-hero__inner { padding-inline: 48px; } }
.sv-hero__kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 26px;
}
.sv-hero__title {
  font-family: var(--font-poster);
  font-weight: 400;
  font-size: clamp(2.35rem, 7.4vw, 6.6rem);
  letter-spacing: 0.012em;
  line-height: 0.98;
  text-transform: uppercase;
}
.sv-hero__title .ln { display: block; }
.sv-hero__title .ln--accent {
  color: transparent;
  -webkit-text-stroke: clamp(1.3px, 0.22vw, 2.2px) var(--color-accent);
}
.sv-hero__intro {
  margin-top: clamp(28px, 3.6vw, 44px);
  max-width: 64ch;
  font-size: clamp(1rem, 1.6vw, 1.22rem);
  line-height: 1.7;
  color: rgba(248, 248, 248, 0.6);
}
.sv-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: clamp(32px, 4vw, 46px);
}

/* ════════ FRICCIÓN ════════ */
.sv-friction {
  background: var(--color-ink);
  padding-block: clamp(84px, 11vw, 150px);
  border-bottom: 1px solid var(--color-line);
}
.sv-friction__list {
  list-style: none;
  margin-top: clamp(48px, 6vw, 78px);
  border-top: 1px solid var(--color-line);
}
.sv-friction__item {
  display: grid;
  grid-template-columns: 56px 1fr;
  gap: 18px;
  align-items: baseline;
  padding: clamp(22px, 2.6vw, 32px) 0;
  border-bottom: 1px solid var(--color-line);
}
@media (min-width: 900px) {
  .sv-friction__item { grid-template-columns: 110px 1fr; gap: 40px; }
}
.sv-friction__idx {
  font-family: var(--font-poster);
  font-size: clamp(1.1rem, 1.6vw, 1.35rem);
  color: var(--color-accent);
  letter-spacing: 0.04em;
}
.sv-friction__item p {
  font-size: clamp(1.06rem, 2vw, 1.6rem);
  line-height: 1.42;
  letter-spacing: -0.018em;
  color: var(--color-paper);
  max-width: 40ch;
  text-wrap: balance;
}
.sv-friction__close {
  margin-top: clamp(40px, 5vw, 64px);
  max-width: 62ch;
  font-size: clamp(1rem, 1.5vw, 1.16rem);
  line-height: 1.72;
  color: var(--color-gray);
}

/* Cadena Brand → Digital → … */
.sv-chain {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px 14px;
  margin-top: clamp(48px, 6vw, 76px);
