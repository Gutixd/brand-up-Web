---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';
import { SERVICES } from '../../data/services';
import { useT, pick, localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const lp = (p: string) => localePath(locale, p);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.services.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const moreLabel = locale === 'es' ? 'Ver servicio' : 'View service';
---

<Base locale={locale} title={t.meta.services.title} description={t.meta.services.desc}>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <PageHero kicker={t.services.kicker} title={t.services.title} intro={t.services.intro} />

  <!-- Lista editorial de servicios -->
  <section class="svc-index">
    {SERVICES.map((s) => (
      <a href={lp(`/servicios/${s.slug}`)} class="svc-index__row" data-reveal>
        <span class="svc-index__num">{s.num}</span>
        <div class="svc-index__main">
          <h2 class="svc-index__title">{pick(s.title, locale)}</h2>
          <p class="svc-index__short">{pick(s.short, locale)}</p>
        </div>
        <span class="svc-index__tag">{pick(s.tag, locale)}</span>
        <span class="svc-index__cta">{moreLabel} <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </section>

  <!-- FAQ -->
  <section class="page-section--cream">
    <div class="page-section__inner" style="padding-block: 96px;">
      <div class="sec-head">
        <p class="sec-head__kicker">{t.services.faqKicker}</p>
        <h2 class="sec-head__title">{t.services.faqTitle}</h2>
      </div>
      <div class="mx-auto max-w-4xl">
        {t.services.faq.map((f) => (
          <details class="faq-item" data-reveal>
            <summary>
              {f.q}
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </summary>
            <p class="faq-item__body">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
.svc-index {
  max-width: 1400px;
  margin-inline: auto;
  padding-inline: 24px;
  border-top: 1px solid var(--color-line);
}
@media (min-width: 768px) { .svc-index { padding-inline: 48px; } }
.svc-index__row {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: 8px 24px;
  padding: 36px 8px;
  border-bottom: 1px solid var(--color-line);
  text-decoration: none;
  transition: background 0.35s, padding-inline 0.35s;
}
.svc-index__row:hover { background: #f0ede8; padding-inline: 20px; }
@media (min-width: 900px) {
  .svc-index__row {
    grid-template-columns: 56px minmax(0,1fr) 160px 160px;
    gap: 32px;
    padding-block: 40px;
  }
}
.svc-index__num {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--color-gray);
  font-variant-numeric: tabular-nums;
  align-self: start;
  padding-top: 8px;
}
.svc-index__main { min-width: 0; }
.svc-index__title {
  font-family: var(--font-display);
  font-size: clamp(1.7rem, 4vw, 2.8rem);
  font-weight: 600;
  letter-spacing: -0.035em;
  line-height: 1.02;
  color: var(--color-paper);
  transition: color 0.3s, transform 0.4s cubic-bezier(0.22,1,0.36,1);
}
.svc-index__row:hover .svc-index__title { color: var(--color-accent); }
.svc-index__short {
  margin-top: 10px;
  font-size: 0.98rem;
  line-height: 1.5;
  color: var(--color-gray);
  max-width: 52ch;
}
.svc-index__tag {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-gray);
  grid-column: 2;
}
@media (min-width: 900px) {
  .svc-index__tag { grid-column: auto; justify-self: start; align-self: center; }
}
.svc-index__cta {
  display: none;
  align-items: center;
  gap: 8px;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--color-accent);
  justify-self: end;
  white-space: nowrap;
  transition: gap 0.3s;
}
.svc-index__row:hover .svc-index__cta { gap: 14px; }
@media (min-width: 900px) { .svc-index__cta { display: inline-flex; } }
</style>
