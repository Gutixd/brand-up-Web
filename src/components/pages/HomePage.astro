---
import Base from '../../layouts/Base.astro';
import TestimonialCarousel from '../TestimonialCarousel';
import ParticleSphere from '../ParticleSphere.astro';
import { SERVICES } from '../../data/services';
import { PROJECTS } from '../../data/projects';
import { TESTIMONIALS } from '../../data/testimonials';
import { useT, pick, localePath, type Locale } from '../../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const lp = (p: string) => localePath(locale, p);

const featured = PROJECTS.filter((p) => p.featured);
const testimonials = TESTIMONIALS.map((x) => ({
  text: pick(x.text, locale),
  name: x.name,
  role: pick(x.role, locale),
  initials: x.initials,
}));

const worksAllLabel = locale === 'es' ? 'Ver todos los trabajos' : 'View all work';
---

<Base locale={locale} title={t.meta.home.title} description={t.meta.home.desc}>

  <!-- ════ HERO ════════════════════════════════════════════════════ -->
  <section class="relative flex min-h-[100svh] flex-col justify-between overflow-hidden px-5 pt-[88px] md:px-8">
    <div class="hero-aurora" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto flex w-full max-w-[1400px] items-center justify-between pt-6 text-xs font-medium uppercase tracking-[0.14em] text-gray">
      <span data-reveal>{t.hero.location}</span>
      <span data-reveal data-delay="0.1">©{new Date().getFullYear()}</span>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-[1400px]">
      <p class="hero-eyebrow" data-reveal>
        <span class="hero-eyebrow__dot" aria-hidden="true"></span>
        {locale === 'es' ? 'Disponible para nuevos proyectos' : 'Available for new projects'}
      </p>
      <h1 class="display-tight font-display text-[17vw] uppercase leading-[0.92] md:text-[12.5vw]">
        <span class="block" data-reveal-word>{t.hero.line1}</span>
        <span class="block pl-[8vw] text-accent" data-reveal-word>{t.hero.line2}</span>
        <span class="block" data-reveal-word>{t.hero.line3}</span>
      </h1>
    </div>

    <div class="relative z-10 mx-auto flex w-full max-w-[1400px] flex-col gap-8 pb-10 md:flex-row md:items-end md:justify-between">
      <p class="max-w-md text-base text-gray md:text-lg" data-reveal data-delay="0.5">{t.hero.subtitle}</p>
      <div class="flex items-center gap-4" data-reveal data-delay="0.6">
        <a href={lp('/cotizar')} data-magnetic="0.4" class="rounded-full bg-paper px-7 py-3.5 text-sm font-medium text-ink transition-colors hover:bg-accent">{t.hero.cta}</a>
        <a href={lp('/trabajos')} data-magnetic="0.4" class="rounded-full border border-line px-7 py-3.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent">{t.hero.cta2}</a>
      </div>
    </div>

    <div class="hero-scroll hidden md:flex" aria-hidden="true">
      <span>{locale === 'es' ? 'Scroll' : 'Scroll'}</span>
      <span class="hero-scroll__line"></span>
    </div>
  </section>

  <!-- ════ MARQUEE ══════════════════════════════════════════════════ -->
  <section class="rule overflow-hidden py-12 md:py-20">
    <div class="marquee-track marquee-track--slow items-center" aria-hidden="true">
      {[0, 1].map(() => (
        <span class="display-tight whitespace-nowrap pr-8 font-display text-[11vw] uppercase md:text-[8vw]">
          {t.marquee.words.map((w: string, i: number) => (
            <span class={i === 1 ? 'text-accent' : ''}>{w}&nbsp;</span>
          ))}
          —&nbsp;
        </span>
      ))}
    </div>
  </section>

  <!-- ════ SHOWREEL — pantalla completa ════════════════════════════ -->
  <div class="showreel-section" id="showreel-trigger" data-reveal>
    <video
      class="showreel-inner"
      id="showreel-bg"
      src="/videos/showreel.mp4"
      autoplay
      muted
      loop
      playsinline
    ></video>
  </div>

  <!-- ════ LIGHTBOX DEL SHOWREEL ════════════════════════════════════ -->
  <div class="showreel-lightbox" id="showreel-lightbox" aria-hidden="true">
    <div class="showreel-lightbox__wrap">
      <video
        class="showreel-lightbox__video"
        id="showreel-modal-video"
        src="/videos/showreel.mp4"
        playsinline
      ></video>
    </div>
  </div>

  <!-- ════ STATEMENT — centrado, post-its, swap reversible ═════════ -->
  <!--
    FOTO DE FONDO: cuando la tengas, añade al div.statement-bg:
      style="background-image:url('/img/tu-foto.jpg')"
    (ya queda sutil al 10% de opacidad).
  -->
  <section class="statement-section rule">
    <div class="statement-bg"></div>
    <span class="statement-ghost" aria-hidden="true">{locale === 'es' ? 'Páginas Web' : 'Web Design'}</span>

    <div class="statement-inner">
      <div class="statement-texts">
        <p class="statement-text--a display-tight font-display text-[clamp(1.8rem,4.5vw,3.6rem)] leading-[1.08]">
          {t.statement.text}
        </p>
        <p class="statement-text--b display-tight font-display text-[clamp(1.8rem,4.5vw,3.6rem)] leading-[1.08]">
          {t.statement.text2}
        </p>
      </div>
    </div>
  </section>

  <!-- ════ TRABAJOS — intro "Our Works" ════════════════════════════ -->
  <section class="works-intro">
    <div class="works-intro__bg"></div>
    <div class="works-intro__scrim"></div>
    <div class="works-intro__content">
      <p class="works-intro__kicker">
        {locale === 'es' ? '— Portafolio seleccionado 2024–2025' : '— Selected portfolio 2024–2025'}
      </p>
      <h2 class="works-intro__title">
        <span class="ln">{locale === 'es' ? 'Nuestros' : 'Our'}</span>
        <span class="ln ln--alt">{locale === 'es' ? 'Trabajos' : 'Works'}</span>
      </h2>
      <p class="works-intro__desc">
        {locale === 'es'
          ? 'Marcas reales, resultados medibles. Cada proyecto parte de un objetivo concreto: más ventas, más visibilidad o una identidad que dure. Esto es lo que hemos construido.'
          : 'Real brands, measurable results. Every project starts from a concrete goal: more sales, more visibility or an identity built to last. This is what we\'ve built.'}
      </p>
    </div>
    <div class="works-intro__meta">
      <span class="works-intro__hint">
        {locale === 'es' ? 'Desplázate para ver' : 'Scroll to explore'}
        <svg width="12" height="14" viewBox="0 0 12 14" fill="none" aria-hidden="true">
          <path d="M6 1v12M1 8l5 5 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </section>

  <!-- ════ TRABAJOS — videos full-screen (sticky, sin nombres) ═════ -->
  <div class="works-videos">
    {featured.map((p, i) => (
      <a
        href={lp(`/trabajos/${p.slug}`)}
        class="project-video group"
        data-video-src={`/videos/work${i + 1}.mp4`}
        aria-label={p.client}
      >
        <div class="project-video__inner" style={`background:${p.gradient}`}>
          <div class="project-video__placeholder">
            <span class="project-video__play">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="#f8f8f8" aria-hidden="true">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </span>
            <span class="project-video__soon">{locale === 'es' ? 'Video próximamente' : 'Video coming soon'}</span>
          </div>
        </div>
      </a>
    ))}

    <!-- Cierre: ver todos -->
    <div class="relative z-10 flex justify-center bg-[#0d0d0d] pb-20 pt-16">
      <a href={lp('/trabajos')} class="rounded-full border border-[rgba(248,248,248,0.2)] px-8 py-3.5 text-sm font-medium text-[#f8f8f8] transition-colors hover:border-accent hover:text-accent">
        {worksAllLabel} →
      </a>
    </div>
  </div>

  <!-- ════ STATS + ESFERA 3D ══════════════════════════════════════ -->
  <section class="stats-section rule">
    <div class="stats-section__inner">

      <!-- Columna izquierda: números -->
      <div class="stats-section__left">
        <div class="stats-section__heading" data-reveal>
          <p class="stats-section__kicker">{locale === 'es' ? '— En números' : '— By the numbers'}</p>
          <h2 class="stats-section__heading-title display-tight">
            {locale === 'es' ? 'Resultados, no promesas.' : 'Results, not promises.'}
          </h2>
        </div>
        <div class="stats-grid">
          {[
            { num: 15, suffix: '+', lbl: locale === 'es' ? 'Proyectos entregados' : 'Delivered projects' },
            { num: 6,  suffix: '',  lbl: locale === 'es' ? 'Industrias' : 'Industries' },
            { num: 1,   suffix: 'M+', lbl: locale === 'es' ? 'Views en un reel' : 'Views on a reel' },
            { num: 2,  suffix: '',  lbl: locale === 'es' ? 'Países alcanzados' : 'Countries reached' },
          ].map((s, i) => (
            <div class="stat-item" data-reveal data-delay={`${i * 0.1}`}>
              <span class="stat-val display-tight block font-display text-5xl md:text-7xl" data-counter={s.num} data-suffix={s.suffix}>
                {s.num}{s.suffix}
              </span>
              <span class="stat-lbl">{s.lbl}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Columna derecha: esfera 3D -->
      <div class="stats-section__right">
        <ParticleSphere />
      </div>

    </div>
  </section>

  <!-- ════ SERVICIOS — acordeón (hover/tap para expandir) ══════════ -->
  <section class="svc-accordion">
    <div class="svc-accordion__header">
      <p class="svc-accordion__kicker">{locale === 'es' ? '— Lo que hacemos' : '— What we do'}</p>
      <h2 class="svc-accordion__title display-tight" data-split-chars>
        {locale === 'es' ? 'Encuentra el servicio que necesitas' : 'Find the service you need'}
      </h2>
      <p class="svc-accordion__sub">
        {locale === 'es'
          ? 'Una agencia creativa y digital para cada etapa de tu marca.'
          : 'A creative digital agency for every stage of your brand.'}
      </p>
    </div>

    <ul class="svc-list">
      {SERVICES.map((s, i) => (
        <li class="svc-row" data-svc-row>
          <button class="svc-row__head" type="button" aria-expanded="false">
            <span class="svc-row__tag">{pick(s.tag, locale)}</span>
            <span class="svc-row__title">{pick(s.title, locale)}</span>
            <span class="svc-row__num">{String(i + 1).padStart(2, '0')}.</span>
            <span class="svc-row__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19" class="svc-row__icon-v" />
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
            </span>
          </button>
          <div class="svc-row__body">
            <div class="svc-row__body-inner">
              <p class="svc-row__desc">{pick(s.desc, locale)}</p>
              <a href={lp(`/servicios/${s.slug}`)} class="svc-row__more">
                <span>↳</span> {locale === 'es' ? 'Más información' : 'More information'}
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- ════ TESTIMONIOS ══════════════════════════════════════════════ -->
  <section class="rule">
    <div class="mx-auto max-w-[1400px] px-5 py-20 md:px-8 md:py-28">
      <h2 class="display-tight mb-14 font-display text-4xl uppercase md:text-6xl" data-reveal-word>
        {t.home.testimonialsTitle}
      </h2>
      <div data-reveal>
        <TestimonialCarousel client:visible items={testimonials} />
      </div>
    </div>
  </section>

  <!-- ════ CTA FINAL ════════════════════════════════════════════════ -->
  <section class="cta-final">
    <div class="cta-final__inner">
      <p class="cta-final__kicker" data-reveal>{t.home.ctaText}</p>
      <h2 class="cta-final__title display-tight" data-split-chars>
        {t.home.ctaTitle}
      </h2>
      <div class="cta-final__actions" data-reveal data-delay="0.3">
        <a href={lp('/cotizar')} data-magnetic="0.35" class="cta-final__btn">
          {locale === 'es' ? 'Empezar ahora' : 'Start now'} →
        </a>
        <a href={lp('/trabajos')} class="cta-final__link">
          {locale === 'es' ? 'Ver nuestros trabajos' : 'See our work'}
        </a>
      </div>
    </div>
  </section>

</Base>
