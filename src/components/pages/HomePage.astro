---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import IntroOverlay from '../IntroOverlay.astro';
import TestimonialCarousel from '../TestimonialCarousel';
import { PROJECTS } from '../../data/projects';
import { SERVICES } from '../../data/services';
import { TESTIMONIALS } from '../../data/testimonials';
import { useT, pick, localePath, type Locale } from '../../i18n';

import imgWorksBg from '../../assets/categories/team.webp';

// Collage y strip: material REAL de cada cliente. Antes eran fotos de stock
// de Unsplash rotuladas con estos mismos nombres, lo que daba a entender que
// ese trabajo era nuestro. Estos archivos sí salen de los proyectos.
import colSuperlunch from '../../assets/projects/gallery/superlunch-packaging.webp';
import colAracnida from '../../assets/projects/gallery/aracnida-product.webp';
import colJdcargo from '../../assets/projects/gallery/jdcargo-desktop.webp';
import colMicroterapias from '../../assets/projects/gallery/microterapias-1.webp';
import colBell from '../../assets/projects/gallery/bellcollege-1.webp';

import stBschool from '../../assets/projects/gallery/bschool-1.webp';
import stAseocool from '../../assets/projects/gallery/aseocool-home.webp';
import stChacha from '../../assets/projects/gallery/chachapollo-instagram.webp';
import stMusclecar from '../../assets/projects/gallery/musclecarchile-home.webp';
import stAltitude from '../../assets/projects/gallery/altitude-desktop.webp';
import stDuoc from '../../assets/projects/gallery/duocuc-instagram.webp';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const lp = (p: string) => localePath(locale, p);
const es = locale === 'es';

const featured = PROJECTS.filter((p) => p.featured);
const testimonials = TESTIMONIALS.map((x) => ({
  text: pick(x.text, locale),
  name: x.name,
  role: pick(x.role, locale),
  initials: x.initials,
}));

const worksAllLabel = es ? 'Ver todos los trabajos' : 'View all work';

// ── Ticker urbano ──────────────────────────────────────────────────
const tickerWords = es
  ? ['Branding', 'Contenido', 'Diseño Web', 'E-commerce', 'Publicidad', 'IA', 'Growth']
  : ['Branding', 'Content', 'Web Design', 'E-commerce', 'Ads', 'AI', 'Growth'];
const tickerBrand = es
  ? ['Brand Up©', 'Santiago de Chile', '© 2026', 'Hecho con calle']
  : ['Brand Up©', 'Santiago, Chile', '© 2026', 'Street-smart work'];

// ── Servicios → imagen de preview flotante ─────────────────────────
const svcImg: Record<string, string> = {
  'diseno-web': '/images/urban/svc-web.jpg',
  'ecommerce': '/images/urban/svc-ecommerce.jpg',
  'branding': '/images/urban/svc-branding.jpg',
  'contenido-reels': '/images/urban/svc-reels.jpg',
  'publicidad-digital': '/images/urban/svc-ads.jpg',
  'automatizaciones-ia': '/images/urban/svc-ia.jpg',
  'marketing-growth': '/images/urban/svc-growth.jpg',
};

// ── Collage del manifiesto (polaroids con parallax) — trabajo real ─
const collage = [
  { img: colSuperlunch,    cap: 'Superlunch',     par: -16 },
  { img: colAracnida,      cap: 'Aracnida Store', par: -28 },
  { img: colJdcargo,       cap: 'JD Cargo',       par: -10 },
  { img: colMicroterapias, cap: 'Microterapias',  par: -24 },
  { img: colBell,          cap: 'Bell College',   par: -14 },
];

// ── Strip urbano horizontal — trabajo real ──────────────────────────
const streets = [
  { img: stBschool,    chip: 'BSchool' },
  { img: stAseocool,   chip: 'AseoCool' },
  { img: stChacha,     chip: 'El Chacha Pollo' },
  { img: stMusclecar,  chip: 'MuscleCarChile' },
  { img: stAltitude,   chip: 'Altitude' },
  { img: stDuoc,       chip: 'Duoc UC' },
];

// ── Stats ──────────────────────────────────────────────────────────
// FAQ de la home: preguntas reales que la gente escribe en Google y en los
// asistentes con IA sobre agencias en Santiago. Se emite también como
// FAQPage en JSON-LD (ver faqLd más abajo).
const homeFaq = es
  ? [
      { q: '¿Cuánto cuesta una página web en Santiago de Chile?', a: 'Una landing page va de $150.000 a $400.000 CLP, un sitio corporativo de $350.000 a $900.000 y un e-commerce de $600.000 a $2.500.000. El precio depende de la estrategia, el diseño propio y la optimización, no solo de la cantidad de páginas.' },
      { q: '¿Qué servicios ofrece BrandUp?', a: 'Diseño y desarrollo web, e-commerce, branding e identidad visual, contenido y reels para redes sociales, publicidad digital (Meta y Google Ads), SEO local y automatizaciones con IA. Trabajamos con negocios de Santiago y toda la Región Metropolitana.' },
      { q: '¿Trabajan con negocios de todo Chile o solo de Santiago?', a: 'Estamos en Santiago de Chile y trabajamos con clientes de toda la Región Metropolitana y del resto del país. El trabajo se coordina de forma remota, con reuniones por videollamada y entregas digitales.' },
      { q: '¿Cuánto tardan en entregar un proyecto?', a: 'Una landing toma de 1 a 2 semanas, un sitio corporativo de 3 a 6 semanas y un e-commerce de 6 a 12 semanas. El plazo depende sobre todo de la rapidez con que se entregan textos, fotos y aprobaciones.' },
      { q: '¿El sitio y las cuentas quedan a mi nombre?', a: 'Sí. El dominio, el sitio web y las cuentas de redes sociales quedan siempre a nombre del cliente. Entregamos los accesos completos y nunca retenemos la propiedad de tus activos digitales.' },
    ]
  : [
      { q: 'How much does a website cost in Santiago, Chile?', a: 'A landing page ranges from CLP $150,000 to $400,000, a corporate site from $350,000 to $900,000, and an e-commerce store from $600,000 to $2,500,000. Price depends on strategy, custom design and optimization, not just the number of pages.' },
      { q: 'What services does BrandUp offer?', a: 'Web design and development, e-commerce, branding and visual identity, social media content and reels, digital advertising (Meta and Google Ads), local SEO and AI automations. We work with businesses across Santiago and the wider Metropolitan Region.' },
      { q: 'Do you work with clients outside Santiago?', a: 'We are based in Santiago, Chile and work with clients across the Metropolitan Region and the rest of the country, coordinating remotely through video calls and digital deliverables.' },
      { q: 'How long does a project take?', a: 'A landing page takes 1–2 weeks, a corporate site 3–6 weeks, and an e-commerce store 6–12 weeks. Timelines depend mostly on how quickly copy, photos and approvals are provided.' },
      { q: 'Do I own the site and the accounts?', a: 'Yes. The domain, website and social media accounts always stay under the client’s name. We hand over full access and never retain ownership of your digital assets.' },
    ];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: es ? 'es-CL' : 'en',
  mainEntity: homeFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const stats = [
  { val: '15',      suffix: '+', prefix: '',  lbl: es ? 'Marcas acompañadas' : 'Brands supported' },
  { val: '1000000', suffix: '+', prefix: '',  lbl: es ? 'Views generadas para clientes' : 'Views generated for clients' },
  { val: '300',     suffix: '%', prefix: '+', lbl: es ? 'Engagement promedio' : 'Average engagement' },
  { val: '100',     suffix: '',  prefix: '',  lbl: es ? 'Performance score' : 'Performance score' },
];
---

<Base locale={locale} title={t.meta.home.title} description={t.meta.home.desc}>

  <!-- ════ INTRO CINEMÁTICA (una sola vez por sesión) ══════════════ -->
  <IntroOverlay locale={locale} />

  <!-- ════ HERO VIDEO ══════════════════════════════════════════════ -->
  <section class="hero-video-section">
    <!-- El reel es 16:9. En un hero vertical de celular, `object-fit: cover`
         recortaba ~74% del ancho y cortaba los carteles de texto y el logo,
         así que existe una versión nativa 9:16 (mismos beats, otro encuadre). -->
    <video
      class="hero-video__bg"
      autoplay
      muted
      loop
      playsinline
    ></video>
    <script is:inline>
      // OJO: no usar <source media="...">. Chrome IGNORA ese atributo dentro
      // de <video> y se queda siempre con la primera fuente, así que el
      // escritorio terminaba cargando la vertical. La fuente se elige acá,
      // antes de que arranque la descarga, para no bajar los dos archivos.
      (function () {
        var mq = window.matchMedia('(max-aspect-ratio: 1/1)');
        function pickHeroVideo() {
          var v = document.querySelector('.hero-video__bg');
          if (!v) return;
          var src = mq.matches
            ? '/videos/showreel-vertical.mp4'
            : '/videos/showreel.mp4';
          if (v.getAttribute('src') === src) return;
          v.src = src;
          v.load();
        }
        pickHeroVideo();
        // El sitio usa ClientRouter: al volver al inicio hay que reevaluar.
        document.addEventListener('astro:page-load', pickHeroVideo);
        // Y si el teléfono rota, cambia el encuadre correcto.
        mq.addEventListener('change', pickHeroVideo);
      })();
    </script>
    <div class="hero-video__scrim" aria-hidden="true"></div>

    <!-- Créditos estilo film, discretos sobre el video -->
    <div class="hero-credits" aria-hidden="true">
      <span>Brand Up® — {es ? 'Agencia creativa digital' : 'Digital creative agency'}</span>
      <span class="hero-credits__right">Stgo, Chile — © 2026</span>
    </div>

    <div class="hero-video__scroll" aria-hidden="true">
      <span>Scroll</span>
      <span class="hero-video__scroll-line"></span>
    </div>

    <!-- Cursor de flecha con física (solo sobre el video, puntero fino) -->
    <div class="hero-cursor" id="hero-cursor" aria-hidden="true">
      <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
        <path d="M42 24 L14 11 L22 24 L14 37 Z" fill="var(--color-accent)"
              stroke="var(--color-accent)" stroke-width="2" stroke-linejoin="round"/>
      </svg>
    </div>
  </section>

  <!-- ════ TICKER URBANO — doble banda cruzada ═════════════════════ -->
  <section class="ticker" aria-hidden="true">
    <div class="ticker__band ticker__band--accent">
      <div class="marquee-track">
        {[0, 1].map((copy) => (
          <div class="ticker__seq" aria-hidden={copy === 1 ? 'true' : undefined}>
            {tickerWords.map((w) => (
              <span class="ticker__item">{w} <span class="ticker__star">✦</span></span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="ticker__band ticker__band--dark">
      <div class="marquee-track marquee-track--reverse marquee-track--slow">
        {[0, 1].map((copy) => (
          <div class="ticker__seq" aria-hidden={copy === 1 ? 'true' : undefined}>
            {tickerBrand.map((w) => (
              <span class="ticker__item">{w} <span class="ticker__star">✦</span></span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ MANIFIESTO URBANO — tipografía gigante + collage ════════ -->
  <section class="manifesto">
    <div class="manifesto__inner">
      <span class="manifesto__sticker" data-reveal>
        Stgo, Chile ✦ © 2026
      </span>

      <h2 class="manifesto__title">
        <span class="ln" data-split-chars>{es ? 'No somos' : 'Not'}</span>
        <span class="ln" data-split-chars>{es ? 'una agencia' : 'another'}</span>
        <span class="ln ln--accent" data-split-chars>{es ? 'más.' : 'agency.'}</span>
      </h2>

      <p class="manifesto__desc" data-reveal data-delay="0.15">
        {es
          ? 'Somos el equipo que convierte marcas comunes en marcas que se notan. Estrategia, diseño y contenido con calle: hecho en Santiago, pensado para vender.'
          : "We're the team that turns ordinary brands into brands people notice. Strategy, design and street-smart content: made in Santiago, built to sell."}
      </p>

      <!-- Badge circular giratorio -->
      <div class="manifesto__badge" aria-hidden="true">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <path id="bu-circ" d="M100,100 m-76,0 a76,76 0 1,1 152,0 a76,76 0 1,1 -152,0"/>
          </defs>
          <text class="manifesto__badge-text">
            <textPath href="#bu-circ">BRAND UP ✦ SANTIAGO ✦ BRAND UP ✦ CRECIMIENTO ✦</textPath>
          </text>
          <text x="100" y="116" text-anchor="middle" class="manifesto__badge-star">✦</text>
        </svg>
      </div>

      <!-- Collage de polaroids con parallax exagerado -->
      <div class="manifesto__collage" data-skew>
        {collage.map((c, i) => (
          <div class={`polaroid-pos polaroid-pos--${i + 1}`} data-parallax={String(c.par)}>
            <figure class={`polaroid polaroid--${i + 1}`} data-img-reveal>
              <Image
                src={c.img}
                alt={`Trabajo de BrandUp para ${c.cap}`}
                widths={[420, 800]}
                sizes="(max-width: 767px) 46vw, 30vw"
                loading="lazy"
              />
              <figcaption class="polaroid__cap">{c.cap}</figcaption>
            </figure>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ SERVICIOS URBANOS — lista con preview flotante ══════════ -->
  <section class="svc-urban">
    <div class="svc-urban__head">
      <div>
        <p class="svc-urban__kicker" data-reveal>— {es ? 'Servicios' : 'Services'}</p>
        <h2 class="svc-urban__title" data-split-chars>{es ? 'Lo que hacemos' : 'What we do'}</h2>
      </div>
      <p class="svc-urban__hint" data-reveal>
        {es ? 'Pasa el mouse — cada servicio tiene su mundo' : 'Hover — every service has its own world'}
      </p>
    </div>

    <div class="svc-urban__list">
      {SERVICES.map((s) => (
        <a
          href={lp(`/servicios/${s.slug}`)}
          class="svc-u"
          data-svc-img={svcImg[s.slug]}
          data-reveal
        >
          <span class="svc-u__num">{s.num}</span>
          <span class="svc-u__title">{pick(s.title, locale)}</span>
          <span class="svc-u__tag">{pick(s.tag, locale)}</span>
          <span class="svc-u__arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M2 14 L14 2 M14 2 H5 M14 2 V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ════ STRIP URBANO — doble marquee de fotos (sin pin) ═════════ -->
  <section class="street">
    <div class="street__head">
      <p class="street__kicker" data-reveal>— {es ? 'Cultura Brand Up' : 'Brand Up culture'}</p>
      <h2 class="street__title" data-reveal data-delay="0.1" aria-label="Santiago, Chile">Stgo ✕ Chile</h2>
    </div>
    <div class="street__rows" data-skew>
      <div class="street-marquee">
        <div class="marquee-track">
          {[0, 1].map((copy) => (
            <div class="street-seq" aria-hidden={copy === 1 ? 'true' : undefined}>
              {streets.map((st, i) => (
                <figure class="street-card">
                  <Image
                    src={st.img}
                    alt={`Trabajo de BrandUp para ${st.chip}`}
                    widths={[420, 800]}
                    sizes="(max-width: 767px) 62vw, 27vw"
                    loading="lazy"
                  />
                  <figcaption class="street-card__chip">0{i + 1} — {st.chip}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="street-marquee street-marquee--rev">
        <div class="marquee-track marquee-track--reverse">
          {[0, 1].map((copy) => (
            <div class="street-seq" aria-hidden={copy === 1 ? 'true' : undefined}>
              {[...streets].reverse().map((st, i) => (
                <figure class="street-card">
                  <Image
                    src={st.img}
                    alt={`Trabajo de BrandUp para ${st.chip}`}
                    widths={[420, 800]}
                    sizes="(max-width: 767px) 62vw, 27vw"
                    loading="lazy"
                  />
                  <figcaption class="street-card__chip">0{6 - i} — {st.chip}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ════ STATS BAND — números gigantes sobre naranja ═════════════ -->
  <section class="stats-band">
    <div class="stats-band__head">
      <p class="stats-band__kicker" data-reveal>— {es ? 'En números' : 'In numbers'}</p>
    </div>
    <div class="stats-band__grid">
      {stats.map((s) => (
        <div class={`stat-u${s.val.length > 4 ? ' stat-u--big' : ''}`} data-reveal>
          <span class="stat-u__val">
            {s.prefix && <span class="stat-u__prefix">{s.prefix}</span>}<span data-counter={s.val} data-suffix={s.suffix}>0</span>
          </span>
          <span class="stat-u__lbl">{s.lbl}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ════ TRABAJOS — intro "Our Works" ════════════════════════════ -->
  <section class="works-intro">
    <div class="works-intro__bg" style={`background-image:url(${imgWorksBg.src})`}></div>
    <div class="works-intro__scrim"></div>
    <div class="works-intro__content">
      <p class="works-intro__kicker">
        {es ? '— Portafolio seleccionado 2025–2026' : '— Selected portfolio 2025–2026'}
      </p>
      <h2 class="works-intro__title">
        <span class="ln">{es ? 'Nuestros' : 'Our'}</span>
        <span class="ln ln--alt">{es ? 'Trabajos' : 'Works'}</span>
      </h2>
      <p class="works-intro__desc">
        {es
          ? 'Marcas reales, resultados medibles. Cada proyecto parte de un objetivo concreto: más ventas, más visibilidad o una identidad que dure. Esto es lo que hemos construido.'
          : 'Real brands, measurable results. Every project starts from a concrete goal: more sales, more visibility or an identity built to last. This is what we\'ve built.'}
      </p>
    </div>
    <div class="works-intro__meta">
      <span class="works-intro__hint">
        {es ? 'Desplázate para ver' : 'Scroll to explore'}
        <svg width="12" height="14" viewBox="0 0 12 14" fill="none" aria-hidden="true">
          <path d="M6 1v12M1 8l5 5 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </section>

  <!-- ════ TRABAJOS — videos full-screen ════════════════════════════ -->
  <div class="works-videos">
    {featured.map((p, i) => (
      <a
        href={lp(`/trabajos/${p.slug}`)}
        class="project-video group"
        data-video-src={`/videos/work${i + 1}.mp4`}
        aria-label={p.client}
      >
        <div class="project-video__inner" style={`background:${p.gradient}`}>
          <div class="project-video__placeholder">
            <span class="project-video__play">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="#f8f8f8" aria-hidden="true">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </span>
            <span class="project-video__soon">{es ? 'Video próximamente' : 'Video coming soon'}</span>
          </div>
        </div>
      </a>
    ))}

    <!-- Cierre: ver todos -->
    <div class="relative z-10 flex justify-center bg-[#0d0d0d] pb-20 pt-16">
      <a href={lp('/trabajos')} class="rounded-full border border-[rgba(248,248,248,0.2)] px-8 py-3.5 text-sm font-medium text-[#f8f8f8] transition-colors hover:border-accent hover:text-accent">
        {worksAllLabel} →
      </a>
    </div>
  </div>

  <!-- ════ TESTIMONIOS ══════════════════════════════════════════════ -->
  <section class="testis rule">
    <div class="testis__inner">
      <p class="testis__kicker" data-reveal>— {es ? 'Testimonios' : 'Testimonials'}</p>
      <h2 class="testis__title" data-split-chars>{t.home.testimonialsTitle}</h2>
      <div data-reveal>
        <TestimonialCarousel client:visible items={testimonials} />
      </div>
    </div>
  </section>

  <!-- ════ CTA FINAL ════════════════════════════════════════════════ -->
  <section class="cta-final">
    <!-- Marquee gigante de fondo -->
    <div class="cta-final__marquee" aria-hidden="true">
      <div class="marquee-track marquee-track--slow">
        {[0, 1].map(() => (
          <span class="cta-final__marquee-item">
            {es ? 'Hablemos — Hablemos — Hablemos — ' : "Let's talk — Let's talk — Let's talk — "}
          </span>
        ))}
      </div>
    </div>
    <div class="cta-final__inner">
      <p class="cta-final__kicker" data-reveal>{t.home.ctaText}</p>
      <h2 class="cta-final__title display-tight" data-split-chars>
        {t.home.ctaTitle}
      </h2>
      <div class="cta-final__actions" data-reveal data-delay="0.3">
        <a href={lp('/cotizar')} data-magnetic="0.35" class="cta-final__btn">
          {es ? 'Empezar ahora' : 'Start now'} →
        </a>
        <a href={lp('/trabajos')} class="cta-final__link">
          {es ? 'Ver nuestros trabajos' : 'See our work'}
        </a>
      </div>
    </div>
  </section>

  <!-- ════ FAQ — respuestas directas (AEO) ═════════════════════════════
       Van visibles Y como FAQPage en JSON-LD: es el formato que Google y
       los asistentes con IA extraen para responder a quien pregunta por
       precios o servicios de agencias en Santiago. -->
  <section class="home-faq">
    <div class="home-faq__inner">
      <p class="home-faq__kicker" data-reveal>FAQ</p>
      <h2 class="home-faq__title" data-reveal>
        {es ? 'Preguntas frecuentes' : 'Frequently asked questions'}
      </h2>
      <div class="home-faq__list">
        {homeFaq.map((f) => (
          <details class="home-faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <a href={lp('/faq')} class="home-faq__more">
        {es ? 'Ver todas las preguntas frecuentes →' : 'See all frequently asked questions →'}
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

</Base>

<style>
.home-faq { background: var(--color-ink); border-top: 1px solid var(--color-line); }
.home-faq__inner { max-width: 900px; margin-inline: auto; padding: 90px 24px 110px; }
@media (min-width: 768px) { .home-faq__inner { padding: 110px 48px 130px; } }
.home-faq__kicker {
  font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--color-accent); margin-bottom: 14px;
}
.home-faq__title {
  font-family: var(--font-display); font-size: clamp(1.9rem, 5vw, 3.2rem);
  font-weight: 600; letter-spacing: -0.03em; color: var(--color-paper); margin-bottom: 34px;
}
.home-faq__item { border-bottom: 1px solid var(--color-line); }
