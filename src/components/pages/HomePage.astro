---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TestimonialCarousel from '../TestimonialCarousel';
import { SERVICES } from '../../data/services';
import { PROJECTS } from '../../data/projects';
import { TESTIMONIALS } from '../../data/testimonials';
import { useT, pick, localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const lp = (p: string) => localePath(locale, p);

const featured = PROJECTS.filter((p) => p.featured).slice(0, 4);
const testimonials = TESTIMONIALS.map((x) => ({
  text: pick(x.text, locale),
  name: x.name,
  role: pick(x.role, locale),
  initials: x.initials,
}));
const workLabel = locale === 'es' ? 'Todos los trabajos' : 'All work';
const servicesLabel = locale === 'es' ? 'Todos los servicios' : 'All services';
const goTo = locale === 'es' ? 'Ir a' : 'Go to';
---

<Base locale={locale} title={t.meta.home.title} description={t.meta.home.desc}>
  <!-- ============ HERO — tipografía gigante estilo TFTL ============ -->
  <section class="relative flex min-h-[100svh] flex-col justify-between px-5 pt-[88px] md:px-8">
    <div class="mx-auto flex w-full max-w-[1400px] items-center justify-between pt-6 text-xs font-medium uppercase tracking-[0.14em] text-gray">
      <span data-reveal>{t.hero.location}</span>
      <span data-reveal data-delay="0.1">©{new Date().getFullYear()}</span>
    </div>

    <div class="mx-auto w-full max-w-[1400px]">
      <h1 class="display-tight font-display text-[17vw] uppercase leading-[0.92] md:text-[12.5vw]">
        <span class="block" data-reveal-word>{t.hero.line1}</span>
        <span class="block pl-[8vw] text-accent" data-reveal-word>{t.hero.line2}</span>
        <span class="block" data-reveal-word>{t.hero.line3}</span>
      </h1>
    </div>

    <div class="mx-auto flex w-full max-w-[1400px] flex-col gap-8 pb-10 md:flex-row md:items-end md:justify-between">
      <p class="max-w-md text-base text-gray md:text-lg" data-reveal data-delay="0.5">{t.hero.subtitle}</p>
      <div class="flex items-center gap-4" data-reveal data-delay="0.6">
        <a href={lp('/cotizar')} class="rounded-full bg-paper px-7 py-3.5 text-sm font-medium text-ink transition-colors hover:bg-accent">{t.hero.cta}</a>
        <a href={lp('/trabajos')} class="rounded-full border border-line px-7 py-3.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent">{t.hero.cta2}</a>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE GIGANTE + bloque de video ============ -->
  <section class="rule overflow-hidden py-16 md:py-24">
    <div class="marquee-track marquee-track--slow items-center" aria-hidden="true">
      {[0, 1].map(() => (
        <span class="display-tight whitespace-nowrap pr-8 font-display text-[11vw] uppercase md:text-[8vw]">
          {t.marquee.words.map((w, i) => (
            <span class={i === 1 ? 'text-accent' : ''}>{w}&nbsp;</span>
          ))}
          —&nbsp;
        </span>
      ))}
    </div>

    <!-- Placeholder de video: reemplazar el div interior por <video> cuando estén los videos por sección -->
    <div class="mx-auto mt-14 max-w-[1400px] px-5 md:px-8" data-reveal>
      <div class="group relative flex aspect-video w-full items-center justify-center overflow-hidden rounded-2xl bg-paper" data-parallax="-6">
        <span class="absolute left-6 top-6 text-xs font-medium uppercase tracking-[0.14em] text-ink/60">BrandUp — Showreel</span>
        <span class="absolute right-6 top-6 text-xs font-medium text-ink/60">00:00</span>
        <span class="flex h-20 w-20 items-center justify-center rounded-full bg-ink/10 backdrop-blur transition-transform duration-500 group-hover:scale-110">
          <svg viewBox="0 0 24 24" class="ml-1 h-7 w-7 fill-ink" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        </span>
        <span class="absolute bottom-6 left-6 text-xs uppercase tracking-[0.14em] text-ink/40">{locale === 'es' ? 'Video próximamente' : 'Video coming soon'}</span>
      </div>
    </div>
  </section>

  <!-- ============ STATEMENT + tags ============ -->
  <section class="rule">
    <div class="mx-auto max-w-[1400px] px-5 py-24 md:px-8 md:py-36">
      <p class="display-tight max-w-5xl font-display text-3xl md:text-5xl" data-reveal-word>{t.statement.text}</p>
      <ul class="mt-12 flex flex-wrap gap-3" data-reveal data-delay="0.2">
        {t.statement.tags.map((tag) => (
          <li class="rounded-full border border-line px-5 py-2.5 text-sm text-gray transition-colors hover:border-accent hover:text-accent">{tag}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ TRABAJOS — grilla 2×2 con tarjetas de color ============ -->
  <section class="rule">
    <div class="mx-auto max-w-[1400px] px-5 py-20 md:px-8 md:py-28">
      <div class="mb-12 flex items-end justify-between">
        <h2 class="display-tight font-display text-4xl uppercase md:text-6xl" data-reveal-word>{t.home.workKicker}</h2>
        <a href={lp('/trabajos')} class="hidden shrink-0 text-sm font-medium underline-offset-4 transition-colors hover:text-accent hover:underline md:block" data-reveal>{workLabel} →</a>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {featured.map((p, i) => (
          <a href={lp(`/trabajos/${p.slug}`)} class={`group block ${i % 2 ? 'md:mt-16' : ''}`} data-reveal data-delay={`${(i % 2) * 0.1}`}>
            <div class="relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-2xl transition-transform duration-500 group-hover:scale-[0.985]" style={`background:${p.gradient}`}>
              {p.logo && (
                <Image src={p.logo} alt={`Logo ${p.client}`} class="max-h-[42%] w-auto max-w-[50%] rounded-xl object-contain mix-blend-multiply transition-transform duration-700 group-hover:scale-105" widths={[320, 480]} />
              )}
              <span class="absolute bottom-5 left-5 rounded-full bg-[#232323]/80 px-4 py-1.5 text-xs text-white backdrop-blur">{pick(p.sector, locale)}</span>
              <span class="absolute bottom-5 right-5 rounded-full bg-[#232323]/80 px-4 py-1.5 text-xs text-white backdrop-blur">{p.year}</span>
            </div>
            <h3 class="mt-4 font-display text-2xl font-semibold tracking-tight transition-colors group-hover:text-accent">{p.client}</h3>
          </a>
        ))}
      </div>
      <a href={lp('/trabajos')} class="mt-10 inline-block text-sm font-medium underline underline-offset-4 transition-colors hover:text-accent md:hidden">{workLabel} →</a>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="rule">
    <div class="mx-auto grid max-w-[1400px] grid-cols-2 gap-y-12 px-5 py-20 md:grid-cols-4 md:px-8 md:py-28">
      {t.stats.items.map((s, i) => (
        <div data-reveal data-delay={`${i * 0.08}`}>
          <span class="display-tight block font-display text-5xl md:text-7xl">{s.val}</span>
          <span class="mt-2 block text-sm text-gray">{s.lbl}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ SERVICIOS — directorio ordenado ============ -->
  <section class="rule">
    <div class="mx-auto max-w-[1400px] px-5 py-20 md:px-8 md:py-28">
      <div class="mb-12 flex items-end justify-between">
        <h2 class="display-tight font-display text-4xl uppercase md:text-6xl" data-reveal-word>{t.nav.services}</h2>
        <a href={lp('/servicios')} class="hidden shrink-0 text-sm font-medium underline-offset-4 transition-colors hover:text-accent hover:underline md:block" data-reveal>{servicesLabel} →</a>
      </div>
      <ol class="rule">
        {SERVICES.map((s) => (
          <li class="border-b border-line">
            <a href={`${lp('/servicios')}#${s.slug}`} class="group grid items-center gap-x-8 gap-y-1 py-8 md:grid-cols-[64px_1fr_1fr_auto]" data-reveal>
              <span class="text-sm text-gray">({s.num})</span>
              <span class="display-tight font-display text-2xl transition-colors group-hover:text-accent md:text-4xl">{pick(s.title, locale)}</span>
              <span class="text-sm text-gray md:max-w-sm">{pick(s.short, locale)}</span>
              <span class="hidden text-sm font-medium text-gray transition-colors group-hover:text-accent md:block">{goTo} →</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ TESTIMONIOS ============ -->
  <section class="rule">
    <div class="mx-auto max-w-[1400px] px-5 py-20 md:px-8 md:py-28">
      <h2 class="display-tight mb-14 font-display text-4xl uppercase md:text-6xl" data-reveal-word>{t.home.testimonialsTitle}</h2>
      <div data-reveal>
        <TestimonialCarousel client:visible items={testimonials} />
      </div>
    </div>
  </section>

  <!-- ============ CTA FINAL grande ============ -->
  <section class="rule">
    <a href={lp('/cotizar')} class="group block">
      <div class="mx-auto max-w-[1400px] px-5 py-24 md:px-8 md:py-36">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-gray" data-reveal>{t.home.ctaText}</p>
        <p class="display-tight mt-4 font-display text-[12vw] uppercase transition-colors group-hover:text-accent md:text-[9vw]" data-reveal-word>
          {t.home.ctaTitle}
        </p>
      </div>
    </a>
  </section>
</Base>
