---
// Landing bespoke para "Duoc UC" (educación superior · contenido).
// Tema feed en movimiento: el hero muestra dos columnas de piezas reales
// desplazándose en sentidos opuestos, como un feed vivo. La info se presenta
// como PUBLICACIONES de un feed (con su barra de interacción) en vez de
// tarjetas, y la métrica como contador de seguidores.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import { PROJECTS, type Project } from '../../data/projects';
import { PROJECT_MEDIA } from '../../data/projectMedia';
import { useT, pick, localePath, type Locale } from '../../i18n';

interface Props { locale: Locale; project: Project; }
const { locale, project: p } = Astro.props;
const t = useT(locale);
const lp = (path: string) => localePath(locale, path);
const isEs = locale === 'es';

const idx = PROJECTS.findIndex((x) => x.slug === p.slug);
const next = PROJECTS[(idx + 1) % PROJECTS.length];
const title = `${p.client} — ${t.meta.work.title}`;
const media = PROJECT_MEDIA[p.slug] ?? [];

// Fotos reales para las columnas del hero (se repiten para el loop).
const shots = media.filter((m) => m.kind === 'photo' && m.src);
const colA = [...shots, ...shots];
const colB = [...shots.slice().reverse(), ...shots.slice().reverse()];

const posts = [
  { h: t.work.challenge, text: pick(p.challenge, locale) },
  { h: t.work.approach,  text: pick(p.approach, locale) },
  { h: t.work.outcome,   text: pick(p.outcome, locale) },
];
---

<Base locale={locale} title={title} description={pick(p.summary, locale)}>
<div class="du" style={`--accent:${p.theme.accent}; --dark:${p.theme.dark}`}>

  <!-- ════ HERO — feed vivo ══════════════════════════════════════════ -->
  <section class="du-hero">
    <div class="du-feed" aria-hidden="true">
      <div class="du-col du-col--up">
        {colA.map((m) => (
          <div class="du-tile">
            {m.src && <Image src={m.src} alt="" widths={[240, 420]} sizes="200px" />}
          </div>
        ))}
      </div>
      <div class="du-col du-col--down">
        {colB.map((m) => (
          <div class="du-tile">
            {m.src && <Image src={m.src} alt="" widths={[240, 420]} sizes="200px" />}
          </div>
        ))}
      </div>
      <div class="du-feed__fade"></div>
    </div>

    <div class="du-hero__inner">
      <a href={lp('/trabajos')} class="du-back"><span aria-hidden="true">&#8592;</span> {t.work.back}</a>
      <p class="du-hero__kicker">{pick(p.sector, locale)}</p>
      <h1 class="du-hero__title">{p.client}</h1>
      <p class="du-hero__tag">{pick(p.summary, locale)}</p>
      <div class="du-hero__meta">
        <span class="du-pill">{p.year}</span>
        {p.link && (
          <a href={p.link} target="_blank" rel="noopener" class="du-pill du-pill--link">
            @duocuc_cl <span aria-hidden="true">&#8599;</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ════ MÉTRICA — contador ════════════════════════════════════════ -->
  {p.metrics.length > 0 && (
    <section class="du-count">
      <div class="du-count__inner">
        {p.metrics.map((m) => (
          <div class="du-count__item" data-reveal>
            <span class="du-count__val">{m.val}</span>
            <span class="du-count__lbl">{pick(m.lbl, locale)}</span>
          </div>
        ))}
        <div class="du-count__tags">
          {pick(p.services, locale).map((s) => (
            <span class="du-servtag">{s}</span>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ════ PUBLICACIONES ═════════════════════════════════════════════ -->
  <section class="du-posts">
    <div class="du-posts__inner">
      {posts.map((c, i) => (
        <article class="du-post" data-reveal data-delay={`${i * 0.08}`}>
          <header class="du-post__head">
            <span class="du-post__avatar" aria-hidden="true">D</span>
            <div>
              <span class="du-post__user">duocuc_cl</span>
              <span class="du-post__meta">{c.h}</span>
            </div>
          </header>
          <p class="du-post__text">{c.text}</p>
          <div class="du-post__bar" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="21" height="21"><path d="M12 21s-8-5.2-8-10.4A4.6 4.6 0 0 1 12 7a4.6 4.6 0 0 1 8 3.6C20 15.8 12 21 12 21z" fill="var(--accent)"/></svg>
            <svg viewBox="0 0 24 24" width="21" height="21"><path d="M21 12a8 8 0 1 1-3.2-6.4L21 4l-1 4.2A7.9 7.9 0 0 1 21 12z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
            <svg viewBox="0 0 24 24" width="21" height="21"><path d="M4 12l16-8-7 16-2-6-7-2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ════ GALERÍA ═══════════════════════════════════════════════════ -->
  {media.length > 0 && (
    <section class="du-gallery">
      <div class="du-gallery__inner">
        <h2 class="du-gallery__title" data-reveal>{isEs ? 'Lo publicado' : 'What we published'}</h2>
        <div class="du-grid">
          {media.map((slot) => (
            <figure class={`du-cell du-cell--${slot.ratio}`} data-reveal>
              {slot.kind === 'photo' && slot.src ? (
                <Image src={slot.src} alt={pick(slot.label, locale)} class="du-cell__img"
                  widths={[400, 800]} sizes="(max-width: 860px) 88vw, 30vw" />
              ) : slot.kind === 'video' && slot.videoSrc ? (
                <div class="du-cell__screen" data-du-video={slot.videoSrc}></div>
              ) : (
                <div class="du-cell__ph"><span>{pick(slot.label, locale)}</span></div>
              )}
              <figcaption class="du-cell__cap">{pick(slot.label, locale)}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="du-next">
    <a href={lp(`/trabajos/${next.slug}`)} class="du-next__link">
      <span>
        <span class="du-next__label">{t.work.next}</span>
        <span class="du-next__client">{next.client}</span>
      </span>
      <span class="du-next__arrow" aria-hidden="true">&#8594;</span>
    </a>
  </section>
</div>

  <CtaBand locale={locale} />
</Base>

<style>
.du { background: var(--dark); color: #faf4e8; }

/* ════ HERO ═══════════════════════════════════════════════════════ */
.du-hero {
  position: relative; min-height: 100svh; overflow: hidden;
  display: flex; align-items: center;
  background: linear-gradient(120deg, #12100c 0%, #241f14 52%, #4a3c17 100%);
}
.du-feed {
  position: absolute; z-index: 0; top: 0; right: 0; bottom: 0;
  width: 46%; display: flex; gap: 16px; padding: 0 24px;
  justify-content: flex-end; overflow: hidden;
}
@media (max-width: 900px) { .du-feed { width: 100%; opacity: 0.2; justify-content: center; } }
.du-col { display: flex; flex-direction: column; gap: 16px; width: 200px; flex-shrink: 0; }
.du-col--up { animation: duUp 34s linear infinite; }
.du-col--down { animation: duDown 34s linear infinite; }
@keyframes duUp   { from { transform: translateY(0); }    to { transform: translateY(-50%); } }
@keyframes duDown { from { transform: translateY(-50%); } to { transform: translateY(0); } }
.du-tile {
  width: 200px; aspect-ratio: 3/4; border-radius: 14px; overflow: hidden;
  background: #26211a; border: 1px solid rgba(250,244,232,0.12); flex-shrink: 0;
}
.du-tile :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
.du-feed__fade {
  position: absolute; inset: 0;
  background: linear-gradient(to right, #171410 0%, rgba(23,20,16,0.7) 26%, transparent 62%),
              linear-gradient(to bottom, #171410 0%, transparent 18%, transparent 82%, #171410 100%);
}

.du-hero__inner {
  position: relative; z-index: 2; max-width: 1180px; width: 100%;
  margin-inline: auto; padding: 130px 24px 90px;
}
@media (min-width: 768px) { .du-hero__inner { padding: 120px 48px 90px; } }
.du-back {
  display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px;
  font-size: 0.85rem; color: rgba(250,244,232,0.7); transition: gap 0.25s, color 0.2s;
}
.du-back:hover { color: #fff; gap: 12px; }
.du-hero__kicker {
  font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
  color: #f5c25c; margin-bottom: 18px;
}
.du-hero__title {
  font-family: var(--font-display); font-size: clamp(3rem, 12vw, 8.5rem);
  font-weight: 700; letter-spacing: -0.05em; line-height: 0.86; color: #fff;
  max-width: 9ch;
  animation: duIn 0.95s cubic-bezier(0.22,1,0.36,1) both;
}
@keyframes duIn { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: none; } }
.du-hero__tag {
  margin-top: 26px; max-width: 34ch; font-size: clamp(1rem, 1.7vw, 1.2rem);
  line-height: 1.6; color: rgba(250,244,232,0.85);
}
.du-hero__meta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
.du-pill {
  display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 700;
  color: #fff; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.24);
  padding: 9px 18px; border-radius: 100px; backdrop-filter: blur(8px);
}
.du-pill--link { transition: background 0.3s; }
.du-pill--link:hover { background: var(--accent); }

/* ════ CONTADOR ═══════════════════════════════════════════════════ */
.du-count { background: var(--accent); color: #fff; }
.du-count__inner {
  max-width: 1180px; margin-inline: auto; padding: 64px 24px;
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px;
}
@media (min-width: 768px) { .du-count__inner { padding: 78px 48px; } }
.du-count__val {
  display: block; font-family: var(--font-display); font-size: clamp(3rem, 9vw, 6rem);
  font-weight: 700; letter-spacing: -0.04em; line-height: 0.9;
}
.du-count__lbl { display: block; margin-top: 10px; font-size: 0.95rem; opacity: 0.9; }
.du-count__tags { display: flex; flex-wrap: wrap; gap: 10px; }
.du-servtag {
  font-size: 0.88rem; font-weight: 700; border: 2px solid rgba(255,255,255,0.6);
  border-radius: 100px; padding: 9px 20px;
}

/* ════ PUBLICACIONES ══════════════════════════════════════════════ */
.du-posts { background: #1d1913; }
.du-posts__inner {
  max-width: 720px; margin-inline: auto; padding: 84px 24px;
  display: grid; gap: 22px;
}
@media (min-width: 768px) { .du-posts__inner { padding: 104px 48px; } }
.du-post {
  border-radius: 16px; padding: 24px;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(250,244,232,0.13);
  transition: border-color 0.3s;
}
.du-post:hover { border-color: var(--accent); }
.du-post__head { display: flex; align-items: center; gap: 13px; margin-bottom: 16px; }
.du-post__avatar {
  width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: var(--accent); color: #fff; font-weight: 800; font-size: 1.1rem;
}
.du-post__user { display: block; font-weight: 700; font-size: 0.95rem; color: #fff; }
.du-post__meta {
  display: block; margin-top: 2px; font-size: 10px; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase; color: #f5c25c;
}
.du-post__text { font-size: 1.02rem; line-height: 1.65; color: rgba(250,244,232,0.85); }
.du-post__bar {
  display: flex; gap: 16px; margin-top: 18px; padding-top: 16px;
  border-top: 1px solid rgba(250,244,232,0.1); color: rgba(250,244,232,0.6);
}

/* ════ GALERÍA ════════════════════════════════════════════════════ */
.du-gallery { background: var(--dark); }
.du-gallery__inner { max-width: 1180px; margin-inline: auto; padding: 90px 24px; }
@media (min-width: 768px) { .du-gallery__inner { padding: 110px 48px; } }
.du-gallery__title {
  font-family: var(--font-display); font-size: clamp(1.9rem, 5vw, 3.2rem);
  font-weight: 700; letter-spacing: -0.03em; color: #fff; margin-bottom: 42px;
}
.du-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
.du-cell { margin: 0; }
.du-cell__img, .du-cell__screen, .du-cell__ph {
  width: 100%; display: block; border-radius: 14px; overflow: hidden;
  border: 1px solid rgba(250,244,232,0.12); background: #26211a;
}
.du-cell--tall .du-cell__img, .du-cell--tall .du-cell__ph { aspect-ratio: 3/4; object-fit: cover; }
.du-cell--reel .du-cell__screen, .du-cell--reel .du-cell__ph { aspect-ratio: 9/16; }
.du-cell--wide .du-cell__img, .du-cell--wide .du-cell__screen { aspect-ratio: 16/9; object-fit: cover; }
.du-cell__screen :global(video) { width: 100%; height: 100%; object-fit: cover; display: block; }
.du-cell__ph {
  display: flex; align-items: center; justify-content: center; padding: 20px; text-align: center;
  color: rgba(250,244,232,0.45); font-size: 0.86rem; min-height: 200px;
  background: repeating-linear-gradient(45deg, #26211a 0 12px, #2e2820 12px 24px);
}
.du-cell__cap { margin-top: 11px; font-size: 0.84rem; color: rgba(250,244,232,0.6); }

/* ════ NEXT ═══════════════════════════════════════════════════════ */
.du-next { background: #1d1913; border-top: 1px solid rgba(250,244,232,0.12); }
.du-next__link {
  max-width: 1180px; margin-inline: auto; display: flex; align-items: center;
  justify-content: space-between; gap: 24px; padding: 64px 24px;
}
@media (min-width: 768px) { .du-next__link { padding-inline: 48px; } }
.du-next__label { font-size: 0.85rem; color: rgba(250,244,232,0.55); }
.du-next__client {
  display: block; margin-top: 8px; font-family: var(--font-display);
  font-size: clamp(2rem, 5.5vw, 3.4rem); font-weight: 700; letter-spacing: -0.035em;
  color: #fff; transition: color 0.3s;
}
.du-next__link:hover .du-next__client { color: #f5c25c; }
.du-next__arrow { font-size: 2.2rem; color: rgba(250,244,232,0.5); transition: transform 0.3s, color 0.3s; }
.du-next__link:hover .du-next__arrow { transform: translateX(10px); color: #f5c25c; }

@media (prefers-reduced-motion: reduce) {
  .du-col, .du-hero__title { animation: none !important; }
  .du-hero__title { opacity: 1; transform: none; }
}
</style>

<script>
  function initDuVideos() {
    const items = document.querySelectorAll<HTMLElement>('[data-du-video]');
    if (!items.length) return;
    const mount = (el: HTMLElement) => {
      if (el.querySelector('video')) return;
      const src = el.dataset.duVideo; if (!src) return;
      const v = document.createElement('video');
      v.src = src; v.muted = true; v.loop = true; v.playsInline = true;
      v.setAttribute('playsinline', ''); v.preload = 'auto';
      el.appendChild(v); v.play().catch(() => {});
    };
    const unmount = (el: HTMLElement) => {
      const v = el.querySelector('video'); if (!v) return;
      v.pause(); v.removeAttribute('src'); v.load(); v.remove();
    };
    const io = new IntersectionObserver((es) => {
      for (const e of es) { const el = e.target as HTMLElement; if (e.isIntersecting) mount(el); else unmount(el); }
    }, { rootMargin: '250px 0px' });
    items.forEach((el) => io.observe(el));
  }
  initDuVideos();
  document.addEventListener('astro:page-load', initDuVideos);
</script>
