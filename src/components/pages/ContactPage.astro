---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import ContactForm from '../ContactForm';
import { SITE, wa } from '../../data/site';
import { useT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  variant?: 'contact' | 'quote';
}
const { locale, variant = 'contact' } = Astro.props;
const t = useT(locale);
const isQuote = variant === 'quote';
const page = isQuote ? t.quote : t.contact;
const meta = isQuote ? t.meta.quote : t.meta.contact;
const waMsg = locale === 'es' ? 'Hola BrandUp, quiero cotizar un proyecto' : 'Hi BrandUp, I want a project quote';
---

<Base locale={locale} title={meta.title} description={meta.desc}>

  <PageHero kicker={page.kicker} title={page.title} intro={page.intro} />

  <section class="contact-grid">
    <!-- Columna izquierda: pasos + contacto directo -->
    <div class="contact-aside" data-reveal>
      {isQuote && 'steps' in page && (
        <ol class="contact-steps">
          {(page as typeof t.quote).steps.map((s, i) => (
            <li class="contact-step">
              <span class="contact-step__num">{i + 1}</span>
              <span>{s}</span>
            </li>
          ))}
        </ol>
      )}

      <a href={wa(waMsg)} target="_blank" rel="noopener" class="contact-wa">
        <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M17.5 14.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.91-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.1 4.49.71.3 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35M12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.43-9.88 9.9-9.88a9.82 9.82 0 0 1 6.98 2.9 9.82 9.82 0 0 1 2.9 7 9.9 9.9 0 0 1-9.9 9.87m8.42-18.3A11.8 11.8 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.48-8.4"/></svg>
        {t.contact.whatsapp}
      </a>

      <div class="contact-info">
        <p class="contact-info__label">{t.contact.info}</p>
        <p>{SITE.city}</p>
        <p><a href={`mailto:${SITE.email}`} class="contact-info__link">{SITE.email}</a></p>
        <p>{SITE.phone}</p>
      </div>
    </div>

    <!-- Columna derecha: formulario -->
    <div class="contact-form-card" data-reveal data-delay="0.15">
      <!-- Flecha del logo (B↑) flotando en la esquina -->
      <svg class="contact-form-card__arrow" viewBox="0 0 32 46" fill="none" aria-hidden="true">
        <path class="cfa-stem" d="M16 42 V10" stroke="#f05e23" stroke-width="6" stroke-linecap="round" />
        <path class="cfa-head" d="M4 20 16 8 28 20" stroke="#f05e23" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <h2 class="contact-form-card__title">
        {locale === 'es' ? 'Cuéntanos tu proyecto' : 'Tell us about your project'}
      </h2>
      <p class="contact-form-card__hint">
        {locale === 'es'
          ? 'Completa el mini formulario y te llega directo a nuestro WhatsApp.'
          : 'Fill in the mini form and it lands straight in our WhatsApp.'}
      </p>
      <ContactForm client:load labels={t.form} variant={isQuote ? 'quote' : 'contact'} />
    </div>
  </section>
</Base>

<style>
.contact-grid {
  max-width: 1400px;
  margin-inline: auto;
  padding: 80px 24px 104px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
}
@media (min-width: 768px) { .contact-grid { padding: 96px 48px 120px; } }
@media (min-width: 1024px) {
  .contact-grid { grid-template-columns: 1fr 1.15fr; gap: 72px; }
}

.contact-steps {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-bottom: 40px;
}
.contact-step {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  font-size: 1rem;
  line-height: 1.4;
  color: var(--color-paper);
}
.contact-step__num {
  flex-shrink: 0;
  width: 30px; height: 30px;
  border-radius: 50%;
  background: rgba(240,94,35,0.12);
  color: var(--color-accent);
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}

.contact-wa {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: #25D366;
  color: #07301c;
  font-weight: 700;
  font-size: 0.95rem;
  padding: 15px 28px;
  border-radius: 100px;
  transition: transform 0.25s, box-shadow 0.25s;
}
.contact-wa:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(37,211,102,0.3); }

.contact-info {
  margin-top: 40px;
  font-size: 0.95rem;
  line-height: 1.8;
  color: var(--color-gray);
}
.contact-info__label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-paper);
  margin-bottom: 10px;
}
.contact-info__link { transition: color 0.2s; }
.contact-info__link:hover { color: var(--color-accent); }

.contact-form-card {
  position: relative;
  align-self: start;
  border: 1px solid var(--color-line);
  border-radius: 24px;
  background: #f0ede8;
  padding: 32px;
  box-shadow: 0 28px 80px rgba(35, 35, 35, 0.08);
}
/* Flecha del logo flotando — despega en loop suave */
.contact-form-card__arrow {
  position: absolute;
  top: -26px;
  right: 30px;
  width: 46px;
  height: auto;
  filter: drop-shadow(0 10px 22px rgba(240, 94, 35, 0.4));
  animation: cfaFloat 2.6s ease-in-out infinite;
}
@keyframes cfaFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50%      { transform: translateY(-12px) rotate(4deg); }
}
@media (prefers-reduced-motion: reduce) {
  .contact-form-card__arrow { animation: none; }
}
@media (min-width: 768px) { .contact-form-card { padding: 44px; } }
.contact-form-card__title {
  font-family: var(--font-display);
  font-size: clamp(1.35rem, 2.6vw, 1.8rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.15;
  color: var(--color-paper);
  margin-bottom: 8px;
}
.contact-form-card__hint {
  margin-bottom: 30px;
  font-size: 0.9rem;
  color: var(--color-gray);
}
</style>
