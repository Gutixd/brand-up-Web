---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import { PROJECTS, type Project } from '../../data/projects';
import { PROJECT_MEDIA } from '../../data/projectMedia';
import { useT, pick, localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project: p } = Astro.props;
const t = useT(locale);
const lp = (path: string) => localePath(locale, path);
const isEs = locale === 'es';

const idx = PROJECTS.findIndex((x) => x.slug === p.slug);
const next = PROJECTS[(idx + 1) % PROJECTS.length];
const title = `${p.client} — ${t.meta.work.title}`;
const media = PROJECT_MEDIA[p.slug] ?? [];

const chapters = [
  { n: '01', h: t.work.challenge, text: pick(p.challenge, locale) },
  { n: '02', h: t.work.approach, text: pick(p.approach, locale) },
  { n: '03', h: t.work.outcome, text: pick(p.outcome, locale) },
];
---

<Base locale={locale} title={title} description={pick(p.summary, locale)}>

  <!-- ════ HERO editorial ═══════════════════════════════════════════ -->
  <section class="wd-hero" style={`background:${p.gradient}`}>
    {p.cover && (
      <Image
        src={p.cover}
        alt={p.client}
        class="wd-hero__bg"
        widths={[800, 1400, 1920]}
        sizes="100vw"
      />
    )}
    <div class="wd-hero__scrim"></div>
    {!p.cover && p.logo && (
      <div class="wd-hero__logo" data-parallax="-12">
        <Image src={p.logo} alt={`Logo ${p.client}`} class="max-h-[28%] w-auto max-w-[38%] rounded-xl object-contain opacity-90" widths={[320, 480]} />
      </div>
    )}

    <div class="wd-hero__inner">
      <a href={lp('/trabajos')} class="wd-hero__back">
        <span aria-hidden="true">&#8592;</span> {t.work.back}
      </a>
      <p class="wd-hero__kicker">{pick(p.sector, locale)}</p>
      <h1 class="wd-hero__title" data-reveal-word>{p.client}</h1>
      <div class="wd-hero__meta">
        <span class="wd-hero__pill">{p.year}</span>
        <span class="wd-hero__pill">
          {pick(p.services, locale).length} {isEs ? 'servicios' : 'services'}
        </span>
        {p.link && (
          <a href={p.link} target="_blank" rel="noopener" class="wd-hero__pill wd-hero__pill--link">
            {isEs ? 'Ver sitio' : 'Visit site'} <span aria-hidden="true">&#8599;</span>
          </a>
        )}
      </div>
    </div>

    <div class="wd-hero__scroll" aria-hidden="true">
      <span class="wd-hero__scroll-line"></span>
    </div>
  </section>

  <!-- ════ OVERVIEW — hook ═════════════════════════════════════════ -->
  <section class="wd-overview">
    <div class="wd-overview__inner">
      <p class="wd-overview__kicker" data-reveal>{isEs ? 'El proyecto' : 'The project'}</p>
      <p class="wd-overview__lead" data-reveal data-delay="0.05">{pick(p.summary, locale)}</p>
      <ul class="wd-facts" data-reveal data-delay="0.1">
        {pick(p.services, locale).map((s) => (
          <li class="wd-facts__tag">{s}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ════ STORYTELLING — desafío / solución / resultado ═══════════ -->
  <section class="wd-story">
    <div class="wd-story__inner">
      {chapters.map((c) => (
        <article class="wd-chapter" data-reveal>
          <div class="wd-chapter__side">
            <span class="wd-chapter__num">{c.n}</span>
            <span class="wd-chapter__h">{c.h}</span>
          </div>
          <p class="wd-chapter__text">{c.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ════ MÉTRICAS — banda ════════════════════════════════════════ -->
  {p.metrics.length > 0 && (
    <section class="wd-metrics">
      <div class="wd-metrics__inner">
        <p class="wd-metrics__kicker" data-reveal>{isEs ? 'Resultados' : 'Results'}</p>
        <div class="wd-metrics__grid">
          {p.metrics.map((m, i) => (
            <div class="wd-metric" data-reveal data-delay={`${i * 0.08}`}>
              <span class="wd-metric__val">{m.val}</span>
              <span class="wd-metric__lbl">{pick(m.lbl, locale)}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ════ GALERÍA — fotos / videos ════════════════════════════════ -->
  {media.length > 0 && (
    <section class="wd-gallery">
      <div class="wd-gallery__inner">
        <div class="wd-gallery__head" data-reveal>
          <p class="wd-gallery__kicker">{isEs ? 'Galería' : 'Gallery'}</p>
          <h2 class="wd-gallery__title display-tight">
            {isEs ? 'El trabajo, en detalle' : 'The work, in detail'}
          </h2>
        </div>

        <div class="wgal">
          {media.map((slot, i) => (
            <figure class={`wgal__item wgal__item--${slot.ratio}`} data-reveal data-delay={`${(i % 2) * 0.08}`}>
              {slot.kind === 'photo' && slot.src ? (
                <div class="wgal__media">
                  <Image src={slot.src} alt={pick(slot.label, locale)} class="wgal__img"
                    widths={[480, 900, 1400]} sizes="(max-width: 860px) 92vw, 46vw" />
                </div>
              ) : slot.kind === 'video' && slot.videoSrc ? (
                <div class="wgal__media">
                  <video class="wgal__video" src={slot.videoSrc} muted loop playsinline autoplay preload="metadata" />
                </div>
              ) : (
                <div class="wgal__ph">
                  <span class="wgal__ph-icon" aria-hidden="true">
                    {slot.kind === 'video' ? (
                      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    ) : (
                      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                    )}
                  </span>
                  <span class="wgal__ph-kind">{slot.kind === 'video' ? 'Video' : (isEs ? 'Foto' : 'Photo')}</span>
                  <span class="wgal__ph-label">{pick(slot.label, locale)}</span>
                </div>
              )}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ════ Siguiente proyecto ══════════════════════════════════════ -->
  <section class="wd-next">
    <a href={lp(`/trabajos/${next.slug}`)} class="wd-next__link group">
      <span>
        <span class="wd-next__label">{t.work.next}</span>
        <span class="wd-next__client">{next.client}</span>
      </span>
      <span class="wd-next__arrow" aria-hidden="true">&#8594;</span>
    </a>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
/* ════ HERO ═══════════════════════════════════════════════════════ */
.wd-hero {
  position: relative;
  display: flex;
  align-items: flex-end;
  min-height: 78svh;
  overflow: hidden;
}
.wd-hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  z-index: 0;
  transform: scale(1.05);
  animation: wdHeroZoom 14s ease-out forwards;
}
@keyframes wdHeroZoom { to { transform: scale(1); } }
.wd-hero__scrim {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(to top, #0a0a0a 2%, rgba(10,10,10,0.55) 42%, rgba(10,10,10,0.12) 100%);
}
.wd-hero__logo {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.wd-hero__inner {
  position: relative;
  z-index: 2;
  max-width: 1280px;
  width: 100%;
  margin-inline: auto;
  padding: 180px 24px 64px;
  color: #f8f8f8;
}
@media (min-width: 768px) { .wd-hero__inner { padding: 200px 48px 72px; } }
.wd-hero__back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 28px;
  font-size: 0.85rem;
  color: rgba(248,248,248,0.65);
  transition: gap 0.25s, color 0.2s;
}
.wd-hero__back:hover { color: #fff; gap: 12px; }
.wd-hero__kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 16px;
}
.wd-hero__title {
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 9vw, 7rem);
  font-weight: 700;
  letter-spacing: -0.045em;
  line-height: 0.9;
}
.wd-hero__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 26px;
}
.wd-hero__pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: #f8f8f8;
  background: rgba(248,248,248,0.1);
  border: 1px solid rgba(248,248,248,0.16);
  backdrop-filter: blur(8px);
  padding: 8px 16px;
  border-radius: 100px;
}
.wd-hero__pill--link { transition: background 0.3s, border-color 0.3s; }
.wd-hero__pill--link:hover { background: var(--color-accent); border-color: var(--color-accent); }
.wd-hero__scroll {
  position: absolute;
  z-index: 2;
  bottom: 26px;
  right: 32px;
  width: 1px;
  height: 52px;
  background: rgba(248,248,248,0.2);
  overflow: hidden;
}
.wd-hero__scroll-line {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 40%;
  background: var(--color-accent);
  animation: wdScroll 1.9s cubic-bezier(0.76,0,0.24,1) infinite;
}
@keyframes wdScroll { 0% { transform: translateY(-110%); } 100% { transform: translateY(260%); } }
@media (max-width: 640px) { .wd-hero__scroll { display: none; } }

/* ════ OVERVIEW ═══════════════════════════════════════════════════ */
.wd-overview {
  border-bottom: 1px solid var(--color-line);
}
.wd-overview__inner {
  max-width: 1280px;
  margin-inline: auto;
  padding: 80px 24px;
}
@media (min-width: 768px) { .wd-overview__inner { padding: 110px 48px; } }
.wd-overview__kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 28px;
}
.wd-overview__lead {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 3.6vw, 2.9rem);
  font-weight: 600;
  letter-spacing: -0.025em;
  line-height: 1.18;
  color: var(--color-paper);
  max-width: 22ch;
}
.wd-overview__lead { max-width: 28ch; }
.wd-facts {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 40px;
}
.wd-facts__tag {
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--color-paper);
  border: 1px solid var(--color-line);
  border-radius: 100px;
  padding: 8px 16px;
}

/* ════ STORYTELLING ═══════════════════════════════════════════════ */
.wd-story {
  background: #0e0e0e;
  color: #f8f8f8;
}
.wd-story__inner {
  max-width: 1280px;
  margin-inline: auto;
  padding: 40px 24px;
}
@media (min-width: 768px) { .wd-story__inner { padding: 64px 48px; } }
.wd-chapter {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18px;
  padding: 48px 0;
  border-bottom: 1px solid rgba(248,248,248,0.08);
}
.wd-chapter:last-child { border-bottom: none; }
@media (min-width: 860px) {
  .wd-chapter { grid-template-columns: 0.42fr 0.58fr; gap: 48px; padding: 64px 0; }
}
.wd-chapter__side {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.wd-chapter__num {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 5vw, 3.6rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1;
  color: var(--color-accent);
}
.wd-chapter__h {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(248,248,248,0.55);
}
.wd-chapter__text {
  font-size: clamp(1.05rem, 1.8vw, 1.4rem);
  line-height: 1.62;
  color: rgba(248,248,248,0.82);
  max-width: 56ch;
  align-self: center;
}

/* ════ MÉTRICAS ═══════════════════════════════════════════════════ */
.wd-metrics {
  background: var(--color-accent);
  color: #fff;
}
.wd-metrics__inner {
  max-width: 1280px;
  margin-inline: auto;
  padding: 72px 24px;
}
@media (min-width: 768px) { .wd-metrics__inner { padding: 96px 48px; } }
.wd-metrics__kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.7);
  margin-bottom: 40px;
}
.wd-metrics__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 40px 32px;
}
.wd-metric {
  border-top: 2px solid rgba(255,255,255,0.3);
  padding-top: 20px;
}
.wd-metric__val {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 6vw, 4.6rem);
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 0.95;
  color: #fff;
}
.wd-metric__lbl {
  display: block;
  margin-top: 12px;
  font-size: 0.95rem;
  color: rgba(255,255,255,0.85);
}

/* ════ GALERÍA ════════════════════════════════════════════════════ */
.wd-gallery__inner {
  max-width: 1280px;
  margin-inline: auto;
  padding: 88px 24px;
}
@media (min-width: 768px) { .wd-gallery__inner { padding: 112px 48px; } }
.wd-gallery__head { margin-bottom: 44px; }
.wd-gallery__kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 16px;
}
.wd-gallery__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 5vw, 3.6rem);
  font-weight: 600;
  letter-spacing: -0.035em;
  line-height: 1;
  color: var(--color-paper);
}

.wgal {
  columns: 1;
  column-gap: 18px;
}
@media (min-width: 720px) { .wgal { columns: 2; } }
.wgal__item {
  break-inside: avoid;
  margin-bottom: 18px;
  border-radius: 16px;
  overflow: hidden;
  background: #161616;
}
.wgal__item--wide { aspect-ratio: 16 / 9; }
.wgal__item--tall { aspect-ratio: 3 / 4; }
.wgal__item--reel { aspect-ratio: 9 / 16; }
.wgal__item--square { aspect-ratio: 1 / 1; }

.wgal__media { width: 100%; height: 100%; }
.wgal__img, .wgal__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
}
.wgal__item:hover .wgal__img,
.wgal__item:hover .wgal__video { transform: scale(1.045); }

.wgal__ph {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 24px;
  text-align: center;
  background:
    radial-gradient(ellipse 80% 60% at 50% 0%, rgba(240,94,35,0.1) 0%, transparent 60%),
    repeating-linear-gradient(45deg, #161616 0 12px, #181818 12px 24px);
  border: 1px solid rgba(248,248,248,0.08);
  color: rgba(248,248,248,0.5);
  transition: color 0.3s, border-color 0.3s;
}
.wgal__item:hover .wgal__ph { color: rgba(248,248,248,0.85); border-color: rgba(240,94,35,0.4); }
.wgal__ph-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  border: 1px solid rgba(248,248,248,0.18);
  color: var(--color-accent);
  margin-bottom: 4px;
}
.wgal__ph-kind {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-accent);
}
.wgal__ph-label {
  font-size: 0.95rem;
  font-weight: 500;
  color: rgba(248,248,248,0.7);
  max-width: 24ch;
}

/* ════ NEXT ═══════════════════════════════════════════════════════ */
.wd-next { border-top: 1px solid var(--color-line); }
.wd-next__link {
  max-width: 1280px;
  margin-inline: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 64px 24px;
}
@media (min-width: 768px) { .wd-next__link { padding-inline: 48px; } }
.wd-next__label {
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  color: var(--color-gray);
}
.wd-next__client {
  display: block;
  margin-top: 8px;
  font-family: var(--font-display);
  font-size: clamp(2rem, 5.5vw, 3.4rem);
  font-weight: 600;
  letter-spacing: -0.035em;
  color: var(--color-paper);
  transition: color 0.3s;
}
.wd-next__link:hover .wd-next__client { color: var(--color-accent); }
.wd-next__arrow {
  font-size: 2.2rem;
  color: var(--color-gray);
  transition: transform 0.3s, color 0.3s;
}
.wd-next__link:hover .wd-next__arrow { transform: translateX(10px); color: var(--color-accent); }

@media (prefers-reduced-motion: reduce) {
  .wd-hero__bg, .wd-hero__scroll-line { animation: none; }
}
</style>
