---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import { PROJECTS, type Project } from '../../data/projects';
import { useT, pick, localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project: p } = Astro.props;
const t = useT(locale);
const lp = (path: string) => localePath(locale, path);

const idx = PROJECTS.findIndex((x) => x.slug === p.slug);
const next = PROJECTS[(idx + 1) % PROJECTS.length];
const title = `${p.client} — ${t.meta.work.title}`;
---

<Base locale={locale} title={title} description={pick(p.summary, locale)}>
  <!-- Cover -->
  <section class="relative flex min-h-[60svh] items-end overflow-hidden" style={`background:${p.gradient}`}>
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/30 to-transparent"></div>
    {p.logo && (
      <div class="absolute inset-0 flex items-center justify-center" data-parallax="-12">
        <Image src={p.logo} alt={`Logo ${p.client}`} class="max-h-[30%] w-auto max-w-[40%] rounded-xl object-contain opacity-90" widths={[320, 480]} />
      </div>
    )}
    <div class="relative mx-auto w-full max-w-7xl px-5 pb-14 pt-48 md:px-8">
      <a href={lp('/trabajos')} class="mb-6 inline-block text-sm text-gray transition-colors hover:text-accent">← {t.work.back}</a>
      <h1 class="font-display text-5xl font-extrabold tracking-tight md:text-7xl" data-reveal-word>{p.client}</h1>
      <p class="mt-4 text-gray">{pick(p.sector, locale)} · {p.year}</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-14 px-5 py-20 md:px-8 lg:grid-cols-[2fr_1fr]">
    <div class="space-y-12">
      <p class="font-display text-2xl font-semibold leading-relaxed text-paper/95" data-reveal>{pick(p.summary, locale)}</p>
      {[
        { h: t.work.challenge, text: pick(p.challenge, locale) },
        { h: t.work.approach, text: pick(p.approach, locale) },
        { h: t.work.outcome, text: pick(p.outcome, locale) },
      ].map((b) => (
        <div data-reveal>
          <h2 class="mb-3 font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">{b.h}</h2>
          <p class="leading-relaxed text-gray">{b.text}</p>
        </div>
      ))}
    </div>

    <aside class="space-y-8 self-start rounded-2xl border border-line bg-ink-2/60 p-7" data-reveal data-delay="0.15">
      <div>
        <h2 class="mb-3 font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">{t.work.servicesLabel}</h2>
        <ul class="flex flex-wrap gap-2">
          {pick(p.services, locale).map((s) => (
            <li class="rounded-full border border-line px-3 py-1.5 text-xs text-paper/90">{s}</li>
          ))}
        </ul>
      </div>
      <div class="space-y-5">
        {p.metrics.map((m) => (
          <div class="border-t border-line pt-4">
            <span class="font-display text-3xl font-extrabold text-accent">{m.val}</span>
            <span class="block text-sm text-gray">{pick(m.lbl, locale)}</span>
          </div>
        ))}
      </div>
      {p.link && (
        <a href={p.link} target="_blank" rel="noopener" class="inline-block rounded-full border border-accent px-5 py-2.5 text-sm font-semibold text-accent transition-colors hover:bg-accent hover:text-ink">
          {t.work.visit} ↗
        </a>
      )}
    </aside>
  </section>

  <section class="border-t border-line">
    <a href={lp(`/trabajos/${next.slug}`)} class="group mx-auto flex max-w-7xl items-center justify-between px-5 py-14 md:px-8">
      <span>
        <span class="text-sm text-gray">{t.work.next}</span>
        <span class="mt-1 block font-display text-3xl font-extrabold transition-colors group-hover:text-accent md:text-4xl">{next.client}</span>
      </span>
      <span class="text-3xl text-gray transition-all group-hover:translate-x-2 group-hover:text-accent" aria-hidden="true">→</span>
    </a>
  </section>

  <CtaBand locale={locale} />
</Base>
