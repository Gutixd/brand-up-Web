---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import { SERVICES } from '../../data/services';
import { PROJECTS } from '../../data/projects';
import { useT, pick, localePath, type Locale } from '../../i18n';

import logoChacha from '../../assets/logos/chachapollo.webp';
import logoJdcargo from '../../assets/logos/jdcargo.webp';
import logoAracnida from '../../assets/logos/aracnida.webp';
import logoTemplo from '../../assets/logos/templo-maipu.webp';
import logoBell from '../../assets/logos/bell-college.webp';
import logoSuperlunch from '../../assets/logos/superlunch.webp';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const lp = (p: string) => localePath(locale, p);
const isEs = locale === 'es';

const total = PROJECTS.length;

// Mismo mapeo que la home: los proyectos "featured" (en orden del array)
// corresponden 1:1 a los videos work1.mp4…work5.mp4
const featuredSlugs = PROJECTS.filter((p) => p.featured).map((p) => p.slug);
const VIDEO_MAP = new Map(featuredSlugs.map((slug, i) => [slug, `/videos/work${i + 1}.mp4`]));

const svcName = (slug: string) => {
  const s = SERVICES.find((x) => x.slug === slug);
  return s ? pick(s.title, locale) : slug;
};

// Cada proyecto con todo lo que la tarjeta necesita, ya resuelto
const items = PROJECTS.map((p) => ({
  slug: p.slug,
  client: p.client,
  cover: p.cover,
  gradient: p.gradient,
  logo: p.logo,
  video: VIDEO_MAP.get(p.slug) ?? null,
  summary: pick(p.summary, locale),
  serviceSlugs: p.serviceSlugs,
  serviceNames: p.serviceSlugs.map(svcName),
  metric: p.metrics[0],
  href: lp(`/trabajos/${p.slug}`),
}));

// Filtros: "Todos" + un tab por servicio que tenga al menos un caso
const filters = [
  { slug: 'all', label: isEs ? 'Todos' : 'All', count: total },
  ...SERVICES.map((s) => ({
    slug: s.slug,
    label: pick(s.title, locale),
    count: PROJECTS.filter((p) => p.serviceSlugs.includes(s.slug)).length,
  })).filter((f) => f.count > 0),
];

const clientLogos = [
  { img: logoChacha, name: 'El Chacha Pollo' },
  { img: logoJdcargo, name: 'JD Cargo Logistics' },
  { img: logoAracnida, name: 'Aracnida Store' },
  { img: logoTemplo, name: 'Templo Votivo de Maipú' },
  { img: logoBell, name: 'Bell College' },
  { img: logoSuperlunch, name: 'Superlunch' },
];

const metas = [
  { val: `${total}`, lbl: isEs ? 'Proyectos' : 'Projects' },
  { val: '7', lbl: isEs ? 'Áreas de servicio' : 'Service areas' },
  { val: '+1M', lbl: isEs ? 'Views generadas' : 'Views generated' },
];
---

<Base locale={locale} title={t.meta.work.title} description={t.meta.work.desc}>

  <div class="works-page">

    <!-- Header editorial -->
    <header class="works-page__header">
      <div class="works-page__header-inner">
        <span class="works-page__kicker" data-reveal>
          {isEs ? `Portafolio — ${total} proyectos realizados` : `Portfolio — ${total} completed projects`}
        </span>
        <h1 class="works-page__title display-tight" data-reveal-word>
          {isEs ? 'Nuestro Trabajo' : 'Our Work'}
        </h1>
        <p class="works-page__sub" data-reveal data-delay="0.1">
          {isEs
            ? 'Filtra por servicio o revisa cada proyecto tal cual es: pasa el mouse para ver el trabajo en movimiento.'
            : 'Filter by service or browse every project as it really is: hover to see the work in motion.'}
        </p>

        <!-- Métricas rápidas -->
        <div class="works-page__metas" data-reveal data-delay="0.18">
          {metas.map((m) => (
            <span class="works-page__meta">
              <strong>{m.val}</strong> {m.lbl}
            </span>
          ))}
        </div>
      </div>
    </header>

    <!-- Cinta de logos de clientes -->
    <div class="works-logos" aria-label={isEs ? 'Marcas con las que trabajamos' : 'Brands we work with'}>
      <div class="marquee-track marquee-track--slow">
        {[0, 1].map((copy) => (
          <div class="works-logos__seq" aria-hidden={copy === 1 ? 'true' : undefined}>
            {[...clientLogos, ...clientLogos].map((l, i) => (
              <span class="works-logos__item">
                <Image src={l.img} alt={copy === 0 && i < clientLogos.length ? l.name : ''} widths={[200]} sizes="140px" />
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- Tabs de filtro por servicio -->
    <div class="works-filters-wrap">
      <div class="works-filters" role="tablist" aria-label={isEs ? 'Filtrar por servicio' : 'Filter by service'} data-reveal>
        {filters.map((f, i) => (
          <button
            type="button"
            class="wfilter"
            data-filter={f.slug}
            role="tab"
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {f.label} <span class="wfilter__count">{f.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Grid de proyectos reales — número editorial gigante + tarjeta con
         tilt 3D magnético + video real en hover -->
    <main class="works-grid" id="works-grid">
      {items.map((p, i) => (
        <div class={`wcard-slot${i % 2 === 1 ? ' wcard-slot--offset' : ''}`} data-project-slot>
          <span class="wcard-ghost" aria-hidden="true">0{i + 1}</span>

          <a
            href={p.href}
            class="wcard"
            data-work-item
            data-tilt-card
            data-project-card
            data-filters={p.serviceSlugs.join(' ')}
          >
            <div class="wcard__glare" aria-hidden="true"></div>
            <div class="wcard__tilt" data-tilt-target>

              <div class="wcard__media" data-media data-video-src={p.video ?? undefined}>
                {p.cover ? (
                  <Image
                    src={p.cover}
                    alt={p.client}
                    class="wcard__img"
                    widths={[480, 800, 1400]}
                    sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 640px"
                  />
                ) : (
                  <div class="wcard__fallback" style={`background:${p.gradient}`}>
                    {p.logo && (
                      <Image src={p.logo} alt={p.client} class="wcard__fallback-logo" widths={[220]} sizes="180px" />
                    )}
                  </div>
                )}
                <span class="wcard__overlay" aria-hidden="true"></span>

                <!-- CTA centrado que aparece sobre el video/foto al hover -->
                <span class="pcard__cta" aria-hidden="true">
                  {isEs ? 'Ver caso' : 'View case'}
                  <svg viewBox="0 0 16 16" fill="none" width="14" height="14">
                    <path d="M2 14 L14 2 M14 2 H5 M14 2 V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>

              <div class="pcard__info">
                <div class="pcard__top">
                  <h2 class="pcard__client">{p.client}</h2>
                  {p.metric && (
                    <span class="pcard__metric">
                      {p.metric.val}
                      <small>{pick(p.metric.lbl, locale)}</small>
                    </span>
                  )}
                </div>
                <p class="pcard__summary">{p.summary}</p>
                <div class="pcard__bottom">
                  <p class="pcard__services">{p.serviceNames.join(' · ')}</p>
                  <span class="wcard__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 28" fill="none" class="wcard__arrow-up">
                      <path d="M12 24 V4" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                      <path d="M4 11 12 3 20 11" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                    </svg>
                    <svg viewBox="0 0 24 28" fill="none" class="wcard__arrow-up wcard__arrow-up--ghost">
                      <path d="M12 24 V4" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                      <path d="M4 11 12 3 20 11" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                    </svg>
                  </span>
                </div>
              </div>

            </div>
          </a>
        </div>
      ))}
    </main>

  </div>

  <CtaBand locale={locale} />

</Base>

<style>
.works-page {
  background: #0a0a0a;
  color: #f8f8f8;
}

/* ── Header ──────────────────────────────────────────────────────── */
.works-page__header {
  max-width: 1280px;
  margin-inline: auto;
  padding: 150px 32px 56px;
}
@media (max-width: 700px) { .works-page__header { padding: 120px 20px 40px; } }
.works-page__header-inner {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.works-page__kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #f05e23;
}
.works-page__title {
  font-family: var(--font-poster);
  font-size: clamp(3.2rem, 10vw, 9rem);
  font-weight: 400;
  letter-spacing: 0.014em;
  line-height: 0.96;
  text-transform: uppercase;
  color: #f8f8f8;
}
.works-page__sub {
  font-size: clamp(0.95rem, 1.5vw, 1.15rem);
  line-height: 1.6;
  color: rgba(248, 248, 248, 0.45);
  max-width: 56ch;
}
.works-page__metas {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 28px;
  margin-top: 10px;
}
.works-page__meta {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(248, 248, 248, 0.45);
}
.works-page__meta strong {
  font-family: var(--font-poster);
  font-weight: 400;
  font-size: 1.5rem;
  letter-spacing: 0.02em;
  color: #f05e23;
  margin-right: 7px;
  vertical-align: -2px;
}

/* ── Cinta de logos de clientes ──────────────────────────────────── */
.works-logos {
  overflow: hidden;
  border-block: 1px solid rgba(248, 248, 248, 0.08);
  padding-block: 26px;
  margin-bottom: 40px;
}
.works-logos__seq {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: clamp(28px, 4vw, 56px);
  padding-inline: clamp(22px, 3vw, 44px);
}
.works-logos__item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60px;
  padding: 8px;
  border-radius: 14px;
  overflow: hidden;
  opacity: 0.88;
  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.35);
  transition: opacity 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
}
.works-logos__item:hover {
  opacity: 1;
  transform: translateY(-3px) scale(1.04);
  box-shadow: 0 16px 36px rgba(240, 94, 35, 0.28);
}
.works-logos__item img {
  height: 100%;
  width: auto;
  max-width: 130px;
  object-fit: cover;
  border-radius: 10px;
}
@media (prefers-reduced-motion: reduce) {
  .works-logos__item { transition: none; }
}

/* ── Filtros ─────────────────────────────────────────────────────── */
.works-filters-wrap {
  max-width: 1280px;
  margin-inline: auto;
  padding-inline: 32px;
}
@media (max-width: 700px) { .works-filters-wrap { padding-inline: 20px; } }
.works-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding-bottom: 4px;
}
@media (max-width: 700px) {
  .works-filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
  .works-filters::-webkit-scrollbar { display: none; }
}
.wfilter {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border: 1px solid rgba(248, 248, 248, 0.16);
  background: transparent;
  color: rgba(248, 248, 248, 0.6);
  font-size: 13px;
  font-weight: 600;
  padding: 10px 18px;
  border-radius: 999px;
  white-space: nowrap;
  cursor: pointer;
  transition: border-color 0.3s, color 0.3s, background 0.3s, transform 0.3s;
}
.wfilter:hover { border-color: rgba(248, 248, 248, 0.4); color: #fff; }
.wfilter[aria-pressed="true"] {
  background: #f05e23;
  border-color: #f05e23;
  color: #fff;
  box-shadow: 0 8px 22px rgba(240, 94, 35, 0.35);
}
.wfilter__count {
  font-size: 11px;
  font-weight: 700;
  opacity: 0.65;
}

/* ── Grid ────────────────────────────────────────────────────────── */
.works-grid {
  max-width: 1280px;
  margin-inline: auto;
  padding: 40px 32px 120px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  perspective: 1600px;
}
@media (max-width: 760px) {
  .works-grid { grid-template-columns: 1fr; padding: 24px 20px 80px; gap: 16px; }
}

/* Slot: contiene el numero fantasma + la tarjeta; el desfase vertical
   alternado rompe la simetria de grilla estandar (ritmo editorial). */
.wcard-slot { position: relative; }
@media (min-width: 761px) {
  .wcard-slot--offset { margin-top: 56px; }
}

/* Numero editorial gigante detras de cada tarjeta */
.wcard-ghost {
  position: absolute;
  top: -0.42em;
  left: -0.06em;
  z-index: 0;
  font-family: var(--font-poster);
  font-weight: 400;
  font-size: clamp(5rem, 11vw, 9rem);
  line-height: 1;
  color: transparent;
  -webkit-text-stroke: 1.5px rgba(248, 248, 248, 0.14);
  pointer-events: none;
  user-select: none;
}

/* ── Card ────────────────────────────────────────────────────────── */
.wcard {
  position: relative;
  z-index: 1;
  display: block;
  min-height: 460px;
  border-radius: 18px;
  overflow: hidden;
  text-decoration: none;
  color: #f8f8f8;
  isolation: isolate;
  background: #161616;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  transition: box-shadow 0.4s ease, opacity 0.35s ease, transform 0.35s ease;
}
.wcard:hover { box-shadow: 0 34px 90px rgba(240, 94, 35, 0.16), 0 24px 60px rgba(0, 0, 0, 0.4); }
@media (max-width: 760px) { .wcard { min-height: 420px; } }

/* Wrapper del tilt 3D — nodo propio, aislado de la animacion de entrada
   por scroll (que vive en .wcard) para que GSAP nunca pise un transform
   con el otro al recalcular/hacer refresh. */
.wcard__tilt {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  transform-style: preserve-3d;
  will-change: transform;
}

/* Brillo que sigue al cursor (posicion via --mx/--my seteadas en JS) */
.wcard__glare {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.4s ease;
  background: radial-gradient(
    380px circle at var(--mx, 50%) var(--my, 50%),
    rgba(255, 255, 255, 0.16),
    transparent 60%
  );
}
.wcard:hover .wcard__glare { opacity: 1; }
@media (hover: none) { .wcard__glare { display: none; } }

/* ── Media: foto o video real en hover ──────────────────────────────*/
.wcard__media {
  position: relative;
  flex: 0 0 62%;
  overflow: hidden;
  background: #161616;
}
.wcard__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1.02);
  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s ease, opacity 0.5s ease;
  filter: saturate(0.85) brightness(0.78);
}
.wcard__fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wcard__fallback-logo { max-width: 55%; max-height: 45%; object-fit: contain; }
.wcard__overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(10, 10, 10, 0.1) 0%, rgba(10, 10, 10, 0.2) 55%, rgba(10, 10, 10, 0.75) 100%);
  transition: background 0.5s ease;
}
.wcard:hover .wcard__img { transform: scale(1.08); filter: saturate(1) brightness(0.7); }
.wcard:hover .wcard__overlay {
  background:
    linear-gradient(180deg, rgba(10, 10, 10, 0.05) 0%, rgba(240, 94, 35, 0.1) 45%, rgba(10, 10, 10, 0.8) 100%);
}
/* Video inyectado por JS al hover (desktop) o al entrar en vista (touch) */
.wcard__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transition: opacity 0.5s ease;
}
.wcard__media.is-video .wcard__video { opacity: 1; }
.wcard__media.is-video .wcard__img { opacity: 0; }

/* Pildora "Ver caso" centrada — aparece sobre la foto/video al hover */
.pcard__cta {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 2;
  transform: translate(-50%, -50%) scale(0.85);
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(13, 13, 13, 0.82);
  backdrop-filter: blur(6px);
  color: #fff;
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: 0.02em;
  padding: 11px 20px;
  border-radius: 999px;
  border: 1px solid rgba(248, 248, 248, 0.2);
  opacity: 0;
  transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
}
.wcard:hover .pcard__cta { opacity: 1; transform: translate(-50%, -50%) scale(1); }

/* ── Info debajo del media ──────────────────────────────────────────*/
.pcard__info {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 22px 24px 24px;
}
.pcard__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
}
.pcard__client {
  font-family: var(--font-poster);
  font-weight: 400;
  font-size: clamp(1.3rem, 2.4vw, 1.75rem);
  text-transform: uppercase;
  letter-spacing: 0.016em;
  line-height: 1.04;
  color: #fff;
}
.pcard__metric {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-family: var(--font-poster);
  font-weight: 400;
  font-size: 1.15rem;
  color: #f05e23;
  line-height: 1.15;
  text-align: right;
}
.pcard__metric small {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 9px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(248, 248, 248, 0.45);
}
.pcard__summary {
  font-size: 0.9rem;
  line-height: 1.5;
  color: rgba(248, 248, 248, 0.62);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.pcard__bottom {
  margin-top: auto;
  padding-top: 8px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.pcard__services {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: rgba(248, 248, 248, 0.4);
}

/* Flecha B-up: en reposo apunta arriba-derecha; al hover "despega" y
   una segunda flecha fantasma la releva desde abajo (motivo de marca) */
.wcard__arrow {
  position: relative;
  flex: 0 0 auto;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid rgba(248, 248, 248, 0.25);
  background: rgba(248, 248, 248, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #fff;
  transition: background 0.35s, border-color 0.35s, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}
.wcard:hover .wcard__arrow {
  background: #f05e23;
  border-color: #f05e23;
  transform: scale(1.08);
}
.wcard__arrow-up {
  position: absolute;
  width: 15px;
  height: 18px;
  transform: rotate(45deg);
  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease;
}
.wcard__arrow-up--ghost { opacity: 0; transform: rotate(45deg) translateY(24px); }
.wcard:hover .wcard__arrow-up:not(.wcard__arrow-up--ghost) {
  transform: rotate(45deg) translateY(-24px);
  opacity: 0;
}
.wcard:hover .wcard__arrow-up--ghost {
  transform: rotate(45deg) translateY(0);
  opacity: 1;
  transition-delay: 0.08s;
}

@media (prefers-reduced-motion: reduce) {
  .wcard__img, .wcard__arrow, .wcard__overlay, .wcard,
  .wcard__arrow-up, .wcard__glare, .wcard__video, .pcard__cta { transition: none; }
}
</style>
