---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import { SERVICES } from '../../data/services';
import { PROJECTS } from '../../data/projects';
import { useT, localePath, type Locale } from '../../i18n';

import logoChacha from '../../assets/logos/chachapollo.webp';
import logoJdcargo from '../../assets/logos/jdcargo.webp';
import logoAracnida from '../../assets/logos/aracnida.webp';
import logoTemplo from '../../assets/logos/templo-maipu.webp';
import logoBell from '../../assets/logos/bell-college.webp';
import logoSuperlunch from '../../assets/logos/superlunch.webp';

import imgWeb from '../../assets/categories/web.webp';
import imgEcom from '../../assets/categories/ecommerce.webp';
import imgBrand from '../../assets/categories/branding.webp';
import imgContent from '../../assets/categories/content.webp';
import imgAds from '../../assets/categories/ads.webp';
import imgAi from '../../assets/categories/ai.webp';
import imgGrowth from '../../assets/categories/growth.webp';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const lp = (p: string) => localePath(locale, p);
const isEs = locale === 'es';

const CAT_IMG: Record<string, ImageMetadata> = {
  'diseno-web': imgWeb,
  'ecommerce': imgEcom,
  'branding': imgBrand,
  'contenido-reels': imgContent,
  'publicidad-digital': imgAds,
  'automatizaciones-ia': imgAi,
  'marketing-growth': imgGrowth,
};

const categories = SERVICES.map((s) => ({
  num: s.num,
  slug: s.slug,
  title: isEs ? s.title.es : s.title.en,
  tag: isEs ? s.tag.es : s.tag.en,
  short: isEs ? s.short.es : s.short.en,
  count: PROJECTS.filter((p) => p.serviceSlugs.includes(s.slug)).length,
  href: lp(`/servicios/${s.slug}/portafolio`),
  img: CAT_IMG[s.slug],
}));

const total = PROJECTS.length;

const clientLogos = [
  { img: logoChacha, name: 'El Chacha Pollo' },
  { img: logoJdcargo, name: 'JD Cargo Logistics' },
  { img: logoAracnida, name: 'Aracnida Store' },
  { img: logoTemplo, name: 'Templo Votivo de Maipú' },
  { img: logoBell, name: 'Bell College' },
  { img: logoSuperlunch, name: 'Superlunch' },
];

const metas = [
  { val: `${total}`, lbl: isEs ? 'Proyectos' : 'Projects' },
  { val: '7', lbl: isEs ? 'Áreas de servicio' : 'Service areas' },
  { val: '+1M', lbl: isEs ? 'Views generadas' : 'Views generated' },
];
---

<Base locale={locale} title={t.meta.work.title} description={t.meta.work.desc}>

  <div class="works-page">

    <!-- Header editorial -->
    <header class="works-page__header">
      <div class="works-page__header-inner">
        <span class="works-page__kicker" data-reveal>
          {isEs ? `Portafolio — ${total} proyectos realizados` : `Portfolio — ${total} completed projects`}
        </span>
        <h1 class="works-page__title display-tight" data-reveal-word>
          {isEs ? 'Nuestro Trabajo' : 'Our Work'}
        </h1>
        <p class="works-page__sub" data-reveal data-delay="0.1">
          {isEs
            ? 'Elige una categoría para explorar los casos reales de esa área. Marcas reales, resultados medibles.'
            : 'Choose a category to explore real cases from that area. Real brands, measurable results.'}
        </p>

        <!-- Métricas rápidas -->
        <div class="works-page__metas" data-reveal data-delay="0.18">
          {metas.map((m) => (
            <span class="works-page__meta">
              <strong>{m.val}</strong> {m.lbl}
            </span>
          ))}
        </div>
      </div>
    </header>

    <!-- Cinta de logos de clientes -->
    <div class="works-logos" aria-label={isEs ? 'Marcas con las que trabajamos' : 'Brands we work with'}>
      <div class="marquee-track marquee-track--slow">
        {[0, 1].map((copy) => (
          <div class="works-logos__seq" aria-hidden={copy === 1 ? 'true' : undefined}>
            {[...clientLogos, ...clientLogos].map((l, i) => (
              <span class="works-logos__item">
                <Image src={l.img} alt={copy === 0 && i < clientLogos.length ? l.name : ''} widths={[200]} sizes="140px" />
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- Grid de categorías con foto -->
    <main class="works-grid">
      {categories.map((cat, i) => (
        <a
          href={cat.href}
          class={`wcard${cat.count === 0 ? ' is-empty' : ''}${i === 0 ? ' wcard--wide' : ''}`}
          data-work-item
        >
          <div class="wcard__media">
            <Image
              src={cat.img}
              alt={cat.title}
              class="wcard__img"
              widths={[480, 800, 1400]}
              sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 640px"
            />
            <span class="wcard__overlay" aria-hidden="true"></span>
          </div>

          <div class="wcard__content">
            <div class="wcard__top">
              <span class="wcard__num">{cat.num}</span>
              <span class="wcard__tag">{cat.tag}</span>
            </div>

            <div class="wcard__bottom">
              <h2 class="wcard__title">{cat.title}</h2>
              <p class="wcard__short">{cat.short}</p>
              <div class="wcard__meta">
                <span class="wcard__count">
                  {cat.count > 0
                    ? `${cat.count} ${isEs ? (cat.count === 1 ? 'caso' : 'casos') : (cat.count === 1 ? 'case' : 'cases')}`
                    : (isEs ? 'Próximamente' : 'Coming soon')}
                </span>
                <span class="wcard__arrow" aria-hidden="true">&#8599;</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </main>

  </div>

  <CtaBand locale={locale} />

</Base>

<style>
.works-page {
  background: #0a0a0a;
  color: #f8f8f8;
}

/* ── Header ──────────────────────────────────────────────────────── */
.works-page__header {
  max-width: 1280px;
  margin-inline: auto;
  padding: 150px 32px 56px;
}
@media (max-width: 700px) { .works-page__header { padding: 120px 20px 40px; } }
.works-page__header-inner {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.works-page__kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #f05e23;
}
.works-page__title {
  font-family: var(--font-poster);
  font-size: clamp(3.2rem, 10vw, 9rem);
  font-weight: 400;
  letter-spacing: 0.014em;
  line-height: 0.96;
  text-transform: uppercase;
  color: #f8f8f8;
}
.works-page__sub {
  font-size: clamp(0.95rem, 1.5vw, 1.15rem);
  line-height: 1.6;
  color: rgba(248, 248, 248, 0.45);
  max-width: 56ch;
}
.works-page__metas {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 28px;
  margin-top: 10px;
}
.works-page__meta {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(248, 248, 248, 0.45);
}
.works-page__meta strong {
  font-family: var(--font-poster);
  font-weight: 400;
  font-size: 1.5rem;
  letter-spacing: 0.02em;
  color: #f05e23;
  margin-right: 7px;
  vertical-align: -2px;
}

/* ── Cinta de logos de clientes ──────────────────────────────────── */
.works-logos {
  overflow: hidden;
  border-block: 1px solid rgba(248, 248, 248, 0.08);
  padding-block: 26px;
  margin-bottom: 52px;
}
.works-logos__seq {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: clamp(28px, 4vw, 56px);
  padding-inline: clamp(22px, 3vw, 44px);
}
/* Chip apagado por defecto (se integra al fondo oscuro, sin blanco que
   grite); recupera color y brillo al pasar el mouse. */
.works-logos__item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52px;
  padding: 7px 16px;
  background: #e9e6e0;
  border-radius: 10px;
  opacity: 0.32;
  filter: grayscale(1) contrast(0.95);
  transition: opacity 0.35s ease, filter 0.35s ease, transform 0.35s ease;
}
.works-logos__item:hover {
  opacity: 1;
  filter: grayscale(0) contrast(1);
  transform: translateY(-2px);
}
.works-logos__item img {
  max-height: 36px;
  width: auto;
  max-width: 120px;
  object-fit: contain;
}
@media (prefers-reduced-motion: reduce) {
  .works-logos__item { transition: none; }
}

/* ── Grid ────────────────────────────────────────────────────────── */
.works-grid {
  max-width: 1280px;
  margin-inline: auto;
  padding: 0 32px 96px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}
@media (max-width: 760px) {
  .works-grid { grid-template-columns: 1fr; padding: 0 20px 72px; gap: 16px; }
}

/* ── Card ────────────────────────────────────────────────────────── */
.wcard {
  position: relative;
  display: block;
  min-height: 360px;
  border-radius: 18px;
  overflow: hidden;
  text-decoration: none;
  color: #f8f8f8;
  isolation: isolate;
  background: #161616;
}
.wcard--wide { grid-column: 1 / -1; min-height: 400px; }
@media (max-width: 760px) {
  .wcard { min-height: 320px; }
  .wcard--wide { grid-column: auto; min-height: 320px; }
}

.wcard__media {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
}
.wcard__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1.02);
  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s ease;
  filter: saturate(0.85) brightness(0.78);
}
.wcard__overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(10, 10, 10, 0.15) 0%, rgba(10, 10, 10, 0.35) 45%, rgba(10, 10, 10, 0.92) 100%);
  transition: background 0.5s ease;
}
.wcard:hover .wcard__img { transform: scale(1.09); filter: saturate(1) brightness(0.88); }
.wcard:hover .wcard__overlay {
  background:
    linear-gradient(180deg, rgba(10, 10, 10, 0.05) 0%, rgba(240, 94, 35, 0.12) 40%, rgba(10, 10, 10, 0.92) 100%);
}

/* Content over photo */
.wcard__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  min-height: inherit;
  padding: 26px 28px 28px;
}
.wcard--wide .wcard__content { padding: 32px 36px 34px; }

.wcard__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.wcard__num {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: rgba(248, 248, 248, 0.6);
}
.wcard__tag {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #fff;
  background: rgba(240, 94, 35, 0.85);
  padding: 5px 12px;
  border-radius: 100px;
  backdrop-filter: blur(4px);
}

.wcard__bottom { display: flex; flex-direction: column; gap: 12px; }
.wcard__title {
  font-family: var(--font-poster);
  font-size: clamp(1.6rem, 3vw, 2.5rem);
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.016em;
  line-height: 1.04;
  color: #fff;
}
.wcard--wide .wcard__title { font-size: clamp(2rem, 4vw, 3.4rem); }
.wcard__short {
  font-size: 0.92rem;
  line-height: 1.55;
  color: rgba(248, 248, 248, 0.7);
  max-width: 44ch;
}
.wcard__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
}
.wcard__count {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(248, 248, 248, 0.55);
}
.wcard__arrow {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: 1px solid rgba(248, 248, 248, 0.25);
  background: rgba(248, 248, 248, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19px;
  color: #fff;
  transform: translateY(4px);
  transition: background 0.35s, border-color 0.35s, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}
.wcard:hover .wcard__arrow {
  background: #f05e23;
  border-color: #f05e23;
  transform: translateY(0);
}

.wcard.is-empty { opacity: 0.5; pointer-events: none; filter: grayscale(0.4); }
.wcard.is-empty .wcard__tag { background: rgba(248, 248, 248, 0.2); }

@media (prefers-reduced-motion: reduce) {
  .wcard__img, .wcard__arrow, .wcard__overlay { transition: none; }
}
</style>
