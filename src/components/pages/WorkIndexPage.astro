---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import { SERVICES } from '../../data/services';
import { PROJECTS } from '../../data/projects';
import { useT, pick, localePath, type Locale } from '../../i18n';

import logoChacha from '../../assets/logos/chachapollo.webp';
import logoJdcargo from '../../assets/logos/jdcargo.webp';
import logoAracnida from '../../assets/logos/aracnida.webp';
import logoTemplo from '../../assets/logos/templo-maipu.webp';
import logoBell from '../../assets/logos/bell-college.webp';
import logoSuperlunch from '../../assets/logos/superlunch.webp';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useT(locale);
const lp = (p: string) => localePath(locale, p);
const isEs = locale === 'es';

const total = PROJECTS.length;

// Mapeo de video: los proyectos "featured" (en orden del array) usan
// work1.mp4…work5.mp4 — mismo criterio que la home.
const featuredSlugs = PROJECTS.filter((p) => p.featured).map((p) => p.slug);
const VIDEO_MAP = new Map(featuredSlugs.map((slug, i) => [slug, `/videos/work${i + 1}.mp4`]));

const svcName = (slug: string) => {
  const s = SERVICES.find((x) => x.slug === slug);
  return s ? pick(s.title, locale) : slug;
};

const items = PROJECTS.map((p, i) => ({
  slug: p.slug,
  num: String(i + 1).padStart(2, '0'),
  client: p.client,
  sector: pick(p.sector, locale),
  year: p.year,
  cover: p.cover,
  coverSrc: p.cover?.src ?? null,
  logo: p.logo,
  logoSrc: p.logo?.src ?? null,
  gradient: p.gradient,
  video: VIDEO_MAP.get(p.slug) ?? null,
  summary: pick(p.summary, locale),
  serviceSlugs: p.serviceSlugs,
  serviceNames: p.serviceSlugs.map(svcName),
  metric: p.metrics[0],
  href: lp(`/trabajos/${p.slug}`),
}));

// Tabs de filtro: "Todos" + un tab por servicio con al menos un caso.
const filters = [
  { slug: 'all', label: isEs ? 'Todos' : 'All', count: total },
  ...SERVICES.map((s) => ({
    slug: s.slug,
    label: pick(s.title, locale),
    count: PROJECTS.filter((p) => p.serviceSlugs.includes(s.slug)).length,
  })).filter((f) => f.count > 0),
];

const clientLogos = [
  { img: logoChacha, name: 'El Chacha Pollo' },
  { img: logoJdcargo, name: 'JD Cargo Logistics' },
  { img: logoAracnida, name: 'Aracnida Store' },
  { img: logoTemplo, name: 'Templo Votivo de Maipú' },
  { img: logoBell, name: 'Bell College' },
  { img: logoSuperlunch, name: 'Superlunch' },
];

const metas = [
  { val: `${total}`, lbl: isEs ? 'Proyectos' : 'Projects' },
  { val: '7', lbl: isEs ? 'Áreas de servicio' : 'Service areas' },
  { val: '+1M', lbl: isEs ? 'Views generadas' : 'Views generated' },
];

const viewLabel = isEs ? 'Ver caso' : 'View case';
---

<Base locale={locale} title={t.meta.work.title} description={t.meta.work.desc}>

  <div class="works">

    <!-- Header editorial -->
    <header class="works__header">
      <div class="works__header-inner">
        <p class="works__kicker" data-reveal>
          {isEs ? `Portafolio — ${total} proyectos realizados` : `Portfolio — ${total} completed projects`}
        </p>
        <h1 class="works__title" data-reveal-word>
          {isEs ? 'Nuestro Trabajo' : 'Our Work'}
        </h1>
        <p class="works__sub" data-reveal data-delay="0.1">
          {isEs
            ? 'Elige un servicio y recorre los proyectos en 3D. Pasa el mouse para ver el trabajo en movimiento.'
            : 'Pick a service and scroll the projects in 3D. Hover to see the work in motion.'}
        </p>
        <div class="works__metas" data-reveal data-delay="0.18">
          {metas.map((m) => (
            <span class="works__meta"><strong>{m.val}</strong> {m.lbl}</span>
          ))}
        </div>
      </div>
    </header>

    <!-- Cinta de logos -->
    <div class="works-logos" aria-label={isEs ? 'Marcas con las que trabajamos' : 'Brands we work with'}>
      <div class="marquee-track marquee-track--slow">
        {[0, 1].map((copy) => (
          <div class="works-logos__seq" aria-hidden={copy === 1 ? 'true' : undefined}>
            {[...clientLogos, ...clientLogos].map((l, i) => (
              <span class="works-logos__item">
                <Image src={l.img} alt={copy === 0 && i < clientLogos.length ? l.name : ''} widths={[200]} sizes="140px" />
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- Tabs de filtro (sticky) -->
    <div class="works-filters-wrap">
      <div class="works-filters" role="tablist" aria-label={isEs ? 'Filtrar por servicio' : 'Filter by service'}>
        {filters.map((f, i) => (
          <button type="button" class="wfilter" data-filter={f.slug} role="tab" aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label} <span class="wfilter__count">{f.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Lista editorial + capa WebGL. El canvas es fijo y dibuja los
         planos 3D sincronizados a cada .wrow__media. Si WebGL falla,
         las imágenes del DOM quedan visibles como respaldo. -->
    <section class="works3d" id="works3d">
      <canvas class="works3d__canvas" id="works3d-canvas" aria-hidden="true"></canvas>

      <div class="works3d__list">
        {items.map((p, i) => (
          <article
            class={`wrow${i % 2 === 1 ? ' wrow--rev' : ''}`}
            data-project-slot
            data-filters={p.serviceSlugs.join(' ')}
          >
            <a
              class="wrow__media"
              href={p.href}
              data-webgl-media
              data-gradient={p.gradient}
              data-texture={p.coverSrc ?? p.logoSrc ?? ''}
              data-mode={p.coverSrc ? 'cover' : 'logo'}
              data-video-src={p.video ?? ''}
              aria-label={`${viewLabel}: ${p.client}`}
            >
              <div class="wrow__media-inner">
                {p.coverSrc ? (
                  <Image src={p.cover} alt={p.client} class="wrow__img"
                    widths={[480, 900, 1400]} sizes="(max-width: 860px) 92vw, 46vw" />
                ) : (
                  <div class="wrow__fallback" style={`background:${p.gradient}`}>
                    {p.logo && <Image src={p.logo} alt={p.client} class="wrow__fallback-logo" widths={[260]} sizes="200px" />}
                  </div>
                )}
              </div>
              <span class="wrow__cta" aria-hidden="true">
                {viewLabel}
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
                  <path d="M2 14 L14 2 M14 2 H5 M14 2 V11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>

            <div class="wrow__info">
              <span class="wrow__num" aria-hidden="true">{p.num}</span>
              <p class="wrow__eyebrow">{p.sector} · {p.year}</p>
              <a href={p.href} class="wrow__titlelink">
                <h2 class="wrow__title">{p.client}</h2>
              </a>
              <p class="wrow__summary">{p.summary}</p>
              <div class="wrow__foot">
                <p class="wrow__services">{p.serviceNames.join(' · ')}</p>
                {p.metric && (
                  <span class="wrow__metric">{p.metric.val}<small>{pick(p.metric.lbl, locale)}</small></span>
                )}
              </div>
            </div>
          </article>
        ))}

        <p class="works3d__empty" id="works3d-empty" hidden>
          {isEs ? 'No hay proyectos en esta categoría todavía.' : 'No projects in this category yet.'}
        </p>
      </div>
    </section>

  </div>

  <CtaBand locale={locale} />

</Base>

<style>
.works { background: #0a0a0a; color: #f6f6f6; }

/* ── Header ───────────────────────────────────────────────────────── */
.works__header { max-width: 1280px; margin-inline: auto; padding: 150px 32px 52px; }
@media (max-width: 700px) { .works__header { padding: 120px 20px 40px; } }
.works__header-inner { display: flex; flex-direction: column; gap: 16px; }
.works__kicker {
  font-size: 11px; font-weight: 700; letter-spacing: 0.18em;
  text-transform: uppercase; color: #f05e23;
}
.works__title {
  font-family: var(--font-poster); font-weight: 400;
  font-size: clamp(3.2rem, 10vw, 9rem); letter-spacing: 0.014em;
  line-height: 0.94; text-transform: uppercase; color: #f6f6f6;
}
.works__sub {
  font-size: clamp(0.95rem, 1.5vw, 1.15rem); line-height: 1.6;
  color: rgba(246, 246, 246, 0.46); max-width: 54ch;
}
.works__metas { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 10px; }
.works__meta {
  font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
  text-transform: uppercase; color: rgba(246, 246, 246, 0.46);
}
.works__meta strong {
  font-family: var(--font-poster); font-weight: 400; font-size: 1.5rem;
  letter-spacing: 0.02em; color: #f05e23; margin-right: 7px; vertical-align: -2px;
}

/* ── Cinta de logos ───────────────────────────────────────────────── */
.works-logos {
  overflow: hidden; border-block: 1px solid rgba(246, 246, 246, 0.08);
  padding-block: 24px;
}
.works-logos__seq {
  display: flex; align-items: center; flex: 0 0 auto;
  gap: clamp(28px, 4vw, 56px); padding-inline: clamp(22px, 3vw, 44px);
}
.works-logos__item {
  display: flex; align-items: center; justify-content: center;
  height: 58px; padding: 8px; border-radius: 14px; overflow: hidden;
  opacity: 0.85; box-shadow: 0 10px 26px rgba(0, 0, 0, 0.35);
  transition: opacity 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
}
.works-logos__item:hover {
  opacity: 1; transform: translateY(-3px) scale(1.04);
  box-shadow: 0 16px 36px rgba(240, 94, 35, 0.28);
}
.works-logos__item img { height: 100%; width: auto; max-width: 128px; object-fit: cover; border-radius: 10px; }

/* ── Filtros (sticky) ─────────────────────────────────────────────── */
.works-filters-wrap {
  position: sticky; top: 0; z-index: 30;
  background: rgba(10, 10, 10, 0.82);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(246, 246, 246, 0.08);
}
.works-filters {
  max-width: 1280px; margin-inline: auto;
  display: flex; flex-wrap: wrap; gap: 10px;
  padding: 16px 32px;
}
@media (max-width: 760px) {
  .works-filters {
    flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding: 14px 20px;
  }
  .works-filters::-webkit-scrollbar { display: none; }
}
.wfilter {
  flex: 0 0 auto; display: inline-flex; align-items: center; gap: 7px;
  border: 1px solid rgba(246, 246, 246, 0.16); background: transparent;
  color: rgba(246, 246, 246, 0.6); font-size: 13px; font-weight: 600;
  padding: 10px 18px; border-radius: 999px; white-space: nowrap; cursor: pointer;
  transition: border-color 0.3s, color 0.3s, background 0.3s;
}
.wfilter:hover { border-color: rgba(246, 246, 246, 0.4); color: #fff; }
.wfilter[aria-pressed="true"] {
  background: #f05e23; border-color: #f05e23; color: #fff;
  box-shadow: 0 8px 22px rgba(240, 94, 35, 0.35);
}
.wfilter__count { font-size: 11px; font-weight: 700; opacity: 0.65; }

/* ── Sección lista + canvas WebGL ─────────────────────────────────── */
.works3d { position: relative; }
.works3d__canvas {
  position: fixed; inset: 0; width: 100vw; height: 100vh;
  z-index: 1; pointer-events: none; opacity: 0;
  transition: opacity 0.6s ease;
}
/* Cuando el JS activa WebGL marca <html class="webgl-on"> */
:global(html.webgl-on) .works3d__canvas { opacity: 1; }

.works3d__list {
  position: relative; z-index: 2;
  max-width: 1280px; margin-inline: auto;
  padding: clamp(40px, 6vw, 80px) 32px clamp(80px, 10vw, 130px);
  display: flex; flex-direction: column; gap: clamp(56px, 9vw, 130px);
}
@media (max-width: 700px) { .works3d__list { padding-inline: 20px; } }

/* ── Fila de proyecto ─────────────────────────────────────────────── */
.wrow {
  display: grid; grid-template-columns: 1.05fr 0.95fr;
  gap: clamp(24px, 4vw, 64px); align-items: center;
}
.wrow--rev { grid-template-columns: 0.95fr 1.05fr; }
.wrow--rev .wrow__media { order: 2; }
.wrow--rev .wrow__info { order: 1; }
@media (max-width: 860px) {
  .wrow, .wrow--rev { grid-template-columns: 1fr; gap: 22px; }
  .wrow--rev .wrow__media, .wrow--rev .wrow__info { order: initial; }
}

/* Panel de media — objetivo del plano WebGL */
.wrow__media {
  position: relative; display: block; border-radius: 18px;
  overflow: hidden; aspect-ratio: 4 / 3; background: #141414;
  box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4);
  text-decoration: none; isolation: isolate;
}
.wrow__media-inner { position: absolute; inset: 0; }
/* Con WebGL activo el panel se vuelve una "ventana" transparente para
   que el plano 3D del canvas (que va detrás) se vea a través de él. */
:global(html.webgl-on) .wrow__media { background: transparent; }
:global(html.webgl-on) .wrow__media-inner { opacity: 0; }
.wrow__img, .wrow__fallback {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
}
.wrow__media:hover .wrow__img { transform: scale(1.05); }
.wrow__fallback { display: flex; align-items: center; justify-content: center; }
.wrow__fallback-logo { width: auto; height: auto; max-width: 58%; max-height: 46%; object-fit: contain; }

.wrow__cta {
  position: absolute; z-index: 3; bottom: 16px; left: 16px;
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(13, 13, 13, 0.82); backdrop-filter: blur(6px);
  color: #fff; font-size: 12px; font-weight: 700; letter-spacing: 0.02em;
  padding: 10px 16px; border-radius: 999px;
  border: 1px solid rgba(246, 246, 246, 0.18);
  opacity: 0; transform: translateY(8px);
  transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}
.wrow__media:hover .wrow__cta { opacity: 1; transform: translateY(0); }

/* ── Info ─────────────────────────────────────────────────────────── */
.wrow__info { min-width: 0; display: flex; flex-direction: column; }
.wrow__num {
  font-family: var(--font-poster); font-weight: 400;
  font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1;
  color: transparent; -webkit-text-stroke: 1.4px rgba(246, 246, 246, 0.22);
  margin-bottom: 14px;
}
.wrow__eyebrow {
  font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
  text-transform: uppercase; color: #f05e23; margin-bottom: 12px;
}
.wrow__titlelink { text-decoration: none; }
.wrow__title {
  font-family: var(--font-poster); font-weight: 400;
  font-size: clamp(2.2rem, 5.2vw, 4rem); text-transform: uppercase;
  letter-spacing: 0.014em; line-height: 0.98; color: #fff;
  transition: color 0.3s, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}
.wrow__titlelink:hover .wrow__title { color: #f05e23; transform: translateX(8px) skewX(-3deg); }
.wrow__summary {
  margin-top: 16px; font-size: clamp(0.95rem, 1.4vw, 1.08rem); line-height: 1.6;
  color: rgba(246, 246, 246, 0.6); max-width: 46ch;
}
.wrow__foot {
  margin-top: 22px; display: flex; align-items: center;
  justify-content: space-between; gap: 16px; flex-wrap: wrap;
  border-top: 1px solid rgba(246, 246, 246, 0.1); padding-top: 18px;
}
.wrow__services {
  font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em;
  text-transform: uppercase; color: rgba(246, 246, 246, 0.44);
}
.wrow__metric {
  display: flex; flex-direction: column; align-items: flex-end;
  font-family: var(--font-poster); font-weight: 400; font-size: 1.5rem;
  color: #f05e23; line-height: 1.05; text-align: right;
}
.wrow__metric small {
  font-family: var(--font-body); font-weight: 700; font-size: 9px;
  letter-spacing: 0.08em; text-transform: uppercase;
  color: rgba(246, 246, 246, 0.44); margin-top: 2px;
}

.works3d__empty {
  text-align: center; color: rgba(246, 246, 246, 0.5);
  font-size: 1rem; padding: 60px 0;
}

@media (prefers-reduced-motion: reduce) {
  .wrow__img, .wrow__title, .wrow__cta { transition: none; }
}
</style>
