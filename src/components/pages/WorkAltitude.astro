</style>

<script>
  // Ruta de vuelo: el avioncito sigue el scroll a lo largo de la línea y la
  // línea se "dibuja". Scroll-driven propio (sin depender de GSAP) para que
  // funcione aunque la capa global de motion no corra.
  function initAltRoute() {
    const section = document.querySelector<HTMLElement>('[data-alt-route]');
    if (!section) return;
    const plane = section.querySelector<HTMLElement>('[data-alt-plane]');
    const line = section.querySelector<SVGLineElement>('[data-alt-line]');
    const path = section.querySelector<HTMLElement>('.alt-path');
    if (!plane || !line || !path) return;

    const lineLen = 1000; // viewBox height
    line.style.strokeDashoffset = String(lineLen);

    const onScroll = () => {
      if (!section.isConnected) { window.removeEventListener('scroll', onScroll); return; }
      const rect = path.getBoundingClientRect();
      const vh = window.innerHeight;
      // progreso 0..1 mientras la ruta cruza el viewport
      const prog = Math.max(0, Math.min(1, (vh * 0.75 - rect.top) / (rect.height * 0.9)));
      plane.style.top = `${prog * rect.height}px`;
      line.style.strokeDashoffset = String(lineLen * (1 - prog));
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Altímetro del HUD: cuenta hasta 10.000 al cargar.
  function initAltimeter() {
    const el = document.querySelector<HTMLElement>('[data-altimeter]');
    if (!el) return;
    const target = 10000;
    const dur = 1600;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(target * eased).toLocaleString('es-CL');
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  const run = () => { initAltRoute(); initAltimeter(); };
  run();
  document.addEventListener('astro:page-load', run);
</script>
