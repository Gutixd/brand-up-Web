---
// Página individual de un servicio (/servicios/[slug]). Mismo sistema
// editorial que el hub /servicios, pero enfocado en una sola disciplina:
// titular conceptual, capacidades reales, fundamento técnico cuando existe,
// discoverability y los casos reales que corresponden a ese servicio.
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import { SERVICES, type Service } from '../../data/services';
import { PROJECTS } from '../../data/projects';
import { SITE } from '../../data/site';
import { SERVICE_BLOCKS, LABELS, CASES } from '../../data/servicesPage';
import { pick, localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  service: Service;
}
const { locale, service } = Astro.props;
const lp = (p: string) => localePath(locale, p);
const es = locale === 'es';
const P = <T extends { es: string; en: string }>(v: T) => pick(v, locale);

const block = SERVICE_BLOCKS.find((b) => b.slug === service.slug)!;
const allCases = PROJECTS.filter((p) => p.serviceSlugs.includes(service.slug));
const cases = allCases.slice(0, 3);
const hasMore = allCases.length > cases.length;

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: P(service.title),
  description: P(block.lead),
  url: `${SITE.domain}${lp(`/servicios/${service.slug}`)}`,
  serviceType: P(service.tag),
  areaServed: ['Santiago de Chile', 'Región Metropolitana', 'Chile'],
  provider: { '@type': 'Organization', name: SITE.legalName, url: SITE.domain },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: es ? 'Inicio' : 'Home', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: es ? 'Servicios' : 'Services', item: `${SITE.domain}${lp('/servicios')}` },
    { '@type': 'ListItem', position: 3, name: P(service.title), item: `${SITE.domain}${lp(`/servicios/${service.slug}`)}` },
  ],
};

const backLabel = es ? 'Servicios' : 'Services';
const quoteLabel = es ? 'Cotizar' : 'Quote';
const interestedTitle = es ? '¿Te interesa?' : 'Interested?';
const interestedSub = es
  ? 'Cuéntanos tu proyecto y te respondemos con una propuesta concreta.'
  : 'Tell us about your project and we will respond with a concrete proposal.';
const startNow = es ? 'Empezar ahora' : 'Start now';
---

<Base locale={locale} title={`${P(service.title)} — BrandUp`} description={P(block.lead)}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <!-- ════════ HERO ════════ -->
  <header class="sd-hero">
    <div class="sd-wrap">
      <a href={lp('/servicios')} class="sd-back" data-reveal>&#8592; {backLabel}</a>
      <p class="sd-tag" data-reveal data-delay="0.05">{P(service.tag)}</p>
      <h1 class="sd-title" data-split-chars>{P(service.title)}</h1>
      <p class="sd-headline" data-reveal data-delay="0.15">{P(block.headline)}</p>
    </div>
  </header>

  <!-- ════════ CUERPO ════════ -->
  <section class="sd-body">
    <div class="sd-wrap sd-body__grid">
      <div class="sd-body__lead-col">
        <p class="sd-lead" data-reveal>{P(block.lead)}</p>
        <a href={lp('/cotizar')} class="sd-cta" data-reveal data-delay="0.08">
          {quoteLabel} {P(service.title)} <span aria-hidden="true">&#8594;</span>
        </a>

        {block.foundation && (
          <div class="sd-found" data-reveal>
            <p class="sd-found__label">{P(block.foundation.label)}</p>
            <div class="sd-found__items">
              {(es ? block.foundation.items.es : block.foundation.items.en).map((f) => (
                <span class="sd-found__item">{f}</span>
              ))}
            </div>
          </div>
        )}

        {block.flow && (
          <div class="sd-flow" data-reveal aria-hidden="true">
            {block.flow.map((step, i) => (
              <>
                <span class="sd-flow__step">{step}</span>
                {i < block.flow!.length - 1 && <span class="sd-flow__sep">&#8594;</span>}
              </>
            ))}
          </div>
        )}

        <p class="sd-disco" data-reveal>
          <span class="sd-disco__tag">{P(LABELS.discoverability)}</span>
          {P(block.discoverability)}
        </p>
      </div>

      <div class="sd-body__caps-col">
        <p class="sd-caps-label" data-reveal>{P(LABELS.capabilities)}</p>
        <ul class="sd-caps" data-reveal data-delay="0.06">
          {(es ? block.capabilities.es : block.capabilities.en).map((c) => (
            <li class="sd-caps__item">
              <span class="sd-caps__dot" aria-hidden="true">&#8594;</span>
              {c}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ════════ CASOS REALES DE ESTE SERVICIO ════════ -->
  {cases.length > 0 && (
    <section class="sd-cases">
      <div class="sd-wrap">
        <div class="sd-cases__head">
          <p class="sd-kicker" data-reveal>— {P(CASES.kicker)}</p>
          <h2 class="sd-h2" data-split-chars>
            {es ? 'El trabajo, no la promesa.' : 'The work, not the promise.'}
          </h2>
        </div>

        <div class="sd-cases__list">
          {cases.map((c) => (
            <article class="sd-case" data-reveal>
              <header class="sd-case__head">
                <h3 class="sd-case__client">{c.client}</h3>
                <span class="sd-case__sector">{P(c.sector)}</span>
              </header>

              <div class="sd-case__body">
                <div class="sd-case__col">
                  <p class="sd-case__label">{P(CASES.labels.challenge)}</p>
                  <p class="sd-case__text">{P(c.challenge)}</p>
                </div>
                <div class="sd-case__col">
                  <p class="sd-case__label">{P(CASES.labels.strategy)}</p>
                  <p class="sd-case__text">{P(c.approach)}</p>
                </div>
                <div class="sd-case__col">
                  <p class="sd-case__label">{P(CASES.labels.impact)}</p>
                  <p class="sd-case__text">{P(c.outcome)}</p>
                </div>
              </div>

              {c.metrics.length > 0 && (
                <div class="sd-case__metrics">
                  {c.metrics.map((m) => (
                    <div class="sd-metric">
                      <span class="sd-metric__val">{m.val}</span>
                      <span class="sd-metric__lbl">{P(m.lbl)}</span>
                    </div>
                  ))}
                </div>
              )}

              <a href={lp(`/trabajos/${c.slug}`)} class="sd-case__go">
                {P(CASES.viewCase)} <span aria-hidden="true">&#8594;</span>
              </a>
            </article>
          ))}
        </div>

        {hasMore && (
          <a href={lp(`/servicios/${service.slug}/portafolio`)} class="sd-cases__all" data-reveal>
            {es ? 'Ver todo el portafolio de' : 'View the full portfolio for'} {P(service.title)}
            <span aria-hidden="true">&#8594;</span>
          </a>
        )}
      </div>
    </section>
  )}

  <!-- ════════ CTA ════════ -->
  <section class="sd-final">
    <div class="sd-wrap sd-final__inner">
      <h2 class="sd-final__title" data-split-chars>{interestedTitle}</h2>
      <p class="sd-final__sub" data-reveal>{interestedSub}</p>
      <a href={lp('/cotizar')} class="sd-final__btn" data-reveal data-delay="0.08">
        {startNow} <span aria-hidden="true">&#8594;</span>
      </a>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
.sd-wrap { max-width: 1200px; margin-inline: auto; padding-inline: 24px; }
@media (min-width: 768px) { .sd-wrap { padding-inline: 48px; } }

.sd-kicker {
  font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--color-accent); margin-bottom: 20px;
}
.sd-h2 {
  font-family: var(--font-display); font-weight: 600;
  font-size: clamp(1.9rem, 4vw, 3.2rem); line-height: 1.04; letter-spacing: -0.03em;
  color: var(--color-paper); max-width: 18ch; text-wrap: balance;
}

/* ── Hero ─────────────────────────────────────────────────────── */
.sd-hero {
  position: relative; background: #0d0d0d; color: #f8f8f8; overflow: hidden;
  padding: clamp(140px, 16vw, 200px) 0 clamp(64px, 8vw, 96px);
}
.sd-hero::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 60% 75% at 90% -10%, rgba(240, 94, 35, 0.17) 0%, transparent 60%);
  pointer-events: none;
}
.sd-hero .sd-wrap { position: relative; display: flex; flex-direction: column; gap: 18px; }
.sd-back { font-size: 0.85rem; color: rgba(248, 248, 248, 0.42); width: fit-content; transition: color 0.25s ease; }
.sd-back:hover { color: rgba(248, 248, 248, 0.85); }
.sd-tag { font-size: 10.5px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent); }
.sd-title {
  font-family: var(--font-poster); font-weight: 400; text-transform: uppercase;
  letter-spacing: 0.012em; line-height: 0.96; font-size: clamp(2.4rem, 7.4vw, 6.4rem);
}
.sd-headline {
  margin-top: 6px; max-width: 56ch; font-size: clamp(1.05rem, 2vw, 1.5rem);
  line-height: 1.45; letter-spacing: -0.01em; color: rgba(248, 248, 248, 0.62);
}

/* ── Cuerpo ───────────────────────────────────────────────────── */
.sd-body { background: var(--color-ink); border-top: 1px solid var(--color-line); }
.sd-body__grid {
  display: grid; grid-template-columns: 1fr; gap: 56px;
  padding: clamp(64px, 8vw, 104px) 24px clamp(72px, 9vw, 112px);
}
@media (min-width: 768px) {
  .sd-body__grid { grid-template-columns: 1fr 1fr; gap: 80px; padding-inline: 48px; }
}
.sd-lead { font-size: clamp(1.06rem, 1.8vw, 1.24rem); line-height: 1.68; color: var(--color-gray); max-width: 52ch; }
.sd-cta {
  display: inline-flex; align-items: center; gap: 9px; margin-top: 32px;
  background: #0d0d0d; color: #f8f8f8; font-size: 0.94rem; font-weight: 600;
  padding: 14px 30px; border-radius: 100px; transition: background 0.3s, gap 0.3s;
}
.sd-cta:hover { background: var(--color-accent); gap: 15px; }

.sd-found {
  margin-top: 40px; padding: clamp(20px, 2.4vw, 28px);
  border: 1px solid var(--color-line); border-left: 2px solid var(--color-accent);
  background: rgba(255, 255, 255, 0.5);
}
.sd-found__label { font-size: clamp(0.96rem, 1.3vw, 1.06rem); font-weight: 600; letter-spacing: -0.01em; color: var(--color-paper); margin-bottom: 15px; max-width: 44ch; }
.sd-found__items { display: flex; flex-wrap: wrap; gap: 8px 9px; }
.sd-found__item { font-size: 11.5px; color: var(--color-gray); border: 1px solid var(--color-line); border-radius: 99px; padding: 5px 12px; background: #fff; }

.sd-flow { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-top: 32px; }
.sd-flow__step { font-size: 10.5px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: var(--color-paper); border-bottom: 1px solid var(--color-accent); padding-bottom: 3px; }
.sd-flow__sep { color: var(--color-accent); font-size: 0.82rem; opacity: 0.65; }

.sd-disco { display: flex; flex-wrap: wrap; align-items: baseline; gap: 9px; margin-top: 32px; font-size: 0.92rem; line-height: 1.6; color: var(--color-gray); }
.sd-disco__tag { font-size: 9px; font-weight: 700; letter-spacing: 0.17em; text-transform: uppercase; color: var(--color-accent); border: 1px solid rgba(240, 94, 35, 0.32); border-radius: 99px; padding: 4px 9px; }

.sd-caps-label { font-size: 10px; font-weight: 700; letter-spacing: 0.17em; text-transform: uppercase; color: var(--color-gray); margin-bottom: 26px; }
.sd-caps { list-style: none; border-top: 1px solid var(--color-line); }
.sd-caps__item { display: flex; align-items: baseline; gap: 13px; padding: 17px 0; border-bottom: 1px solid var(--color-line); font-size: clamp(0.96rem, 1.4vw, 1.06rem); line-height: 1.5; color: var(--color-paper); }
.sd-caps__dot { color: var(--color-accent); font-size: 0.78rem; flex-shrink: 0; }

/* ── Casos ────────────────────────────────────────────────────── */
.sd-cases { background: #f0ede8; border-top: 1px solid var(--color-line); padding-block: clamp(72px, 9vw, 120px); }
.sd-cases__head { margin-bottom: clamp(40px, 5vw, 64px); }
.sd-case { border-top: 1px solid var(--color-line); padding-block: clamp(32px, 4vw, 50px); }
.sd-case:last-child { border-bottom: 1px solid var(--color-line); }
.sd-case__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; margin-bottom: clamp(20px, 2.6vw, 30px); }
.sd-case__client { font-family: var(--font-display); font-size: clamp(1.35rem, 2.6vw, 1.9rem); font-weight: 600; letter-spacing: -0.028em; color: var(--color-paper); }
.sd-case__sector { font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent); }
.sd-case__body { display: grid; grid-template-columns: 1fr; gap: 22px; }
@media (min-width: 850px) { .sd-case__body { grid-template-columns: repeat(3, 1fr); gap: 36px; } }
.sd-case__label { font-size: 9.5px; font-weight: 700; letter-spacing: 0.17em; text-transform: uppercase; color: var(--color-gray); margin-bottom: 10px; padding-bottom: 9px; border-bottom: 1px solid var(--color-line); }
.sd-case__text { font-size: clamp(0.9rem, 1.2vw, 0.97rem); line-height: 1.62; color: var(--color-paper); }
.sd-case__metrics { display: flex; flex-wrap: wrap; gap: 12px 38px; margin-top: clamp(22px, 2.6vw, 30px); }
.sd-metric { display: flex; flex-direction: column; gap: 4px; }
.sd-metric__val { font-family: var(--font-poster); font-size: clamp(1.5rem, 2.8vw, 2.2rem); line-height: 1; color: var(--color-accent); }
.sd-metric__lbl { font-size: 10px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: var(--color-gray); }
.sd-case__go { display: inline-flex; align-items: center; gap: 8px; margin-top: clamp(18px, 2.2vw, 26px); font-size: 0.88rem; font-weight: 600; color: var(--color-paper); border-bottom: 1px solid var(--color-line); padding-bottom: 3px; transition: color 0.3s, border-color 0.3s, gap 0.3s; }
.sd-case__go:hover { color: var(--color-accent); border-color: var(--color-accent); gap: 14px; }
.sd-cases__all { display: inline-flex; align-items: center; gap: 9px; margin-top: clamp(30px, 3.6vw, 44px); font-size: 0.92rem; font-weight: 600; color: var(--color-paper); transition: color 0.3s, gap 0.3s; }
.sd-cases__all:hover { color: var(--color-accent); gap: 15px; }

/* ── CTA final ────────────────────────────────────────────────── */
.sd-final { background: #f8f8f8; border-top: 1px solid var(--color-line); }
.sd-final__inner { padding: clamp(72px, 9vw, 108px) 24px clamp(84px, 10vw, 120px); display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
@media (min-width: 768px) { .sd-final__inner { padding-inline: 48px; } }
.sd-final__title { font-family: var(--font-display); font-size: clamp(2.3rem, 5.6vw, 4.6rem); font-weight: 600; letter-spacing: -0.035em; line-height: 0.98; color: var(--color-paper); }
.sd-final__sub { font-size: 1.02rem; color: var(--color-gray); max-width: 42ch; }
.sd-final__btn { display: inline-flex; align-items: center; gap: 9px; background: #0d0d0d; color: #f8f8f8; font-size: 0.98rem; font-weight: 600; padding: 15px 34px; border-radius: 100px; margin-top: 10px; transition: background 0.3s, gap 0.3s; }
.sd-final__btn:hover { background: var(--color-accent); gap: 17px; }
</style>
