---
import Base from '../../layouts/Base.astro';
import { PROJECTS } from '../../data/projects';
import type { Service } from '../../data/services';
import { localePath, type Locale } from '../../i18n';

interface Props { locale: Locale; service: Service; }
const { locale, service } = Astro.props;
const lp = (p: string) => localePath(locale, p);

const isEs = locale === 'es';
const projects = PROJECTS.filter((p) => p.serviceSlugs.includes(service.slug));
const count = projects.length;
const serviceName = isEs ? service.title.es : service.title.en;
const serviceBack = isEs ? `← ${serviceName}` : `← ${serviceName}`;
---

<Base
  locale={locale}
  title={`${serviceName} — Portafolio · BrandUp`}
  description={isEs
    ? `Casos de éxito de BrandUp en ${serviceName}. Proyectos reales con resultados medibles.`
    : `BrandUp success cases in ${serviceName}. Real projects with measurable results.`}
>

  <!-- Hero -->
  <section class="svc-folio-hero">
    <div class="svc-folio-hero__inner">
      <a href={lp(`/servicios/${service.slug}`)} class="svc-folio-hero__back">{serviceBack}</a>
      <div class="svc-folio-hero__meta">
        <span class="svc-folio-hero__tag">
          {isEs ? 'Portafolio' : 'Portfolio'}
        </span>
        <span class="svc-folio-hero__count">
          {count} {isEs ? (count === 1 ? 'caso' : 'casos') : (count === 1 ? 'case' : 'cases')}
        </span>
      </div>
      <h1 class="svc-folio-hero__title display-tight">
        {isEs ? 'Trabajo en' : 'Work in'}
        <br/>
        <span class="svc-folio-hero__title-accent">{serviceName}</span>
      </h1>
    </div>
  </section>

  <!-- Grid -->
  <section class="svc-folio-section">
    <div class="svc-folio-section__inner">

      {count === 0 ? (
        <!-- Estado vacío -->
        <div class="svc-folio-empty">
          <span class="svc-folio-empty__icon" aria-hidden="true">◎</span>
          <p class="svc-folio-empty__title">
            {isEs ? 'Próximamente' : 'Coming soon'}
          </p>
          <p class="svc-folio-empty__sub">
            {isEs
              ? 'Estamos preparando los casos de este servicio. Mientras tanto, puedes ver todos nuestros proyectos.'
              : 'We are preparing the cases for this service. In the meantime, see all our projects.'}
          </p>
          <a href={lp('/trabajos')} class="svc-folio-empty__link">
            {isEs ? 'Ver todos los proyectos →' : 'See all projects →'}
          </a>
        </div>
      ) : (
        <div class="svc-folio-grid" data-count={count}>
          {projects.map((p) => (
            <a
              href={lp(`/trabajos/${p.slug}`)}
              class="svc-folio-card"
              aria-label={`${p.client} — ${isEs ? 'Abrir proyecto' : 'Open project'}`}
            >
              <!-- Imagen / gradiente -->
              <div class="svc-folio-card__img" style={`background: ${p.gradient}`}>

                <!-- Foto de portada (si existe) -->
                {p.cover && (
                  <img
                    src={p.cover.src}
                    alt={p.client}
                    class="svc-folio-card__cover"
                    width={p.cover.width}
                    height={p.cover.height}
                    loading="lazy"
                  />
                )}

                <!-- Logo centrado (solo si no hay cover) -->
                {!p.cover && p.logo && (
                  <div class="svc-folio-card__logo-wrap">
                    <img
                      src={p.logo.src}
                      alt={p.client}
                      class="svc-folio-card__logo"
                      width="120"
                      height="60"
                      loading="lazy"
                    />
                  </div>
                )}

                <!-- Overlay oscuro -->
                <div class="svc-folio-card__overlay"></div>

                <!-- Badge nueva pestaña -->
                <span class="svc-folio-card__badge" aria-hidden="true">
                  {isEs ? 'Ver proyecto' : 'Open'} ↗
                </span>
              </div>

              <!-- Info debajo -->
              <div class="svc-folio-card__info">
                <span class="svc-folio-card__sector">{isEs ? p.sector.es : p.sector.en}</span>
                <span class="svc-folio-card__client">{p.client}</span>
                <div class="svc-folio-card__pills">
                  {(isEs ? p.services.es : p.services.en).slice(0, 3).map((svc) => (
                    <span class="svc-folio-card__pill">{svc}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      )}

    </div>
  </section>

  <!-- CTA -->
  <section class="svc-folio-cta">
    <div class="svc-folio-cta__inner">
      <p class="svc-folio-cta__kicker">
        {isEs ? '¿Quieres resultados como estos?' : 'Want results like these?'}
      </p>
      <h2 class="svc-folio-cta__title display-tight">
        {isEs ? 'Hablemos de tu proyecto' : "Let's talk about your project"}
      </h2>
      <a href={lp('/cotizar')} class="svc-folio-cta__btn">
        {isEs ? 'Cotizar ahora →' : 'Get a quote →'}
      </a>
    </div>
  </section>

</Base>

<style>
/* ── Hero ─────────────────────────────────────────────────────── */
.svc-folio-hero {
  background: #080808;
  color: #f8f8f8;
  padding-top: 110px;
  padding-bottom: 72px;
  border-bottom: 1px solid rgba(248,248,248,0.06);
}
.svc-folio-hero__inner {
  max-width: 1200px;
  margin-inline: auto;
  padding-inline: 24px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}
@media (min-width: 768px) { .svc-folio-hero__inner { padding-inline: 48px; } }
.svc-folio-hero__back {
  font-size: 0.82rem;
  color: rgba(248,248,248,0.35);
  transition: color 0.2s;
  width: fit-content;
}
.svc-folio-hero__back:hover { color: rgba(248,248,248,0.75); }
.svc-folio-hero__meta {
  display: flex;
  align-items: center;
  gap: 16px;
}
.svc-folio-hero__tag {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #f05e23;
}
.svc-folio-hero__count {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(248,248,248,0.25);
}
.svc-folio-hero__title {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 7vw, 6.5rem);
  font-weight: 700;
  line-height: 0.94;
  letter-spacing: -0.04em;
  color: rgba(248,248,248,0.3);
}
.svc-folio-hero__title-accent { color: #f8f8f8; }

/* ── Grid section ─────────────────────────────────────────────── */
.svc-folio-section {
  background: #080808;
  padding: 56px 0 80px;
}
.svc-folio-section__inner {
  max-width: 1200px;
  margin-inline: auto;
  padding-inline: 24px;
}
@media (min-width: 768px) { .svc-folio-section__inner { padding-inline: 48px; } }

/* Bento grid */
.svc-folio-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
@media (max-width: 600px) { .svc-folio-grid { grid-template-columns: 1fr; } }

/* 1 card → full width */
.svc-folio-card:only-child { grid-column: span 2; }
.svc-folio-card:only-child .svc-folio-card__img { aspect-ratio: 21/9; }

/* 3 cards → first spans full row */
.svc-folio-card:first-child:nth-last-child(3) { grid-column: span 2; }
.svc-folio-card:first-child:nth-last-child(3) .svc-folio-card__img { aspect-ratio: 16/7; }

/* default image ratio */
.svc-folio-card__img { aspect-ratio: 4/3; }

/* ── Card ─────────────────────────────────────────────────────── */
.svc-folio-card {
  display: block;
  text-decoration: none;
  color: inherit;
}
.svc-folio-card__img {
  position: relative;
  overflow: hidden;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94);
}
.svc-folio-card:hover .svc-folio-card__img { transform: scale(1.01); }

/* Cover image */
.svc-folio-card__cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 0;
  transition: transform 0.55s cubic-bezier(0.25,0.46,0.45,0.94);
}
.svc-folio-card:hover .svc-folio-card__cover { transform: scale(1.04); }

/* Logo centrado */
.svc-folio-card__logo-wrap {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.svc-folio-card__logo {
  max-width: 40%;
  max-height: 35%;
  object-fit: contain;
  filter: brightness(0) invert(1);
  opacity: 0.85;
  transition: opacity 0.35s, transform 0.35s;
}
.svc-folio-card:hover .svc-folio-card__logo {
  opacity: 1;
  transform: scale(1.04);
}

/* Overlay */
.svc-folio-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.55) 100%);
  transition: opacity 0.4s;
}
.svc-folio-card:hover .svc-folio-card__overlay { opacity: 0.65; }

/* Badge nueva pestaña */
.svc-folio-card__badge {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 2;
  background: rgba(8,8,8,0.7);
  backdrop-filter: blur(8px);
  color: #f8f8f8;
  font-size: 11px;
  font-weight: 600;
  padding: 6px 12px;
  border-radius: 100px;
  border: 1px solid rgba(248,248,248,0.12);
  opacity: 0;
  transform: translateY(-6px);
  transition: opacity 0.3s, transform 0.3s;
}
.svc-folio-card:hover .svc-folio-card__badge {
  opacity: 1;
  transform: translateY(0);
}

/* Info */
.svc-folio-card__info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 14px 2px 0;
}
.svc-folio-card__sector {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #f05e23;
}
.svc-folio-card__client {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2.2vw, 1.55rem);
  font-weight: 700;
  letter-spacing: -0.025em;
  color: #f8f8f8;
  text-transform: uppercase;
}
.svc-folio-card__pills {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 4px;
}
.svc-folio-card__pill {
  font-size: 10px;
  font-weight: 600;
  color: rgba(248,248,248,0.4);
  background: rgba(248,248,248,0.06);
  border: 1px solid rgba(248,248,248,0.08);
  padding: 3px 9px;
  border-radius: 100px;
}

/* ── Empty state ──────────────────────────────────────────────── */
.svc-folio-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 80px 24px;
  gap: 20px;
}
.svc-folio-empty__icon {
  font-size: 3rem;
  color: rgba(248,248,248,0.12);
}
.svc-folio-empty__title {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  color: rgba(248,248,248,0.25);
}
.svc-folio-empty__sub {
  font-size: 1rem;
  color: rgba(248,248,248,0.35);
  max-width: 44ch;
  line-height: 1.6;
}
.svc-folio-empty__link {
  font-size: 0.9rem;
  font-weight: 600;
  color: #f05e23;
  transition: opacity 0.2s;
}
.svc-folio-empty__link:hover { opacity: 0.7; }

/* ── CTA ──────────────────────────────────────────────────────── */
.svc-folio-cta {
  background: #f0ede8;
  border-top: 1px solid rgba(0,0,0,0.08);
}
.svc-folio-cta__inner {
  max-width: 1200px;
  margin-inline: auto;
  padding: 80px 24px 96px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  align-items: flex-start;
}
@media (min-width: 768px) { .svc-folio-cta__inner { padding: 96px 48px 112px; } }
.svc-folio-cta__kicker {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(13,13,13,0.4);
}
.svc-folio-cta__title {
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 6vw, 5rem);
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 0.95;
  color: #0d0d0d;
  max-width: 16ch;
}
.svc-folio-cta__btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: #0d0d0d;
  color: #f8f8f8;
  font-size: 0.95rem;
  font-weight: 600;
  padding: 15px 34px;
  border-radius: 100px;
  margin-top: 8px;
  transition: background 0.3s, gap 0.3s;
}
.svc-folio-cta__btn:hover { background: #f05e23; gap: 18px; }
</style>
