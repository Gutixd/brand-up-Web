---
// ParticleSphere — Three.js vanilla, sin React, compatible con Astro 6
---
<canvas id="sphere-canvas" class="sphere-canvas" aria-hidden="true"></canvas>

<script>
import * as THREE from 'three';

let renderer: THREE.WebGLRenderer | null = null;
let animId = 0;

function initSphere() {
  const canvas = document.getElementById('sphere-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;

  // Limpiar instancia anterior si existe (Astro view transitions)
  if (renderer) { renderer.dispose(); cancelAnimationFrame(animId); }

  const W = canvas.clientWidth  || canvas.offsetWidth  || 600;
  const H = canvas.clientHeight || canvas.offsetHeight || 600;

  renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(W, H);

  const scene  = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(55, W / H, 0.1, 1000);
  camera.position.z = 220;

  // ── Partículas en superficie de esfera ──────────────────────────
  const N = 3200;
  const positions = new Float32Array(N * 3);
  const colors    = new Float32Array(N * 3);
  const sizes     = new Float32Array(N);
  const baseColor = new THREE.Color('#f05e23');
  const dimColor  = new THREE.Color('#7a2e10');

  for (let i = 0; i < N; i++) {
    // Distribución uniforme sobre esfera (método de Fibonnaci)
    const phi   = Math.acos(1 - 2 * (i + 0.5) / N);
    const theta = Math.PI * (1 + Math.sqrt(5)) * i;
    const R = 90 + (Math.random() - 0.5) * 8;

    positions[i * 3]     = R * Math.sin(phi) * Math.cos(theta);
    positions[i * 3 + 1] = R * Math.sin(phi) * Math.sin(theta);
    positions[i * 3 + 2] = R * Math.cos(phi);

    // Color varía con altura: más brillante arriba
    const t = (positions[i * 3 + 1] / R + 1) / 2;
    const c = dimColor.clone().lerp(baseColor, t * t);
    colors[i * 3]     = c.r;
    colors[i * 3 + 1] = c.g;
    colors[i * 3 + 2] = c.b;

    sizes[i] = 1.2 + Math.random() * 2.2;
  }

  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geo.setAttribute('color',    new THREE.BufferAttribute(colors, 3));
  geo.setAttribute('size',     new THREE.BufferAttribute(sizes, 1));

  // Shader personalizado para partículas circulares suaves
  const mat = new THREE.ShaderMaterial({
    vertexColors: true,
    transparent: true,
    depthWrite: false,
    blending: THREE.AdditiveBlending,
    uniforms: { uTime: { value: 0 }, uMouse: { value: new THREE.Vector2(0, 0) } },
    vertexShader: `
      attribute float size;
      varying vec3 vColor;
      varying float vAlpha;
      uniform vec2 uMouse;
      uniform float uTime;
      void main() {
        vColor = color;
        vec4 mvPos = modelViewMatrix * vec4(position, 1.0);
        // Partículas más cerca de la cámara son más brillantes
        float dist = length(mvPos.xyz);
        vAlpha = smoothstep(300.0, 80.0, dist);
        gl_PointSize = size * (280.0 / -mvPos.z);
        gl_Position = projectionMatrix * mvPos;
      }
    `,
    fragmentShader: `
      varying vec3 vColor;
      varying float vAlpha;
      void main() {
        vec2 uv = gl_PointCoord - 0.5;
        float d = length(uv);
        if (d > 0.5) discard;
        float alpha = smoothstep(0.5, 0.1, d) * vAlpha;
        gl_FragColor = vec4(vColor, alpha);
      }
    `,
  });

  const points = new THREE.Points(geo, mat);
  scene.add(points);

  // ── Anillo exterior sutil ────────────────────────────────────────
  const ringGeo = new THREE.TorusGeometry(105, 0.6, 6, 120);
  const ringMat = new THREE.MeshBasicMaterial({ color: '#f05e23', transparent: true, opacity: 0.18 });
  const ring = new THREE.Mesh(ringGeo, ringMat);
  ring.rotation.x = Math.PI / 2.2;
  scene.add(ring);

  // Segundo anillo más pequeño inclinado
  const ring2Geo = new THREE.TorusGeometry(98, 0.4, 6, 100);
  const ring2Mat = new THREE.MeshBasicMaterial({ color: '#f05e23', transparent: true, opacity: 0.1 });
  const ring2 = new THREE.Mesh(ring2Geo, ring2Mat);
  ring2.rotation.x = Math.PI / 3.5;
  ring2.rotation.y = Math.PI / 5;
  scene.add(ring2);

  // ── Mouse tracking ──────────────────────────────────────────────
  let targetRotX = 0, targetRotY = 0;
  let currentRotX = 0, currentRotY = 0;
  const rect = canvas.getBoundingClientRect();

  function onMouseMove(e: MouseEvent) {
    const r = canvas!.getBoundingClientRect();
    const nx = (e.clientX - r.left) / r.width  - 0.5;
    const ny = (e.clientY - r.top)  / r.height - 0.5;
    targetRotY =  nx * 1.4;
    targetRotX = -ny * 1.0;
    mat.uniforms.uMouse.value.set(nx, ny);
  }

  function onMouseLeave() {
    targetRotX = 0;
    targetRotY = 0;
  }

  // Activar sobre toda la sección, no solo el canvas
  const section = canvas.closest('.stats-section') || canvas.parentElement;
  section?.addEventListener('mousemove', onMouseMove as EventListener);
  section?.addEventListener('mouseleave', onMouseLeave);

  // ── Resize ──────────────────────────────────────────────────────
  const ro = new ResizeObserver(() => {
    const w = canvas!.clientWidth;
    const h = canvas!.clientHeight;
    renderer!.setSize(w, h);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  });
  ro.observe(canvas);

  // ── Render loop ─────────────────────────────────────────────────
  let t = 0;
  function animate() {
    animId = requestAnimationFrame(animate);
    t += 0.004;

    // Rotación base suave + lerp hacia el mouse
    currentRotX += (targetRotX - currentRotX) * 0.04;
    currentRotY += (targetRotY - currentRotY) * 0.04;

    points.rotation.y = t + currentRotY;
    points.rotation.x = Math.sin(t * 0.3) * 0.12 + currentRotX;

    ring.rotation.z  = t * 0.2;
    ring2.rotation.z = -t * 0.15;

    mat.uniforms.uTime.value = t;
    renderer!.render(scene, camera);
  }
  animate();
}

// Inicializar tras cargar y en cada transición de Astro
document.addEventListener('astro:page-load', initSphere);
</script>
