---
// ParticleSphere — Three.js vanilla con física de repulsión al pasar el mouse
---
<canvas id="sphere-canvas" class="sphere-canvas" aria-hidden="true"></canvas>

<script>
import * as THREE from 'three';

let renderer: THREE.WebGLRenderer | null = null;
let animId = 0;

function initSphere() {
  const canvas = document.getElementById('sphere-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;

  // Limpiar instancia anterior (Astro view transitions)
  if (renderer) { renderer.dispose(); cancelAnimationFrame(animId); }

  const W0 = canvas.clientWidth  || 520;
  const H0 = canvas.clientHeight || 520;

  renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(W0, H0);

  const scene  = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(55, W0 / H0, 0.1, 1000);
  camera.position.z = 220;

  // ── Partículas en superficie de esfera ──────────────────────────
  const N = 2600;
  const base    = new Float32Array(N * 3); // posición de reposo (esfera unidad escalada)
  const offset  = new Float32Array(N * 3); // desplazamiento actual por física
  const vel     = new Float32Array(N * 3); // velocidad del desplazamiento
  const display = new Float32Array(N * 3); // posición final que se dibuja
  const colors  = new Float32Array(N * 3);
  const sizes   = new Float32Array(N);

  const baseColor = new THREE.Color('#f05e23');
  const dimColor  = new THREE.Color('#7a2e10');

  for (let i = 0; i < N; i++) {
    const phi   = Math.acos(1 - 2 * (i + 0.5) / N);
    const theta = Math.PI * (1 + Math.sqrt(5)) * i;
    const R = 90 + (Math.random() - 0.5) * 6;

    const x = R * Math.sin(phi) * Math.cos(theta);
    const y = R * Math.sin(phi) * Math.sin(theta);
    const z = R * Math.cos(phi);
    base[i * 3] = x; base[i * 3 + 1] = y; base[i * 3 + 2] = z;

    const tt = (y / R + 1) / 2;
    const c = dimColor.clone().lerp(baseColor, tt * tt);
    colors[i * 3] = c.r; colors[i * 3 + 1] = c.g; colors[i * 3 + 2] = c.b;

    sizes[i] = 1.3 + Math.random() * 2.2;
  }

  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(display, 3));
  geo.setAttribute('color',    new THREE.BufferAttribute(colors, 3));
  geo.setAttribute('size',     new THREE.BufferAttribute(sizes, 1));

  const mat = new THREE.ShaderMaterial({
    vertexColors: true,
    transparent: true,
    depthWrite: false,
    blending: THREE.AdditiveBlending,
    vertexShader: `
      attribute float size;
      varying vec3 vColor;
      varying float vAlpha;
      void main() {
        vColor = color;
        vec4 mvPos = modelViewMatrix * vec4(position, 1.0);
        float dist = length(mvPos.xyz);
        vAlpha = smoothstep(300.0, 80.0, dist);
        gl_PointSize = size * (280.0 / -mvPos.z);
        gl_Position = projectionMatrix * mvPos;
      }
    `,
    fragmentShader: `
      varying vec3 vColor;
      varying float vAlpha;
      void main() {
        vec2 uv = gl_PointCoord - 0.5;
        float d = length(uv);
        if (d > 0.5) discard;
        float a = smoothstep(0.5, 0.1, d) * vAlpha;
        gl_FragColor = vec4(vColor, a);
      }
    `,
  });

  const points = new THREE.Points(geo, mat);
  scene.add(points);

  // Anillos decorativos
  const ring = new THREE.Mesh(
    new THREE.TorusGeometry(105, 0.6, 6, 120),
    new THREE.MeshBasicMaterial({ color: '#f05e23', transparent: true, opacity: 0.16 })
  );
  ring.rotation.x = Math.PI / 2.2;
  scene.add(ring);

  const ring2 = new THREE.Mesh(
    new THREE.TorusGeometry(98, 0.4, 6, 100),
    new THREE.MeshBasicMaterial({ color: '#f05e23', transparent: true, opacity: 0.09 })
  );
  ring2.rotation.x = Math.PI / 3.5;
  ring2.rotation.y = Math.PI / 5;
  scene.add(ring2);

  // ── Estado del mouse ────────────────────────────────────────────
  let hovering = false;
  let mouseX = -9999, mouseY = -9999; // en px relativos al canvas

  const section = (canvas.closest('.stats-section') as HTMLElement) || canvas.parentElement!;

  function onMove(e: MouseEvent) {
    const r = canvas!.getBoundingClientRect();
    mouseX = e.clientX - r.left;
    mouseY = e.clientY - r.top;
  }
  section.addEventListener('mousemove', onMove);
  section.addEventListener('mouseenter', () => { hovering = true; });
  section.addEventListener('mouseleave', () => { hovering = false; mouseX = -9999; mouseY = -9999; });

  // ── Resize ──────────────────────────────────────────────────────
  let CW = W0, CH = H0;
  const ro = new ResizeObserver(() => {
    CW = canvas!.clientWidth; CH = canvas!.clientHeight;
    renderer!.setSize(CW, CH);
    camera.aspect = CW / CH;
    camera.updateProjectionMatrix();
  });
  ro.observe(canvas);

  // ── Render loop con física ──────────────────────────────────────
  const quat = new THREE.Quaternion();
  const axisY = new THREE.Vector3(0, 1, 0);
  const v = new THREE.Vector3();
  const REPEL_RADIUS = 75;   // px
  const REPEL_FORCE  = 26;   // intensidad
  let t = 0;

  function animate() {
    animId = requestAnimationFrame(animate);
    t += 0.0035;

    // Rotación lenta automática (siempre activa)
    const angle = t;
    quat.setFromAxisAngle(axisY, angle);
    const wobble = Math.sin(t * 0.3) * 0.1;

    const posAttr = geo.getAttribute('position') as THREE.BufferAttribute;

    const cosW = Math.cos(wobble), sinW = Math.sin(wobble);
    const arr = posAttr.array as Float32Array;

    for (let i = 0; i < N; i++) {
      const ix = i * 3, iy = ix + 1, iz = ix + 2;

      // 1. Posición base rotada (esfera girando suave) → escalares rbx/rby/rbz
      v.set(base[ix], base[iy], base[iz]).applyQuaternion(quat);
      const rbx = v.x;
      const rby = v.y * cosW - v.z * sinW;
      const rbz = v.y * sinW + v.z * cosW;

      // 2. Física de repulsión SOLO al pasar el mouse encima
      if (hovering) {
        v.set(rbx + offset[ix], rby + offset[iy], rbz + offset[iz]).project(camera);
        const sx = (v.x * 0.5 + 0.5) * CW;
        const sy = (-v.y * 0.5 + 0.5) * CH;
        const dx = sx - mouseX;
        const dy = sy - mouseY;
        const d2 = dx * dx + dy * dy;
        if (d2 < REPEL_RADIUS * REPEL_RADIUS && d2 > 0.01) {
          const d = Math.sqrt(d2);
          const f = (1 - d / REPEL_RADIUS) * REPEL_FORCE;
          vel[ix] +=  (dx / d) * f * 0.08;
          vel[iy] += -(dy / d) * f * 0.08;
        }
      }

      // 3. Integrar velocidad + resorte de vuelta a reposo
      vel[ix] *= 0.86; vel[iy] *= 0.86; vel[iz] *= 0.86;
      offset[ix] = (offset[ix] + vel[ix]) * 0.90;
      offset[iy] = (offset[iy] + vel[iy]) * 0.90;
      offset[iz] = (offset[iz] + vel[iz]) * 0.90;

      // 4. Posición final = base rotada + offset físico
      arr[ix] = rbx + offset[ix];
      arr[iy] = rby + offset[iy];
      arr[iz] = rbz + offset[iz];
    }
    posAttr.needsUpdate = true;

    ring.rotation.z  = t * 0.2;
    ring2.rotation.z = -t * 0.15;

    renderer!.render(scene, camera);
  }
  animate();
}

document.addEventListener('astro:page-load', initSphere);
</script>
