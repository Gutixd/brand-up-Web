---
import { wa } from '../data/site';
import { useT, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const waMsg = locale === 'es' ? 'Hola BrandUp, quiero cotizar un proyecto' : 'Hi BrandUp, I want a project quote';
---

<section class="cta-final">
  <div class="cta-final__inner">
    <div class="cta-final__left">
      <p class="cta-final__kicker" data-reveal>BrandUp · Santiago, Chile</p>
      <h2 class="cta-final__title display-tight" data-split-chars>{t.home.ctaTitle}</h2>
      <p class="cta-final__desc" data-reveal>{t.home.ctaText}</p>
    </div>
    <div class="cta-final__actions" data-reveal data-delay="0.2">
      <a href={localePath(locale, '/cotizar')} data-magnetic="0.35" class="cta-final__btn">{t.home.ctaButton} →</a>
      <a href={wa(waMsg)} target="_blank" rel="noopener" class="cta-final__link">{t.home.ctaWhatsApp}</a>
    </div>
  </div>
</section>

<style>
.cta-final__desc {
  font-size: clamp(0.9rem, 1.4vw, 1rem);
  color: rgba(248,248,248,0.35);
  max-width: 44ch;
  line-height: 1.65;
}
</style>
