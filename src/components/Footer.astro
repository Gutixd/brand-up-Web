---
import Logo from './Logo';
import { SITE, wa } from '../data/site';
import { useT, localePath, altPath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const lp = (p: string) => localePath(locale, p);
const year = new Date().getFullYear();

const nav = [
  { label: t.nav.home, href: '/' },
  { label: t.nav.services, href: '/servicios' },
  { label: t.nav.work, href: '/trabajos' },
  { label: t.nav.industries, href: '/industrias' },
  { label: t.nav.about, href: '/nosotros' },
  { label: t.nav.contact, href: '/contacto' },
];
---

<footer class="border-t border-line bg-ink">
  <div class="mx-auto max-w-7xl px-5 py-10 md:px-8 md:py-16">

    <!-- Logo + tagline + CTA — fila completa arriba -->
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between md:mb-12">
      <div>
        <a href={lp('/')} aria-label="BrandUp"><Logo /></a>
        <p class="mt-2 text-sm text-gray">{t.footer.tagline}</p>
      </div>
      <a
        href={lp('/cotizar')}
        class="self-start rounded-full border border-accent px-5 py-2.5 text-sm font-semibold text-accent transition-colors hover:bg-accent hover:text-ink sm:self-auto"
      >
        {t.nav.quote}
      </a>
    </div>

    <!-- Nav + Contacto en 2 columnas en móvil, 3 en desktop -->
    <div class="grid grid-cols-2 gap-8 md:grid-cols-3">

      <div>
        <h3 class="font-display text-xs font-bold uppercase tracking-widest text-paper">{t.footer.nav}</h3>
        <ul class="mt-3 space-y-1.5">
          {nav.map((item) => (
            <li><a href={lp(item.href)} class="text-sm text-gray transition-colors hover:text-accent">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-xs font-bold uppercase tracking-widest text-paper">{t.footer.contact}</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-gray">
          <li>{SITE.city}</li>
          <li><a href={wa('Hola BrandUp, quiero información')} class="transition-colors hover:text-accent" target="_blank" rel="noopener">{SITE.phone}</a></li>
          <li><a href={`mailto:${SITE.email}`} class="transition-colors hover:text-accent">{SITE.email}</a></li>
        </ul>
        <h3 class="mt-5 font-display text-xs font-bold uppercase tracking-widest text-paper">{t.footer.social}</h3>
        <ul class="mt-3 flex gap-4 text-sm text-gray">
          <li><a href={SITE.instagram} target="_blank" rel="noopener" class="transition-colors hover:text-accent">Instagram</a></li>
          <li><a href={SITE.tiktok} target="_blank" rel="noopener" class="transition-colors hover:text-accent">TikTok</a></li>
        </ul>
      </div>

      <!-- Idioma solo visible en md+ o en su propia celda si hay espacio -->
      <div class="col-span-2 md:col-span-1">
        <h3 class="font-display text-xs font-bold uppercase tracking-widest text-paper">{t.footer.language}</h3>
        <p class="mt-3 text-sm">
          <a href={altPath(locale, Astro.url.pathname)} class="text-gray transition-colors hover:text-accent">{t.lang.switch}</a>
        </p>
      </div>

    </div>
  </div>

  <div class="border-t border-line">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-5 py-4 text-xs text-gray md:flex-row md:px-8">
      <span>© {year} {SITE.legalName} — {t.footer.rights}</span>
      <span class="flex gap-5">
        <a href={lp('/terminos')} class="transition-colors hover:text-accent">{t.legal.terms}</a>
        <a href={lp('/privacidad')} class="transition-colors hover:text-accent">{t.legal.privacy}</a>
      </span>
    </div>
  </div>
</footer>
