---
// Plantilla genérica para proyectos SIN diseño propio (ver bespokeWork.ts).
import WorkDetailPage from '../../../components/pages/WorkDetailPage.astro';
import { PROJECTS } from '../../../data/projects';
import { isBespokeWork } from '../../../data/bespokeWork';

export function getStaticPaths() {
  return PROJECTS
    .filter((p) => !isBespokeWork(p.slug))
    .map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
---

<WorkDetailPage locale="en" project={project} />
