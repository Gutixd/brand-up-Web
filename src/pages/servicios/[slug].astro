---
import Base from '../../layouts/Base.astro';
import { SERVICES } from '../../data/services';
import { localePath } from '../../i18n';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const locale = 'es' as const;
const lp = (p: string) => localePath(locale, p);
---

<Base locale={locale} title={`${service.title.es} — BrandUp`} description={service.desc.es}>

  <!-- Hero -->
  <section class="svc-page-hero">
    <div class="svc-page-hero__inner">
      <a href={lp('/servicios')} class="svc-page-hero__back">← Servicios</a>
      <span class="svc-page-hero__tag">{service.tag.es}</span>
      <h1 class="svc-page-hero__title display-tight">{service.title.es}</h1>
      <p class="svc-page-hero__headline">{service.headline.es}</p>
    </div>
  </section>

  <!-- Cuerpo -->
  <section class="svc-page-body">
    <div class="svc-page-body__inner">

      <div class="svc-page-body__desc-col">
        <p class="svc-page-body__desc">{service.desc.es}</p>
        <a href={lp('/cotizar')} class="svc-page-body__cta">
          Cotizar {service.title.es} →
        </a>
      </div>

      <div class="svc-page-body__items-col">
        <p class="svc-page-body__items-label">Lo que incluye</p>
        <ul class="svc-page-body__items">
          {service.items.es.map((item) => (
            <li class="svc-page-body__item">
              <span class="svc-page-body__item-dot" aria-hidden="true">→</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </section>

  <!-- CTA cierre -->
  <section class="svc-page-cta">
    <div class="svc-page-cta__inner">
      <h2 class="svc-page-cta__title display-tight">¿Te interesa?</h2>
      <p class="svc-page-cta__sub">Cuéntanos tu proyecto y te respondemos con una propuesta concreta.</p>
      <a href={lp('/cotizar')} class="svc-page-cta__btn">Empezar ahora →</a>
    </div>
  </section>

</Base>

<style>
/* ── Hero ─────────────────────────────────────────────────────────── */
.svc-page-hero {
  background: #0d0d0d;
  color: #f8f8f8;
  padding-top: 120px;
  padding-bottom: 80px;
}
.svc-page-hero__inner {
  max-width: 1100px;
  margin-inline: auto;
  padding-inline: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}
@media (min-width: 768px) { .svc-page-hero__inner { padding-inline: 48px; } }
.svc-page-hero__back {
  font-size: 0.85rem;
  color: rgba(248,248,248,0.4);
  transition: color 0.2s;
  width: fit-content;
}
.svc-page-hero__back:hover { color: rgba(248,248,248,0.8); }
.svc-page-hero__tag {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #f05e23;
}
.svc-page-hero__title {
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 7vw, 6rem);
  line-height: 0.94;
  color: #f8f8f8;
}
.svc-page-hero__headline {
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  line-height: 1.5;
  color: rgba(248,248,248,0.55);
  max-width: 58ch;
  margin-top: 8px;
}

/* ── Body ─────────────────────────────────────────────────────────── */
.svc-page-body {
  background: var(--color-ink);
  border-top: 1px solid var(--color-line);
}
.svc-page-body__inner {
  max-width: 1100px;
  margin-inline: auto;
  padding: 72px 24px 88px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 56px;
}
@media (min-width: 768px) {
  .svc-page-body__inner {
    grid-template-columns: 1fr 1fr;
    padding: 96px 48px 112px;
    gap: 80px;
  }
}
.svc-page-body__desc {
  font-size: clamp(1.05rem, 1.8vw, 1.2rem);
  line-height: 1.7;
  color: var(--color-gray);
}
.svc-page-body__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 36px;
  background: #0d0d0d;
  color: #f8f8f8;
  font-size: 0.95rem;
  font-weight: 600;
  padding: 14px 32px;
  border-radius: 100px;
  transition: background 0.3s, gap 0.3s;
}
.svc-page-body__cta:hover { background: #f05e23; gap: 14px; }
.svc-page-body__items-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-gray);
  margin-bottom: 28px;
}
.svc-page-body__items {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.svc-page-body__item {
  display: flex;
  align-items: baseline;
  gap: 14px;
  padding: 18px 0;
  border-bottom: 1px solid var(--color-line);
  font-size: clamp(0.95rem, 1.5vw, 1.05rem);
  line-height: 1.5;
  color: var(--color-paper);
}
.svc-page-body__item:first-child { border-top: 1px solid var(--color-line); }
.svc-page-body__item-dot {
  color: #f05e23;
  font-size: 0.8rem;
  flex-shrink: 0;
}

/* ── CTA cierre ───────────────────────────────────────────────────── */
.svc-page-cta {
  background: #f0ede8;
  border-top: 1px solid var(--color-line);
}
.svc-page-cta__inner {
  max-width: 1100px;
  margin-inline: auto;
  padding: 80px 24px 96px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  align-items: flex-start;
}
@media (min-width: 768px) { .svc-page-cta__inner { padding: 96px 48px 112px; } }
.svc-page-cta__title {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 6vw, 5rem);
  line-height: 0.95;
  color: var(--color-paper);
}
.svc-page-cta__sub {
  font-size: 1.05rem;
  color: var(--color-gray);
  max-width: 44ch;
}
.svc-page-cta__btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: #0d0d0d;
  color: #f8f8f8;
  font-size: 1rem;
  font-weight: 600;
  padding: 16px 36px;
  border-radius: 100px;
  margin-top: 12px;
  transition: background 0.3s, gap 0.3s;
}
.svc-page-cta__btn:hover { background: #f05e23; gap: 18px; }
</style>
