---
import Base from '../layouts/Base.astro';
import { useT } from '../i18n';

const t = useT('es');
---

<Base locale="es" title={`404 — ${t.notFound.title}`} description={t.notFound.text}>
  <section class="flex min-h-[80svh] flex-col items-center justify-center px-5 text-center">
    <p class="font-display text-8xl font-extrabold text-accent">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold">{t.notFound.title}</h1>
    <p class="mt-3 text-gray">{t.notFound.text}</p>
    <a href="/" class="mt-8 rounded-full bg-accent px-8 py-4 font-semibold text-ink transition-transform hover:scale-105">{t.notFound.back}</a>
  </section>
</Base>
