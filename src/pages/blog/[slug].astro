---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { BLOG_POSTS, type BlogPost } from '../../data/blog';
import { coverFor } from '../../data/blogCovers';
import { SITE, wa, WA_MSG } from '../../data/site';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: BlogPost; }
const { post } = Astro.props;

const fmt = (iso: string) =>
  new Date(iso + 'T12:00:00').toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.desc,
  datePublished: post.date,
  inLanguage: 'es-CL',
  author: { '@type': 'Organization', name: SITE.legalName, url: SITE.domain },
  publisher: { '@type': 'Organization', name: SITE.legalName, logo: { '@type': 'ImageObject', url: `${SITE.domain}/favicon-512.png` } },
  mainEntityOfPage: `${SITE.domain}/blog/${post.slug}`,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.domain}/blog` },
    { '@type': 'ListItem', position: 3, name: post.title },
  ],
};

// FAQPage: es el esquema que Google y los asistentes con IA extraen para
// responder directamente. Solo se emite si el post trae preguntas reales.
const faqLd = post.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: 'es-CL',
      mainEntity: post.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const related = BLOG_POSTS.filter((p) => p.slug !== post.slug).slice(0, 2);
---

{/* Sin el sufijo "| BrandUp": sumaba 11 caracteres a títulos que ya rozaban
    el límite de Google y terminaban cortados. En un artículo lo que importa
    posicionar es el tema, no la marca. */}
<Base locale="es" title={post.title} description={post.desc}>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  <article class="art">
    <header class="art__head">
      <a href="/blog" class="art__back">← Blog</a>
      <div class="art__meta">
        <span class="art__tag">{post.tag}</span>
        <span>{fmt(post.date)} · {post.readMin} min de lectura</span>
      </div>
      <h1 class="art__title" data-reveal>{post.title}</h1>
      <p class="art__intro" data-reveal data-delay="0.1">{post.intro}</p>
      <!-- Portada por categoría: decorativa, por eso alt vacío — el titular
           de arriba ya cuenta de qué trata el artículo. -->
      <figure class="art__cover" data-reveal data-delay="0.16">
        <Image
          src={coverFor(post.tag)}
          alt=""
          widths={[720, 1100]}
          sizes="(max-width: 900px) 92vw, 820px"
          loading="eager"
        />
      </figure>
    </header>

    <div class="art__body">
      {post.answer && (
        <aside class="art__answer" data-reveal>
          <p class="art__answer-label">Respuesta corta</p>
          <p class="art__answer-text">{post.answer}</p>
        </aside>
      )}

      {post.sections.map((s) => (
        <section class="art__section" data-reveal>
          {s.h && <h2>{s.h}</h2>}
          {s.p?.map((par) => <p>{par}</p>)}
          {s.list && (
            <ul>
              {s.list.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </section>
      ))}

      {post.faq && post.faq.length > 0 && (
        <section class="art__faq" data-reveal>
          <h2 class="art__faq-title">Preguntas frecuentes</h2>
          {post.faq.map((f) => (
            <details class="art__faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      <!-- CTA -->
      <aside class="art__cta" data-reveal>
        <p class="art__cta-text">{post.cta}</p>
        <a href={wa(WA_MSG.es.blog)} target="_blank" rel="noopener" class="art__cta-btn">
          Cotizar por WhatsApp →
        </a>
      </aside>

      <!-- Relacionados -->
      <nav class="art__related" aria-label="Artículos relacionados">
        <p class="art__related-label">— Sigue leyendo</p>
        {related.map((r) => (
          <a href={`/blog/${r.slug}`} class="art__related-link">
            {r.title} <span aria-hidden="true">→</span>
          </a>
        ))}
      </nav>
    </div>
  </article>
</Base>

<style>
.art {
  background: var(--color-ink);
  padding: 150px 24px 110px;
}
@media (min-width: 768px) { .art { padding: 180px 48px 130px; } }
.art__head, .art__body { max-width: 760px; margin-inline: auto; }
.art__back {
  display: inline-block;
  font-size: 0.88rem;
  color: var(--color-gray);
  margin-bottom: 28px;
  transition: color 0.2s;
}
.art__back:hover { color: var(--color-accent); }
.art__meta {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 12px;
  color: var(--color-gray);
  margin-bottom: 22px;
}
.art__tag {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #fff;
  background: var(--color-accent);
  padding: 6px 13px;
  border-radius: 99px;
}
.art__title {
  font-family: var(--font-display);
  font-size: clamp(1.9rem, 4.6vw, 3.2rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.08;
  color: var(--color-paper);
}
.art__intro {
  margin-top: 22px;
  font-size: clamp(1.05rem, 1.8vw, 1.25rem);
  line-height: 1.65;
  color: #4a4a46;
}
.art__cover {
  margin-top: clamp(30px, 4vw, 44px);
  border-radius: 18px;
  overflow: hidden;
  aspect-ratio: 3 / 2;
  background: var(--color-ink-2);
}
.art__cover img { width: 100%; height: 100%; display: block; object-fit: cover; }

.art__body { margin-top: clamp(36px, 5vw, 56px); }
.art__section { margin-bottom: 38px; }
.art__section h2 {
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 2.6vw, 1.7rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.2;
  color: var(--color-paper);
  margin-bottom: 16px;
  padding-top: 10px;
  border-top: 2px solid var(--color-accent);
  display: inline-block;
}
.art__section p {
  font-size: 1.02rem;
  line-height: 1.75;
  color: #3d3d3a;
  margin-bottom: 14px;
}
.art__section ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 6px;
}
.art__section li {
  position: relative;
  padding-left: 26px;
  font-size: 1rem;
  line-height: 1.6;
  color: #3d3d3a;
}
.art__section li::before {
  content: '—';
  position: absolute;
  left: 0;
  top: 1px;
  color: var(--color-accent);
  font-size: 0.85em;
}
/* Respuesta corta: lo primero que se lee y lo que citan los buscadores con IA */
.art__answer {
  margin-bottom: 40px;
  padding: 24px 26px;
  border-left: 4px solid var(--color-accent);
  background: rgba(240, 94, 35, 0.06);
  border-radius: 0 14px 14px 0;
}
.art__answer-label {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 10px;
}
.art__answer-text {
  font-size: clamp(1.05rem, 1.9vw, 1.2rem);
  line-height: 1.6;
  font-weight: 500;
  color: var(--color-paper);
}

/* FAQ */
.art__faq { margin: 48px 0 8px; }
.art__faq-title {
  font-family: var(--font-display);
  font-size: clamp(1.4rem, 2.8vw, 1.9rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--color-paper);
  margin-bottom: 20px;
}
.art__faq-item {
  border-bottom: 1px solid var(--color-line);
  padding: 4px 0;
}
.art__faq-item summary {
  cursor: pointer;
  list-style: none;
  padding: 16px 30px 16px 0;
  position: relative;
  font-size: 1.02rem;
  font-weight: 600;
  color: var(--color-paper);
  transition: color 0.25s;
}
.art__faq-item summary::-webkit-details-marker { display: none; }
.art__faq-item summary::after {
  content: '+';
  position: absolute;
  right: 4px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 1.4rem;
  color: var(--color-accent);
  transition: transform 0.3s;
}
.art__faq-item[open] summary::after { transform: translateY(-50%) rotate(45deg); }
.art__faq-item summary:hover { color: var(--color-accent); }
.art__faq-item p {
  padding: 0 4px 18px;
  font-size: 1rem;
  line-height: 1.7;
  color: #3d3d3a;
}

.art__cta {
  margin: 52px 0;
  padding: clamp(28px, 4vw, 40px);
  border-radius: 20px;
  background: #0d0d0d;
  color: #f8f8f8;
  box-shadow: 0 28px 70px rgba(13, 13, 13, 0.25);
}
.art__cta-text {
  font-family: var(--font-display);
  font-size: clamp(1.15rem, 2.2vw, 1.45rem);
  font-weight: 700;
  letter-spacing: -0.015em;
  line-height: 1.35;
  margin-bottom: 22px;
}
.art__cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: var(--color-accent);
  color: #fff;
  font-weight: 600;
  font-size: 0.95rem;
  padding: 14px 30px;
  border-radius: 100px;
  transition: background 0.3s, transform 0.25s;
}
.art__cta-btn:hover { background: #f8f8f8; color: #0d0d0d; transform: translateY(-2px); }
.art__related {
  border-top: 1px solid var(--color-line);
  padding-top: 30px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.art__related-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 4px;
}
.art__related-link {
  font-size: 1.02rem;
  font-weight: 600;
  color: var(--color-paper);
  transition: color 0.25s;
  max-width: 60ch;
}
.art__related-link:hover { color: var(--color-accent); }

/* Celular: las etiquetas del artículo estaban en 10–11px y el "volver"
   quedaba con 21px de alto, incómodo para tocar. */
@media (max-width: 767px) {
  .art__tag,
  .art__answer-label,
  .art__related-label { font-size: 12px; letter-spacing: 0.12em; }
  .art__back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
}
</style>
