---
import '../styles/global.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource/anton';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header';
import Footer from '../components/Footer.astro';
import { SITE, SCHEMA_ID } from '../data/site';
import { useT, altPath, hasAlternate, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const t = useT(locale);
const pathname = Astro.url.pathname;
const alternate = altPath(locale, pathname);
const canonical = new URL(pathname, Astro.site).href;

// Grafo de entidades: Organization (la marca) + WebSite (el sitio) + WebPage
// (esta página concreta), enlazados por `@id`. Los buscadores y los motores
// de respuesta consolidan así todo en una sola entidad "BrandUp" en vez de
// tratar cada página como una empresa distinta.
const organization = {
  '@type': ['Organization', 'LocalBusiness'],
  '@id': SCHEMA_ID.organization,
  name: SITE.legalName,
  alternateName: 'Brand Up',
  description:
    locale === 'es'
      ? 'Agencia de marketing digital y diseño web en Santiago de Chile: e-commerce, branding, contenido para redes, publicidad digital y automatizaciones con IA.'
      : 'Digital marketing and web design agency in Santiago, Chile: e-commerce, branding, social content, digital ads and AI automations.',
  url: SITE.domain,
  email: SITE.email,
  telephone: SITE.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Santiago',
    addressRegion: 'Región Metropolitana',
    addressCountry: 'CL',
  },
  geo: { '@type': 'GeoCoordinates', latitude: -33.4489, longitude: -70.6693 },
  areaServed: ['Santiago de Chile', 'Región Metropolitana', 'Chile'],
  priceRange: '$$',
  knowsAbout: [
    'Diseño web', 'E-commerce', 'Branding', 'Marketing digital',
    'Publicidad digital', 'Contenido para redes sociales', 'SEO',
  ],
  sameAs: [SITE.instagram, SITE.tiktok],
  logo: {
    '@type': 'ImageObject',
    url: `${SITE.domain}/favicon-512.png`,
    width: 512,
    height: 512,
  },
  image: `${SITE.domain}/og-image.png`,
  foundingDate: SITE.founded,
};

const website = {
  '@type': 'WebSite',
  '@id': SCHEMA_ID.website,
  url: SITE.domain,
  name: SITE.legalName,
  publisher: { '@id': SCHEMA_ID.organization },
  inLanguage: locale === 'es' ? 'es-CL' : 'en',
};

// La página actual, colgada del sitio y "acerca de" la marca. `speakable`
// marca qué leer en voz alta a los asistentes (Google Assistant, etc.).
const webPage = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': SCHEMA_ID.website },
  about: { '@id': SCHEMA_ID.organization },
  inLanguage: locale === 'es' ? 'es-CL' : 'en',
  primaryImageOfPage: `${SITE.domain}/og-image.png`,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.page-hero__intro'],
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, webPage],
};

const nav = [
  { label: t.nav.services, href: '/servicios' },
  { label: t.nav.work, href: '/trabajos' },
  { label: t.nav.about, href: '/nosotros' },
  { label: t.nav.product, href: '/tienda' },
  { label: t.nav.contact, href: '/contacto' },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Solo si la traducción existe: el blog es solo en español, y anunciar
        un alternate hacia /en/blog/... mandaba a Google a URLs inexistentes. */}
    {hasAlternate(pathname) && (
      <link rel="alternate" hreflang={locale === 'es' ? 'en' : 'es'} href={new URL(alternate, Astro.site).href} />
    )}
    <!-- Google exige mínimo 48x48 para mostrar el ícono en resultados de
         búsqueda; con solo 32x32 cae al globo genérico. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta name="generator" content={Astro.generator} />
    <!-- SEO local -->
    <meta name="geo.region" content="CL-RM" />
    <meta name="geo.placename" content="Santiago de Chile" />
    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BrandUp Agency" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.domain}/og-image.png`} />
    {/* Sin width/height algunos scrapers (WhatsApp, LinkedIn) descartan la
        imagen y comparten el enlace sin tarjeta. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.legalName} — ${title}`} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CL' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.domain}/og-image.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Vercel Web Analytics -->
    <script defer src="/_vercel/insights/script.js"></script>
    <!-- Google Analytics 4 — propiedad "BrandUp - brandup.cl" -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XLSQ7KWZF8"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(...args: unknown[]) { dataLayer.push(args); }
      // @ts-ignore — gtag() espera argumentos variádicos
      gtag('js', new Date());
      // @ts-ignore
      gtag('config', 'G-XLSQ7KWZF8');
    </script>
    {SITE.metaPixelId && (
      <>
        {/* Meta Pixel — mide conversiones de campañas en Instagram/Facebook.
            Los eventos Contact (clic a WhatsApp) y Lead (formulario) se
            disparan desde motion.ts y ContactForm.tsx via window.fbq. */}
        <script define:vars={{ pixelId: SITE.metaPixelId }}>
          // @ts-nocheck — snippet oficial de Meta, sin tipos.
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = true;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = true;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', pixelId);
          fbq('track', 'PageView');
        </script>
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none"
            src={`https://www.facebook.com/tr?id=${SITE.metaPixelId}&ev=PageView&noscript=1`}
          />
        </noscript>
        <script>
          // Delegado en document: cubre también los enlaces de WhatsApp que
          // ContactForm y otros componentes React agregan tras hidratar.
          document.addEventListener('click', (e) => {
            const target = e.target as HTMLElement | null;
            const link = target?.closest('a[href*="wa.me"]');
            // @ts-ignore — fbq lo define el snippet de Meta arriba.
            if (link && typeof window.fbq === 'function') window.fbq('track', 'Contact');
          });
        </script>
      </>
    )}
    <script>
      // Mark JS availability ASAP so reveal styles only hide content when GSAP will run.
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter />
  </head>
  <body class="bg-ink text-paper antialiased">
    <!-- Premium global layer -->
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <Header client:load locale={locale} nav={nav} quoteLabel={t.nav.quote} altHref={alternate} switchLabel={t.lang.switch} pathname={pathname} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <script src="../scripts/motion.ts"></script>
    {/* Sistema de sonido de interfaz. No reproduce nada hasta que el
        usuario lo activa desde el header (política de autoplay + la
        preferencia queda guardada en localStorage). */}
    <script src="../scripts/sound.ts"></script>
  </body>
</html>
